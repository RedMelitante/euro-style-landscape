---
// Contact. Body: src/components/pages/contact.astro.
import BaseLayout from '../layouts/BaseLayout.astro';
import Contact from '../components/pages/contact.astro';
import { EMAIL } from '../lib/site';
import { business, breadcrumbs } from '../lib/schema';

const site = Astro.site!;
const jsonLd = { '@context': 'https://schema.org', '@graph': [business(site, { email: EMAIL }), breadcrumbs(site, ['Contact', '/contact'])] };
---
<BaseLayout
  title="Contact Us · Free Consultation · Euro Style Landscape"
  description="Call (732) 803-9646 or send the form to book a free on-site design consultation."
  current="contact"
  jsonLd={jsonLd}
>
  <Contact />
</BaseLayout>
