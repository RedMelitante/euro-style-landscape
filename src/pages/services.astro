---
// Services overview: the 7 services as groups with the anchors ad pages link to (#construction ... #commercial).
// Body: src/components/pages/services.astro. JSON-LD: each service in services.json as a Service, plus the FAQ.
import BaseLayout from '../layouts/BaseLayout.astro';
import Services from '../components/pages/services.astro';
import { groups } from '../lib/services';
import { business, breadcrumbs, faqPage } from '../lib/schema';

const site = Astro.site!;
const provider = business(site);
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    ...groups.flatMap((g) =>
      g.items.map((i) => ({
        '@type': 'Service',
        name: i.title,
        description: i.text,
        serviceType: g.id === 'more' ? i.title : g.title,
        provider,
        areaServed: { '@type': 'AdministrativeArea', name: 'Middlesex County, NJ' },
      })),
    ),
    faqPage('services'),
    breadcrumbs(site, ['Services', '/services']),
  ],
};
---
<BaseLayout
  title="Landscaping, Hardscaping & Lawn Care in Sayreville, NJ · Euro Style Landscape"
  description="Pavers, retaining walls, decks, masonry, lawn maintenance, cleanups, snow removal, fencing and planting for homes and commercial properties in Middlesex County, NJ."
  current="services"
  jsonLd={jsonLd}
>
  <Services />
</BaseLayout>
