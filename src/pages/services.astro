---
// Service content comes from src/data/services.json (SERVICES-UPDATE.md).
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CtaBand from '../components/CtaBand.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import { PHONE_DISPLAY, PHONE_HREF } from '../lib/site';
import { commercial, group, groups, jumpLinks } from '../lib/services';
import { NEW_CLIENT_OFFER_ON, NEW_CLIENT_OFFER_TERMS } from '../lib/campaigns';
import { photoBg } from '../lib/images';

const construction = group('construction');
const lawn = group('lawn-maintenance');
const more = group('more');
const cleanups = group('cleanups');
const snow = group('snow-removal');
const photoItems = construction.items.filter((i) => i.image);
const iconItems = construction.items.filter((i) => !i.image);

// Each service as a schema.org Service, using the services.json titles.
const site = Astro.site!;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': groups.flatMap((g) =>
    g.items.map((i) => ({
      '@type': 'Service',
      name: i.title,
      description: i.text,
      serviceType: g.id === 'more' ? i.title : g.title,
      provider: { '@type': 'LocalBusiness', name: 'Euro Style Landscape', url: site.href, telephone: '+1-732-803-9646' },
      areaServed: { '@type': 'AdministrativeArea', name: 'Middlesex County, NJ' },
    })),
  ),
};
---
<BaseLayout
  title="Landscaping, Hardscaping & Lawn Care in Sayreville, NJ · Euro Style Landscape"
  description="Pavers, retaining walls, decks, masonry, lawn maintenance, cleanups, snow removal, fencing and planting for homes and commercial properties in Middlesex County, NJ."
  current="services"
  jsonLd={jsonLd}
>
  <PageBanner
    crumb="Services"
    title="Landscape services"
    lead="Construction, lawn maintenance, cleanups, snow removal, fencing, planting and landscape installation for homes and commercial properties, all from one local team."
    leadMax={680}
    tight
  >
    <div class="jump">
      {jumpLinks.map((l) => <a href={l.href.replace('/services', '')} class="btn btn-light-ghost jump-link">{l.label}</a>)}
    </div>
  </PageBanner>

  <!-- 1. Construction -->
  <section id={construction.id} class="section">
    <div class="container stack" style="gap:32px">
      <SectionHeader
        badge={construction.badge}
        title={construction.title}
        kicker="Designed and built by one team"
        description={construction.intro}
      />
      <div class="svc-grid">
        {photoItems.map((item) => <ServiceCard item={item} class={item.featured ? 'svc-feature' : undefined} />)}
      </div>
      <div class="grid-auto" style="--min:250px;--gap:24px">
        {iconItems.map((item) => <ServiceCard item={item} />)}
      </div>
      <div class="plan-box">
        <div class="stack" style="flex:1 1 420px;gap:6px">
          <p class="plan-title">Planning a backyard project?</p>
          <p class="plan-text">Free on-site consultation, then a design and a detailed written quote.</p>
        </div>
        {construction.cta && <a href={construction.cta.href} class="btn btn-lg btn-sand plan-btn">{construction.cta.label}</a>}
      </div>
    </div>
  </section>

  <!-- 2. Lawn maintenance (Google Search ads land here) -->
  <section id={lawn.id} class="section section-white">
    <div class="container feature">
      <div class="feature-media">
        <Photo src={lawn.image!} alt={lawn.alt!} sizes="(min-width: 1280px) 560px, (min-width: 1000px) 44vw, 92vw" style={`display:block;width:100%;aspect-ratio:5 / 4;object-fit:cover;border-radius:16px;background-color:${photoBg(lawn.image!)}`} />
      </div>
      <div class="feature-copy">
        <p class="kicker">{lawn.title}</p>
        <h2 class="h2">{lawn.heading}</h2>
        <p class="body-lg">{lawn.intro}</p>
        <div class="grid-auto" style="--min:230px;--gap:12px">
          {lawn.items.map((item) => <ServiceCard item={item} variant="mini" />)}
        </div>
        <div class="btn-row">
          {lawn.cta && <a href={lawn.cta.href} class="btn btn-md btn-primary">{lawn.cta.label}</a>}
          <a href={PHONE_HREF} class="btn btn-md btn-outline">
            <Icon name="phone" size={16} />
            Call {PHONE_DISPLAY}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Fencing, planting & landscape install (ids on the cards) -->
  <section class="section">
    <div class="container stack" style="gap:32px">
      <SectionHeader title={more.title} description={more.intro} />
      <div class="grid-auto" style="--min:300px;--gap:24px">
        {more.items.map((item) => <ServiceCard item={item} anchor />)}
      </div>
    </div>
  </section>

  <!-- 4. Cleanups & property refresh (linked from the footer and the Home offer banner) -->
  <section id={cleanups.id} class="section">
    <div class="container stack" style="gap:28px">
      <div class="sec-head">
        <div class="stack" style="flex:1 1 520px;gap:14px">
          <p class="kicker">{cleanups.title}</p>
          <h2 class="h2">{cleanups.heading}</h2>
        </div>
        <p class="body-muted" style="flex:1 1 380px">{cleanups.intro}</p>
      </div>
      {NEW_CLIENT_OFFER_ON && (
        // NEW CLIENT OFFER card (hidden while NEW_CLIENT_OFFER_ON is false)
        <div class="offer-card">
          <div class="stack" style="flex:1 1 480px;min-width:0;gap:8px">
            <span class="offer-pill"><Icon name="tag" size={16} strokeWidth={2.4} />New client special</span>
            <p class="offer-head"><span class="gold">20% off</span> your first cleanup or property refresh</p>
            <p class="offer-terms">{NEW_CLIENT_OFFER_TERMS}</p>
          </div>
          <a href="/contact#quote" class="btn btn-sand offer-btn">Claim 20% off <Icon name="arrow-right" size={18} strokeWidth={2.2} /></a>
        </div>
      )}
      <div class="clean-grid">
        {cleanups.items.map((item) => (
          <article class="card clean-card">
            <div class="clean-img" style={`background-color:${photoBg(item.image!)}`}>
              <Photo src={item.image!} alt={item.alt!} sizes="(min-width: 1280px) 300px, (min-width: 640px) 45vw, 92vw" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover" />
            </div>
            <div class="clean-body">
              <h3 class="clean-title">{item.title}</h3>
              <p class="body-muted">{item.text}</p>
              <a href={item.link!.href} class="btn btn-md btn-primary clean-btn" aria-label={`Get a free quote for ${item.title.toLowerCase()}`}>{item.link!.label} <Icon name="arrow-right" size={16} strokeWidth={2.2} /></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. Snow removal (from the commercial flyer) -->
  <section id={snow.id} class="section snow">
    <div class="container stack" style="gap:28px">
      <div class="sec-head">
        <div class="stack" style="flex:1 1 520px;gap:14px">
          <p class="kicker">{snow.title}</p>
          <h2 class="h2">{snow.heading}</h2>
        </div>
        <p class="body-muted" style="flex:1 1 380px">{snow.intro}</p>
      </div>
      <div class="grid-auto" style="--min:240px;--gap:16px">
        {snow.items.map((item) => (
          <div class="snow-tile">
            <span class="icon-circle snow-disc"><Icon name={item.icon ?? 'check'} size={24} /></span>
            <h3 class="snow-title">{item.title}</h3>
            <p class="body-muted">{item.text}</p>
          </div>
        ))}
      </div>
      <div class="btn-row" style="margin-top:0">
        {snow.cta && <a href={snow.cta.href} class="btn btn-md btn-primary">{snow.cta.label} <Icon name="arrow-right" size={16} strokeWidth={2.2} /></a>}
        <a href={PHONE_HREF} class="btn btn-md btn-outline"><Icon name="phone" size={16} />Call {PHONE_DISPLAY}</a>
      </div>
    </div>
  </section>

  <!-- 6. Commercial property services (matches the commercial flyer; its QR code can point here) -->
  <section id="commercial" class="section">
    <div class="container stack" style="gap:28px">
      <div class="sec-head">
        <div class="stack" style="flex:1 1 520px;gap:14px">
          <p class="kicker">{commercial.title}</p>
          <h2 class="h2">{commercial.heading}</h2>
        </div>
        <p class="body-muted" style="flex:1 1 380px">{commercial.intro}</p>
      </div>
      <div class="comm">
        <div class="comm-lists">
          {commercial.lists.map((l) => (
            <div class="comm-card">
              <h3 class="comm-title">{l.title}</h3>
              <ul class="comm-ul">
                {l.items.map((i) => <li><span class="diamond" aria-hidden="true"></span>{i}</li>)}
              </ul>
            </div>
          ))}
        </div>
        <div class="why">
          <p class="why-label">Why choose us</p>
          <ul class="why-ul">
            {commercial.why.map((w) => <li><span class="gold"><Icon name="check" size={20} strokeWidth={2.4} /></span>{w}</li>)}
          </ul>
          <a href={commercial.cta.href} class="btn btn-sand why-btn">{commercial.cta.label}</a>
          <a href={PHONE_HREF} class="why-call"><Icon name="phone" size={18} />{PHONE_DISPLAY}</a>
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    title="Not sure what you need?"
    text="Book a free consultation and we'll talk it through on site."
    cta={{ href: '/contact', label: 'Book a free consultation' }}
  />

<script is:inline>
  // Old anchors (previous site, ads, bookmarks) → new sections.
  (function () {
    var map = { '#design': '#construction', '#maintenance': '#lawn-maintenance' };
    function fix() {
      var to = map[location.hash];
      if (!to) return;
      history.replaceState(null, '', to);
      var el = document.querySelector(to);
      if (el) el.scrollIntoView();
    }
    fix();
    window.addEventListener('hashchange', fix);
  })();
</script>
</BaseLayout>

<style>
  .jump { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; padding: 0; }
  .jump-link { height: 44px; padding: 0 18px; border-color: var(--line-strong); border-radius: 999px; font-size: 15px; white-space: nowrap; }
  @media (max-width: 767px) {
    .jump { flex-wrap: nowrap; overflow-x: auto; margin: 12px -16px 0; padding: 0 16px 4px; scrollbar-width: none; }
    .jump-link { flex: none; }
  }
  .svc-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .svc-grid :global(.svc-feature) { grid-column: span 2; }
  @media (max-width: 1023px) { .svc-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 767px) {
    .svc-grid { grid-template-columns: 1fr; }
    .svc-grid :global(.svc-feature) { grid-column: auto; }
  }
  .plan-box {
    background: var(--forest-800); color: var(--on-dark); border-radius: 16px; padding: clamp(24px, 3vw, 32px);
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px;
  }
  .plan-title { margin: 0; font-size: 22px; font-weight: 600; line-height: 1.3; }
  .plan-text { margin: 0; font-size: 16px; line-height: 1.6; color: var(--on-dark-muted); }
  .feature { display: flex; flex-wrap: wrap; gap: 40px 64px; align-items: center; }
  .feature-media { flex: 1 1 440px; min-width: 0; }
  .feature-copy { flex: 1 1 480px; min-width: 0; display: flex; flex-direction: column; gap: 18px; }
  .btn-row { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }
  /* Wraps instead of overflowing at 320px (UPDATE-4-SITE.md §7). */
  .plan-btn { flex: 0 1 auto; height: auto; min-height: 52px; text-align: center; }
  .sec-head { display: flex; flex-wrap: wrap; gap: 16px 48px; align-items: flex-end; justify-content: space-between; }
  .offer-card {
    background: var(--forest-800); color: var(--on-dark); border-radius: 16px; box-shadow: 0 0 0 2px var(--sand-500);
    padding: clamp(20px, 3vw, 28px); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px 32px;
  }
  .offer-pill {
    display: inline-flex; align-items: center; gap: 8px; align-self: flex-start; padding: 6px 14px; border-radius: 999px;
    background: var(--sand-500); color: var(--charcoal); font-size: 13px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase;
  }
  .offer-head { margin: 0; font-size: clamp(1.375rem, 1.15rem + .9vw, 1.875rem); line-height: 1.2; font-weight: 800; }
  .gold { color: var(--sand-500); }
  .offer-terms { margin: 0; font-size: 13px; line-height: 1.5; color: var(--on-dark-muted); }
  .offer-btn { flex: 0 1 260px; height: 54px; padding: 0 22px; font-size: 16px; }
  .clean-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; }
  @media (max-width: 1179px) { .clean-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 639px) { .clean-grid { grid-template-columns: 1fr; } }
  .clean-card { display: flex; flex-direction: column; }
  .clean-img { position: relative; aspect-ratio: 16 / 10; overflow: hidden; }
  .clean-body { padding: 22px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
  .clean-title { margin: 0; font-size: 22px; line-height: 1.3; font-weight: 700; }
  .clean-btn { align-self: flex-start; margin-top: auto; }
  .snow { background: var(--sage-100); border-top: 1px solid var(--sage-200); border-bottom: 1px solid var(--sage-200); }
  .snow-tile { background: var(--white); border: 1px solid var(--sage-200); border-radius: 14px; padding: 22px; display: flex; flex-direction: column; gap: 12px; }
  .snow-disc { width: 52px; height: 52px; background: var(--forest-800); color: var(--sand-500); }
  .snow-title { margin: 0; font-size: 20px; line-height: 1.3; font-weight: 600; }
  .comm { display: flex; flex-wrap: wrap; gap: 24px; }
  .comm-lists { flex: 999 1 560px; min-width: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr)); gap: 16px; align-content: start; }
  .comm-card { background: var(--white); border: 1px solid var(--line); border-radius: 14px; padding: 20px; display: flex; flex-direction: column; gap: 10px; }
  .comm-title { margin: 0; font-size: 18px; line-height: 1.3; font-weight: 700; }
  .comm-ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .comm-ul li { display: flex; gap: 10px; align-items: flex-start; font-size: 15px; line-height: 1.5; color: var(--ink-muted); }
  .diamond { flex: none; margin-top: 7px; width: 7px; height: 7px; transform: rotate(45deg); background: var(--sand-500); }
  .why {
    flex: 1 1 300px; min-width: 0; align-self: flex-start; background: var(--forest-800); color: var(--on-dark);
    border-radius: 16px; padding: 26px; display: flex; flex-direction: column; gap: 16px;
  }
  .why-label { margin: 0; font-size: 13px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: var(--sand-500); }
  .why-ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .why-ul li { display: flex; gap: 10px; align-items: center; font-size: 16px; font-weight: 600; }
  .why-ul .gold { display: flex; }
  .why-btn { margin-top: 6px; height: auto; min-height: 52px; padding: 8px 20px; text-align: center; font-size: 16px; }
  .why-call { display: flex; align-items: center; justify-content: center; gap: 8px; color: var(--on-dark); font-size: 16px; font-weight: 600; text-decoration: none; min-height: 44px; }
  .why-call:hover { color: var(--on-dark); }
</style>
