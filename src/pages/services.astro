---
// Services overview: the 9 services as groups with the anchors ad pages link to (#construction ... #commercial).
// Body: src/components/pages/services.astro. JSON-LD: each of the 9 services as a Service, plus the FAQ.
import BaseLayout from '../layouts/BaseLayout.astro';
import Services from '../components/pages/services.astro';
import { servicePages } from '../lib/servicePages';
import { business, breadcrumbs, faqPage } from '../lib/schema';

const site = Astro.site!;
const provider = business(site);
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    ...servicePages.map((p) => ({
      '@type': 'Service',
      name: p.name,
      serviceType: p.serviceType,
      description: p.descriptionNoOffer ?? p.description,
      url: new URL(`/services/${p.key}`, site).href,
      provider,
      areaServed: ['Middlesex County, NJ', 'Monmouth County, NJ', 'Union County, NJ'].map((name) => ({ '@type': 'AdministrativeArea', name })),
    })),
    faqPage('services'),
    breadcrumbs(site, ['Services', '/services']),
  ],
};
---
<BaseLayout
  title="Landscaping, Hardscaping & Lawn Care in Sayreville, NJ · Euro Style Landscape"
  description="Pavers, retaining walls, decks, masonry, lawn maintenance, cleanups, snow removal, fencing and planting for homes and commercial properties in Middlesex County, NJ."
  current="services"
  jsonLd={jsonLd}
>
  <Services />
</BaseLayout>
