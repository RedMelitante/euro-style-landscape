---
// /service-areas: the list of town pages. Not in the handoff designs; it exists so the town pages'
// breadcrumb (Home › Service areas › Town, also in their JSON-LD) has a real page to point to.
// Built from the update 6 inner-page pieces (tint hero, service cards, quote section).
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuoteSection from '../../components/site/QuoteSection.astro';
import { townHref, towns } from '../../lib/towns';
import { PHONE_DISPLAY, PHONE_HREF } from '../../lib/site';
import { breadcrumbs } from '../../lib/schema';

const site = Astro.site!;
const jsonLd = { '@context': 'https://schema.org', ...breadcrumbs(site, ['Service areas', '/service-areas']) };
const pin = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path><circle cx="12" cy="10" r="3"></circle></svg>';
---
<BaseLayout
  title="Service Areas · Landscaping in Middlesex, Monmouth & Union County, NJ · Euro Style Landscape"
  description="Euro Style Landscape is based in Sayreville, NJ and serves Middlesex, Monmouth & Union County towns. Find your town."
  current="areas"
  jsonLd={jsonLd}
>
  <section class="shero">
    <div class="wrap">
      <nav aria-label="Breadcrumb" class="crumb"><a href="/">Home</a><span aria-hidden="true">&rsaquo;</span><span aria-current="page" style="color: #2E343A">Service areas</span></nav>
      <div style="display: flex; flex-direction: column; gap: 20px; max-width: 760px">
        <p class="eb">Where we work</p>
        <h1 class="hd sh1">Service areas</h1>
        <p class="lede">Based in Sayreville, NJ · serving Middlesex, Monmouth &amp; Union County towns</p>
        <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; margin-top: 4px">
          <a href="#quote" class="btn btn-g">Book a free consultation</a>
          <a href={PHONE_HREF} class="lnk">{PHONE_DISPLAY}</a>
        </div>
      </div>
    </div>
  </section>
  <section class="sec">
    <div class="wrap">
      <div class="scards" style="grid-template-columns: repeat(auto-fill, minmax(min(260px, 100%), 1fr))">
        {towns.map((t) => (
          <a href={townHref(t.slug)} class="sc"><span class="ii" set:html={pin} /><span><b>{t.name}</b><span>{t.county}</span></span></a>
        ))}
      </div>
    </div>
  </section>
  <QuoteSection
    eyebrow="Free consultation"
    title="Get a free quote"
    lede="Tell us about your project and we'll call you to book a free on-site consultation."
    formId="service-areas"
    source="service-areas"
  />
</BaseLayout>
