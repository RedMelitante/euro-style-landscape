---
// Service-area town pages (/service-areas/<slug>). SEO values in src/data/towns.json; the page body for each
// town is src/components/pages/town-<slug>.astro (converted from design/service-area-*.dc.html, update 6-7).
// Indexable, in the sitemap, with LandscapingBusiness, FAQPage and BreadcrumbList JSON-LD.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { towns, type Town } from '../../lib/towns';
import { business, breadcrumbs, faqPage } from '../../lib/schema';

const bodies = import.meta.glob<{ default: AstroComponentFactory }>('../../components/pages/town-*.astro', { eager: true });
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';

export function getStaticPaths() {
  return towns.map((town) => ({ params: { town: town.slug }, props: { town } }));
}

interface Props {
  town: Town;
}

const { town } = Astro.props;
const Body = bodies[`../../components/pages/town-${town.slug}.astro`]?.default;
if (!Body) throw new Error(`Missing page body for ${town.slug}`);

const site = Astro.site!;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    business(site, { areaServed: { '@type': 'City', name: town.place } }),
    faqPage(town.slug),
    breadcrumbs(site, ['Service areas', '/service-areas'], [town.place, `/service-areas/${town.slug}`]),
  ],
};
---
<BaseLayout title={town.title} description={town.description} current="areas" currentTown={town.slug} jsonLd={jsonLd}>
  <Body />
</BaseLayout>
