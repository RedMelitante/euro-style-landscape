---
// Service pages (/services/<key>). SEO values in src/data/service-pages.json; the page body for each service is
// src/components/pages/service-<key>.astro (converted from design/service-*.dc.html, update 6-7).
// Indexable, in the sitemap, with Service, FAQPage and BreadcrumbList JSON-LD.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { NEW_CLIENT_OFFER_ON } from '../../lib/campaigns';
import { towns } from '../../lib/towns';
import { servicePages, type ServicePage } from '../../lib/servicePages';
import { business, breadcrumbs, faqPage } from '../../lib/schema';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';

const bodies = import.meta.glob<{ default: AstroComponentFactory }>('../../components/pages/service-*.astro', { eager: true });

export function getStaticPaths() {
  return servicePages.map((page) => ({ params: { service: page.key }, props: { page } }));
}

interface Props {
  page: ServicePage;
}

const { page } = Astro.props;
const Body = bodies[`../../components/pages/service-${page.key}.astro`]?.default;
if (!Body) throw new Error(`Missing page body for ${page.key}`);
// The offer sentence in the Cleanups meta description follows the NEW_CLIENT_OFFER_ON switch.
const description = NEW_CLIENT_OFFER_ON ? page.description : page.descriptionNoOffer ?? page.description;

const site = Astro.site!;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: page.name,
      serviceType: page.serviceType,
      description,
      url: new URL(`/services/${page.key}`, site).href,
      provider: business(site),
      areaServed:
        page.areaServed === 'counties'
          ? ['Middlesex County, NJ', 'Monmouth County, NJ', 'Union County, NJ'].map((name) => ({ '@type': 'AdministrativeArea', name }))
          : towns.map((t) => ({ '@type': 'City', name: t.place })),
    },
    faqPage(page.key),
    breadcrumbs(site, ['Services', '/services'], [page.name, `/services/${page.key}`]),
  ],
};
---
<BaseLayout title={page.title} description={description} current={page.key === 'commercial' ? 'commercial' : 'services'} currentService={page.key} jsonLd={jsonLd}>
  <Body />
</BaseLayout>
