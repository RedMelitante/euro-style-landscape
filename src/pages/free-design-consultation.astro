---
// Ad landing page (Meta ads). No site navigation, minimal footer, noindex.
import LandingLayout from '../layouts/LandingLayout.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import ConsultForm from '../components/ConsultForm.astro';
import { RATING, REVIEW_COUNT, REVIEWS_URL } from '../lib/reviews';
import SectionHeader from '../components/SectionHeader.astro';
import CommitmentCards from '../components/CommitmentCards.astro';
import HowItWorks from '../components/HowItWorks.astro';
import TrustTiles from '../components/TrustTiles.astro';
import Icon from '../components/Icon.astro';
import { PHONE_DISPLAY, PHONE_HREF } from '../lib/site';

const pairs = [
  { title: 'Full backyard makeover', beforeSrc: 'backyard-before.jpg', afterSrc: 'backyard-after.jpg', before: 'Backyard before: bare soil along the fence', after: 'Backyard after: new lawn, paver walkway and deck', beforeLabel: 'BEFORE', afterLabel: 'AFTER' },
  { title: 'Raised patio with step lighting', beforeSrc: 'raised-patio-day.jpg', afterSrc: 'raised-patio-night.jpg', before: 'Raised paver patio by day', after: 'The same patio at night with step lights', beforeLabel: 'DAY', afterLabel: 'NIGHT' },
  { title: 'Front entry steps', beforeSrc: 'front-steps-during.jpg', afterSrc: 'front-entry-after.jpg', before: 'Front entry steps being built', after: 'The finished front entry and walkway', beforeLabel: 'DURING', afterLabel: 'AFTER' },
  { title: 'Raised paver patio & steps', beforeSrc: 'raised-patio-render-2.jpg', afterSrc: 'raised-patio-built-2.jpg', before: '3D design of a raised patio with steps', after: 'The finished raised patio with steps', beforeLabel: '3D DESIGN', afterLabel: 'FINISHED' },
];
const heroChecks = ['Free on-site consultation', 'Design & written quote', 'Licensed & insured'];
const ctaChecks = ['On-site visit and design ideas, free', 'Detailed written quote before any work starts', 'Licensed & insured for your peace of mind'];
---
<LandingLayout
  title="Free Backyard Design Consultation · Eurostyle Landscape"
  description="Tell us what you have in mind. We'll visit, plan it with you, and give you an exact written price within 24 hours."
  quoteHref="#quote"
  stickyLabel="Get my free quote"
>
  <!-- Hero: headline + before/after + form -->
  <section class="sage-top" style="padding:clamp(32px, 5vw, 72px) 0 clamp(40px, 6vw, 88px)">
    <div class="container hero">
      <div class="hero-copy">
        <p class="eyebrow">Free on-site consultation</p>
        <h1 class="h1">Patios, driveways, walkways &amp; steps built to last.</h1>
        <p class="lead" style="max-width:620px">Tell us what you have in mind. We'll visit, plan it with you, and give you an exact written price within 24 hours.</p>
        <ul class="inline-checks">
          {heroChecks.map((c) => <li><Icon name="check" size={18} stroke="#197148" strokeWidth={2.4} />{c}</li>)}
        </ul>
        <a href="#quote" class="m-only btn btn-primary btn-lg">Get a free quote
          <Icon name="arrow-down" size={18} />
        </a>
        <figure class="hero-fig">
          <BeforeAfter
            beforeSrc="raised-patio-design.jpg"
            afterSrc="raised-patio-built.jpg"
            before="3D design of a raised paver patio"
            after="The finished raised paver patio"
            beforeLabel="3D DESIGN"
            afterLabel="FINISHED"
            ratio="16 / 10"
            sizes="(min-width: 1280px) 720px, (min-width: 1100px) 56vw, 100vw"
            eager
          />
          <figcaption>From 3D design to finished patio — drag to compare. A real Eurostyle Landscape project.</figcaption>
        </figure>
      </div>
      <div id="quote" class="form-col qf-slot">
        <ConsultForm id="top" />
      </div>
    </div>
  </section>

  <!-- Before & after projects -->
  <section class="section">
    <div class="container stack" style="gap:32px">
      <SectionHeader
        title="Real backyards, transformed"
        kicker="Before & after"
        description="Drag the slider on any project to see the change. Every project shown is a real Eurostyle Landscape job."
      />
      <div class="grid-auto" style="--min:480px;--gap:32px 24px">
        {pairs.map((p) => (
          <div class="stack" style="gap:14px">
            <BeforeAfter {...p} ratio="3 / 2" sizes="(min-width: 1280px) 612px, (min-width: 1000px) 48vw, 100vw" />
            <span class="pair-title">{p.title}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Reviews: real Google reviews, quoted word for word (the same as the website). No reviewer towns; no review schema. -->
  <section style="background: #EFF4E7; padding: clamp(56px, 7vw, 96px) 0; border-top: 1px solid #DCE4D2">
    <div style="max-width: 1280px; margin: 0 auto; padding: 0 16px; display: flex; flex-direction: column; gap: 24px">
      <div style="display: flex; flex-direction: column; gap: 10px">
        <p style="margin: 0; font-size: 14px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: #197148">Reviews</p>
        <h2 style="margin: 0; font-size: clamp(1.875rem, 1.4rem + 1.6vw, 2.75rem); line-height: 1.12; font-weight: 600; letter-spacing: -0.01em">What homeowners say</h2>
        <p style="margin: 4px 0 0; display: flex; align-items: center; gap: 8px; font-size: 17px; color: #2E343A"><svg width="22" height="22" viewBox="0 0 48 48" aria-hidden="true" style="flex: none"><path fill="#FFC107" d="M43.6 20.1H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.6-.4-3.9z"/><path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.1H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.6-.4-3.9z"/></svg><svg width="20" height="20" viewBox="0 0 24 24" fill="#F4B400" aria-hidden="true"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"></path></svg><span><b>{RATING}</b> from {REVIEW_COUNT} Google reviews</span></p>
      </div>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: 16px">
        <figure style="margin: 0; background: #FFFFFF; border: 1px solid #DCE4D2; border-radius: 14px; padding: 24px 22px; display: flex; flex-direction: column; gap: 14px; box-shadow: 0 8px 24px rgba(17,22,18,.06)">
          <span role="img" aria-label="5 out of 5 stars" style="display: inline-flex; gap: 2px"><svg width="18" height="18" viewBox="0 0 24 24" fill="#F4B400" aria-hidden="true"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"></path></svg><svg width="18" height="18" viewBox="0 0 24 24" fill="#F4B400" aria-hidden="true"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"></path></svg><svg width="18" height="18" viewBox="0 0 24 24" fill="#F4B400" aria-hidden="true"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"></path></svg><svg width="18" height="18" viewBox="0 0 24 24" fill="#F4B400" aria-hidden="true"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"></path></svg><svg width="18" height="18" viewBox="0 0 24 24" fill="#F4B400" aria-hidden="true"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"></path></svg></span>
          <blockquote style="margin: 0; font-size: 16px; line-height: 1.6; color: #2E343A">&ldquo;Huge shoutout to Sean and his team for an amazing backyard makeover! &hellip; We hired them to clear out our old stone yard, level everything out for a new lawn, build a custom brick patio, clean up some overgrown and dead trees and install a vinyl fence. They absolutely nailed it. &hellip;&rdquo;</blockquote>
          <figcaption style="margin-top: auto; display: flex; flex-direction: column; gap: 2px; font-size: 14px; color: #4A5157"><b style="font-size: 16px; color: #0F4A2F">Caleb D.</b><span>Google review</span></figcaption>
        </figure>
        <figure style="margin: 0; background: #FFFFFF; border: 1px solid #DCE4D2; border-radius: 14px; padding: 24px 22px; display: flex; flex-direction: column; gap: 14px; box-shadow: 0 8px 24px rgba(17,22,18,.06)">
          <span role="img" aria-label="5 out of 5 stars" style="display: inline-flex; gap: 2px"><svg width="18" height="18" viewBox="0 0 24 24" fill="#F4B400" aria-hidden="true"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"></path></svg><svg width="18" height="18" viewBox="0 0 24 24" fill="#F4B400" aria-hidden="true"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"></path></svg><svg width="18" height="18" viewBox="0 0 24 24" fill="#F4B400" aria-hidden="true"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"></path></svg><svg width="18" height="18" viewBox="0 0 24 24" fill="#F4B400" aria-hidden="true"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"></path></svg><svg width="18" height="18" viewBox="0 0 24 24" fill="#F4B400" aria-hidden="true"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"></path></svg></span>
          <blockquote style="margin: 0; font-size: 16px; line-height: 1.6; color: #2E343A">&ldquo;Sean was great. He came and helped me finish my walk that someone else started but didn&rsquo;t finish and did a great job.&rdquo;</blockquote>
          <figcaption style="margin-top: auto; display: flex; flex-direction: column; gap: 2px; font-size: 14px; color: #4A5157"><b style="font-size: 16px; color: #0F4A2F">Frank</b><span>Google review</span></figcaption>
        </figure>
        <figure style="margin: 0; background: #FFFFFF; border: 1px solid #DCE4D2; border-radius: 14px; padding: 24px 22px; display: flex; flex-direction: column; gap: 14px; box-shadow: 0 8px 24px rgba(17,22,18,.06)">
          <span role="img" aria-label="5 out of 5 stars" style="display: inline-flex; gap: 2px"><svg width="18" height="18" viewBox="0 0 24 24" fill="#F4B400" aria-hidden="true"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"></path></svg><svg width="18" height="18" viewBox="0 0 24 24" fill="#F4B400" aria-hidden="true"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"></path></svg><svg width="18" height="18" viewBox="0 0 24 24" fill="#F4B400" aria-hidden="true"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"></path></svg><svg width="18" height="18" viewBox="0 0 24 24" fill="#F4B400" aria-hidden="true"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"></path></svg><svg width="18" height="18" viewBox="0 0 24 24" fill="#F4B400" aria-hidden="true"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"></path></svg></span>
          <blockquote style="margin: 0; font-size: 16px; line-height: 1.6; color: #2E343A">&ldquo;I found Sean to be exceptionally knowledgeable, honest, and very pleasant! He is very reachable, priced competitively and most importantly does amazing work! I highly recommend his services!&rdquo;</blockquote>
          <figcaption style="margin-top: auto; display: flex; flex-direction: column; gap: 2px; font-size: 14px; color: #4A5157"><b style="font-size: 16px; color: #0F4A2F">Shraga K.</b><span>Google review</span></figcaption>
        </figure>
      </div>
      <a href={REVIEWS_URL} target="_blank" rel="noopener" style="align-self: flex-start; font-size: 15px; font-weight: 700; color: #0F4A2F; text-decoration: underline; text-underline-offset: 3px">Read more on Google</a>
    </div>
  </section>

  <CommitmentCards />

  <!-- How it works + trust row -->
  <section class="section">
    <div class="container stack" style="gap:32px">
      <SectionHeader
        title="How it works"
        kicker="Three simple steps"
        description="From the first conversation to the finished space, you deal with one team the whole way through."
      />
      <HowItWorks
        images={[
          { src: 'team.jpg', alt: 'The Eurostyle Landscape crew' },
          { src: 'design-render-night.jpg', alt: 'A 3D backyard design with evening lighting' },
          { src: 'front-steps-during.jpg', alt: 'A crew member building stone front steps', position: 'center 70%' },
        ]}
      />
      <TrustTiles style="margin-top:16px" />
    </div>
  </section>

  <!-- Repeat CTA + form -->
  <section class="section-forest" style="padding:clamp(56px, 7vw, 104px) 0">
    <div class="container cta">
      <div class="cta-copy">
        <p class="eyebrow eyebrow-dark">Free, no-obligation consultation</p>
        <h2 class="h2">Ready to see what your backyard could be?</h2>
        <p class="cta-lead">Tell us a little about your project. We'll come to you, listen, and show you what's possible for your space and budget.</p>
        <ul class="cta-checks">
          {ctaChecks.map((c) => <li><Icon name="check" size={20} stroke="#B9BB4A" strokeWidth={2.4} />{c}</li>)}
        </ul>
        <a href={PHONE_HREF} class="cta-call">
          <Icon name="phone" size={20} stroke="#B9BB4A" />
          Prefer to talk? Call {PHONE_DISPLAY}
        </a>
      </div>
      <div id="quote-bottom" class="form-col qf-slot">
        <ConsultForm id="bottom" />
      </div>
    </div>
  </section>
</LandingLayout>

<style>
  .hero { display: flex; flex-wrap: wrap; gap: 48px; align-items: flex-start; }
  .hero-copy { flex: 999 1 560px; min-width: 0; display: flex; flex-direction: column; gap: 20px; }
  .form-col { flex: 1 1 460px; max-width: 480px; min-width: 0; }
  .inline-checks { list-style: none; margin: 0; padding: 0; display: flex; align-items: center; gap: 8px 20px; flex-wrap: wrap; font-size: 15px; color: var(--ink); }
  .inline-checks li { display: flex; align-items: center; gap: 8px; }
  .hero-fig { margin: 8px 0 0; display: flex; flex-direction: column; gap: 10px; }
  .hero-fig figcaption { font-size: 14px; color: var(--ink-muted); }
  .pair-title { font-size: 18px; font-weight: 600; }
  .cta { display: flex; flex-wrap: wrap; gap: 48px; align-items: center; }
  .cta-copy { flex: 999 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 20px; }
  .cta-lead { margin: 0; font-size: 17px; line-height: 1.6; color: var(--on-dark-muted); max-width: 560px; }
  .cta-checks { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .cta-checks li { display: flex; align-items: center; gap: 12px; font-size: 16px; }
  .cta-call { display: flex; align-items: center; gap: 10px; color: var(--on-dark); text-decoration: none; font-size: 17px; font-weight: 600; margin-top: 4px; }
  .cta-call:hover { color: var(--on-dark); }
</style>
