---
// Our Work: project groups with anchors (#project-videos ... #snow-removal, update 7 §6). Body: src/components/pages/our-work.astro.
import BaseLayout from '../layouts/BaseLayout.astro';
import OurWork from '../components/pages/our-work.astro';
import { business, breadcrumbs } from '../lib/schema';

const site = Astro.site!;
const jsonLd = { '@context': 'https://schema.org', '@graph': [business(site), breadcrumbs(site, ['Our work', '/our-work'])] };
---
<BaseLayout
  title="Our Work: Before & After Projects · Euro Style Landscape"
  description="Drag to compare real Euro Style Landscape projects: patios, retaining walls, decks, lawns and full backyard makeovers."
  current="work"
  jsonLd={jsonLd}
>
  <OurWork />
</BaseLayout>
