---
// Required before ads run. The client supplies the policy text (HANDOFF §3,
// §11): paste it into the <div class="policy"> below, then remove `noindex`.
import BaseLayout from '../layouts/BaseLayout.astro';
import { EMAIL, PHONE_DISPLAY, PHONE_HREF } from '../lib/site';
---
<BaseLayout title="Privacy Policy · Euro Style Landscape" noindex>
  <section class="sage-top" style="padding:clamp(40px, 6vw, 80px) 0 clamp(40px, 5vw, 72px)">
    <div class="container stack" style="gap:16px">
      <nav aria-label="Breadcrumb" class="crumbs">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page" style="color:#1E2621">Privacy policy</span>
      </nav>
      <h1 class="h1">Privacy policy</h1>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="policy">
        <!-- CLIENT POLICY TEXT GOES HERE -->
        <p>Our privacy policy is being prepared. If you have a question about how we handle your information, email <a href={`mailto:${EMAIL}`}>{EMAIL}</a> or call <a href={PHONE_HREF}>{PHONE_DISPLAY}</a>.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .crumbs { display: flex; align-items: center; gap: 8px; font-size: 14px; color: var(--ink-muted); }
  .crumbs a { color: var(--ink-muted); }
  .policy { max-width: 760px; font-size: 17px; line-height: 1.7; color: var(--ink); }
  .policy :global(h2) { font-size: 24px; line-height: 1.3; margin: 32px 0 8px; }
  .policy :global(p) { margin: 0 0 16px; }
</style>
