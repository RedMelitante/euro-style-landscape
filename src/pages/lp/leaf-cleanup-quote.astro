.topbar img{display:block;width:62px;height:62px}
.call-pill{display:inline-flex;align-items:center;gap:8px;min-height:46px;padding:0 16px;border-radius:999px;border:2px solid #C9A46A;color:#F4EFE4;text-decoration:none;font-weight:700;font-size:16px;white-space:nowrap}
.call-pill svg{color:#C9A46A}
.call-pill:hover{background:rgba(201,164,106,.15)}
/* hero */
.hero{position:relative;background:#1F3A2B;color:#F4EFE4;overflow:hidden}
