---
// Ad campaign page, from design/lp-leaf-cleanup-leads.dc.html (see CAMPAIGN-PAGES-UPDATE.md).
import { Font, Image } from 'astro:assets';
import CampaignLayout from '../../layouts/CampaignLayout.astro';
import TimelineField from '../../components/campaign/TimelineField.astro';
import CampaignFormScript from '../../components/campaign/CampaignFormScript.astro';
import NewClientOffer from '../../components/campaign/offer/NewClientOffer.astro';
import OfferPill from '../../components/campaign/offer/OfferPill.astro';
import OfferFormStrip from '../../components/campaign/offer/OfferFormStrip.astro';
import OfferLine from '../../components/campaign/offer/OfferLine.astro';
import { NEW_CLIENT_OFFER_ON as offer, NEW_CLIENT_OFFER_CODE } from '../../lib/campaigns';
import { photo } from '../../lib/images';
import logo from '../../assets/logo/euro-style-landscape-logo.jpg';

---
<CampaignLayout title="Free Leaf Cleanup Estimate · Euro Style Landscape">
  <Fragment slot="head">
    <Font cssVariable="--font-barlow-condensed" />
    <Font cssVariable="--font-barlow" preload={[{ weight: 400 }]} />
    <Font cssVariable="--font-kaushan" />
  </Fragment>
<div style="background:#F4EFE4">


  
  <header class="topbar">
    <div class="wrap">
      <Image src={logo} alt="Euro Style Landscape" width={74} height={74} densities={[1, 2]} loading="eager" class="es-logo" />
      <a href="tel:+17328039646" class="call-pill call-gold" data-track-location="top_bar"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"></path></svg><span>Call (732) 803-9646</span></a>
    </div>
  </header>

  
  <section class="hero full">
    
    <div class="hero-photo"><Image src={photo('autumn-leaves.jpg')} alt="Autumn trees with orange and brown leaves over a lawn" widths={[480, 800, 1200, 1440]} sizes="100vw" format="webp" quality={45} decoding="async" loading="eager" fetchpriority="high" /></div>
    <svg class="leaf " style="left:86%;top:5%;width:30px;height:30px;--r:20deg;animation-delay:0s" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12,1 13.6,5.5 16.5,4 16,8 20.5,6.8 19,10.5 23,12 19,13.6 20,17 15.6,15.6 13,18.2 12.6,20 11.4,20 11,18.2 8.4,15.6 4,17 5,13.6 1,12 5,10.5 3.5,6.8 8,8 7.5,4 10.4,5.5" fill="#E8902A"></polygon><path d="M12 19.5V23.5" stroke="#E8902A" stroke-width="1.4" stroke-linecap="round"></path></svg>
    <svg class="leaf d" style="left:46%;top:62%;width:26px;height:26px;--r:-30deg;animation-delay:2s" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12,1 13.6,5.5 16.5,4 16,8 20.5,6.8 19,10.5 23,12 19,13.6 20,17 15.6,15.6 13,18.2 12.6,20 11.4,20 11,18.2 8.4,15.6 4,17 5,13.6 1,12 5,10.5 3.5,6.8 8,8 7.5,4 10.4,5.5" fill="#C9A46A"></polygon><path d="M12 19.5V23.5" stroke="#C9A46A" stroke-width="1.4" stroke-linecap="round"></path></svg>
    <svg class="leaf d" style="left:5%;top:86%;width:22px;height:22px;--r:50deg;animation-delay:4s" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12,1 13.6,5.5 16.5,4 16,8 20.5,6.8 19,10.5 23,12 19,13.6 20,17 15.6,15.6 13,18.2 12.6,20 11.4,20 11,18.2 8.4,15.6 4,17 5,13.6 1,12 5,10.5 3.5,6.8 8,8 7.5,4 10.4,5.5" fill="#E8902A"></polygon><path d="M12 19.5V23.5" stroke="#E8902A" stroke-width="1.4" stroke-linecap="round"></path></svg>
    <svg class="leaf d" style="left:60%;top:12%;width:20px;height:20px;--r:-60deg;animation-delay:1s" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12,1 13.6,5.5 16.5,4 16,8 20.5,6.8 19,10.5 23,12 19,13.6 20,17 15.6,15.6 13,18.2 12.6,20 11.4,20 11,18.2 8.4,15.6 4,17 5,13.6 1,12 5,10.5 3.5,6.8 8,8 7.5,4 10.4,5.5" fill="#E8902A"></polygon><path d="M12 19.5V23.5" stroke="#E8902A" stroke-width="1.4" stroke-linecap="round"></path></svg>
    <div class="wrap">
      <div class="hero-grid">
        <div class="hero-copy">
          <OfferPill />
          <h1><span class="ograd">Fall leaf</span><span class="cream">Cleanup</span><span class="g">Keep your yard clean this fall!</span></h1>
        </div>
        <div class="form-wrap">
        <div class="form-card" id="quote" data-form-card>
          
          
          <form action="/api/lead" method="post" data-campaign-form style="display:flex;flex-direction:column;gap:14px">
            <div>
              <p class="cond form-title">Get your free estimate</p>
              <p class="form-sub">Takes under a minute.</p>
              <OfferFormStrip service="leaf cleanup" />
            </div>
            <input type="hidden" name="source" value="fb-leaf-cleanup-landing">
            <input type="hidden" name="offer" value={offer ? NEW_CLIENT_OFFER_CODE : 'none'}>
            <input type="hidden" name="form_id" value="fb-leaf-cleanup-landing">
            <div class="hp" aria-hidden="true"><label>Leave empty<input type="text" name="website" tabindex="-1" autocomplete="off"></label></div>
            <label class="fld"><span>Full name</span><input class="qf" name="name" type="text" autocomplete="name" required></label>
            <label class="fld"><span>Email</span><input class="qf" name="email" type="email" autocomplete="email" maxlength="200" required></label>
            <div class="row2">
              <label class="fld"><span>Phone</span><input class="qf" name="phone" type="tel" inputmode="tel" autocomplete="tel" required></label>
              <label class="fld"><span>ZIP code</span><input class="qf" name="zip" type="text" inputmode="numeric" pattern="[0-9]{5}" maxlength="5" autocomplete="postal-code" required></label>
            </div>
            <label class="fld"><span>Service</span>
              <select class="qf" name="service" required>
                <option value="">Choose a service</option>
                <option>One-time leaf cleanup</option>
                <option>Seasonal leaf cleanups</option>
                <option>Leaf + bed cleanup</option>
                <option>Full fall property cleanup</option>
                <option>Not sure yet</option>
              </select>
            </label>
            <TimelineField />
            <label class="fld"><span>Anything we should know about your yard? <em>(optional)</em></span><textarea class="qf" name="message" rows="3"></textarea></label>
            <button type="submit" class="submit cond"><span data-label>Get my free estimate</span> <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"></path></svg></button>
            <p class="form-error" role="alert" data-form-error hidden>Sorry, your request didn't go through. Please try again or call us on (732) 803-9646.</p>
            <p class="fine">Free and no obligation. We'll call you to book a time to visit.{offer && <><br>*20% off applies to your first leaf cleanup. New clients only.</>}</p>
          </form>
          
          
            <div role="status" class="success" tabindex="-1" data-success hidden>
              <span class="ok"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#1F3A2B" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span>
              <p class="cond form-title">Thanks!</p>
              <p>We'll call you shortly to schedule your estimate.</p>
              <a href="tel:+17328039646" class="call-pill" data-track-location="form_success"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"></path></svg><span>Call (732) 803-9646</span></a>
              <button type="button" class="edit" data-reset>Edit my details</button>
            </div>
          
        </div>
        </div>
        <ul class="hero-checks">
          <li><span class="gck"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#F4EFE4" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span>Leaf blowing &amp; raking</li>
          <li><span class="gck"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#F4EFE4" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span>Leaf collection &amp; removal</li>
          <li><span class="gck"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#F4EFE4" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span>Bed &amp; yard cleanup</li>
          <li><span class="gck"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#F4EFE4" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span>One-time or seasonal service</li>
        </ul>
      </div>
    </div>
  </section>

  
  <section class="trust" aria-label="Why choose us">
    <div class="wrap">
      <ul>
        <li><span class="ring" style="width:54px;height:54px;background:#F4EFE4"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#1F3A2B" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z"></path><circle cx="7.5" cy="7.5" r="1.5"></circle></svg></span><span class="cond">Free estimates</span></li>
        <li><span class="ring" style="width:54px;height:54px;background:#F4EFE4"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#1F3A2B" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><path d="m9 12 2 2 4-4"></path></svg></span><span class="cond">Licensed &amp; insured</span></li>
        <li><span class="ring" style="width:54px;height:54px;background:#F4EFE4"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#1F3A2B" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"></path></svg></span><span class="cond">One local team</span></li>
      </ul>
    </div>
  </section>

  
  <section class="svcs">
    <div class="wrap">
      <div class="panel">
        <svg class="leaf " style="left:88%;top:6%;width:28px;height:28px;--r:30deg;animation-delay:1s" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12,1 13.6,5.5 16.5,4 16,8 20.5,6.8 19,10.5 23,12 19,13.6 20,17 15.6,15.6 13,18.2 12.6,20 11.4,20 11,18.2 8.4,15.6 4,17 5,13.6 1,12 5,10.5 3.5,6.8 8,8 7.5,4 10.4,5.5" fill="#E8902A"></polygon><path d="M12 19.5V23.5" stroke="#E8902A" stroke-width="1.4" stroke-linecap="round"></path></svg>
        <svg class="leaf d" style="left:92%;top:80%;width:22px;height:22px;--r:-20deg;animation-delay:3s" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12,1 13.6,5.5 16.5,4 16,8 20.5,6.8 19,10.5 23,12 19,13.6 20,17 15.6,15.6 13,18.2 12.6,20 11.4,20 11,18.2 8.4,15.6 4,17 5,13.6 1,12 5,10.5 3.5,6.8 8,8 7.5,4 10.4,5.5" fill="#C9A46A"></polygon><path d="M12 19.5V23.5" stroke="#C9A46A" stroke-width="1.4" stroke-linecap="round"></path></svg>
        <div>
          <p class="eyebrow" style="color:#C9A46A">What's included</p>
          <h2 style="margin-top:12px">Leaf cleanup<br><span style="color:#C9A46A">starts here</span></h2>
        </div>
        <ul>
        <li><span class="ring" style="width:60px;height:60px;background:#16291F"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#F4EFE4" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12,1 13.6,5.5 16.5,4 16,8 20.5,6.8 19,10.5 23,12 19,13.6 20,17 15.6,15.6 13,18.2 12.6,20 11.4,20 11,18.2 8.4,15.6 4,17 5,13.6 1,12 5,10.5 3.5,6.8 8,8 7.5,4 10.4,5.5"></polygon></svg></span><span><b class="cond">Leaf blowing &amp; raking</b><span>Leaves blown and raked off the lawn, walkways and driveway.</span></span></li>
        <li><span class="ring" style="width:60px;height:60px;background:#16291F"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#F4EFE4" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 4h14v11H1z"></path><path d="M15 8h4l3 3v4h-7"></path><circle cx="5.5" cy="18" r="2"></circle><circle cx="18.5" cy="18" r="2"></circle></svg></span><span><b class="cond">Collection &amp; haul-away</b><span>Leaves collected and hauled away.</span></span></li>
        <li><span class="ring" style="width:60px;height:60px;background:#16291F"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#F4EFE4" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 20h10"></path><path d="M12 20v-8"></path><path d="M12 12c0-3.5 2.5-6 6-6 0 3.5-2.5 6-6 6z"></path><path d="M12 14c0-3-2-5-5-5 0 3 2 5 5 5z"></path></svg></span><span><b class="cond">Bed &amp; shrub clean-out</b><span>Leaves cleared out of beds and from around shrubs.</span></span></li>
        <li><span class="ring" style="width:60px;height:60px;background:#16291F"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#F4EFE4" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 2l4 4-4 4"></path><path d="M3 11V9a3 3 0 0 1 3-3h15"></path><path d="M7 22l-4-4 4-4"></path><path d="M21 13v2a3 3 0 0 1-3 3H3"></path></svg></span><span><b class="cond">One-time or seasonal visits</b><span>One visit, or we come back as the leaves keep falling.</span></span></li>
          <li class="addon">Add-ons: final mow, aeration &amp; fertilization.</li>
        </ul>
        <div><a href="#quote" class="btn-gold">Get my free estimate <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"></path></svg></a></div>
      </div>
    </div>
  </section>

  <NewClientOffer
    service="leaf cleanup"
    chips={['Leaf blowing & raking', 'Bed & shrub clean-out', 'Collection & haul-away', 'One-time or seasonal']}
    label="Claim my 20% off"
    href="#quote"
    terms="*Valid on your first leaf cleanup with Euro Style Landscape. New clients only."
    script="kaushan"
  />

  
  <section class="results">
    <svg class="leaf d" style="left:90%;top:8%;width:26px;height:26px;--r:-20deg;animation-delay:2s" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12,1 13.6,5.5 16.5,4 16,8 20.5,6.8 19,10.5 23,12 19,13.6 20,17 15.6,15.6 13,18.2 12.6,20 11.4,20 11,18.2 8.4,15.6 4,17 5,13.6 1,12 5,10.5 3.5,6.8 8,8 7.5,4 10.4,5.5" fill="#E8902A"></polygon><path d="M12 19.5V23.5" stroke="#E8902A" stroke-width="1.4" stroke-linecap="round"></path></svg>
    <div class="wrap results-in">
      <div>
        <p class="eyebrow" style="color:#C9A46A">Results</p>
        <h2>A cleaner yard<br><span style="color:#C9A46A">starts here</span></h2>
      </div>
      <figure style="margin:0">
        <div class="duo">
          <div class="photo-frame"><Image src={photo('hero-firepit-patio.jpg')} alt="Fallen autumn leaves around a circular paver patio" widths={[480, 800, 1200, 1600]} sizes="(min-width: 1024px) 50vw, 100vw" format="webp" quality={70} decoding="async" loading="lazy" /><span class="pill-tag cond">Fall leaves</span></div>
          <div class="photo-frame"><Image src={photo('driveway-lawn-edges.jpg')} alt="A new driveway with straw-covered lawn edges and a rake on the grass" widths={[480, 800, 1200, 1600]} sizes="(min-width: 1024px) 50vw, 100vw" format="webp" quality={70} decoding="async" loading="lazy" /><span class="pill-tag cond">Lawn edges</span></div>
        </div>
        <figcaption>Real Euro Style projects</figcaption>
      </figure>
    </div>
  </section>

  
  <section class="how">
    <div class="wrap">
      <p class="eyebrow">How it works</p>
      <h2 class="big">Three simple steps</h2>
      <ol class="steps">
        <li class="step"><span class="num cond">01</span><h3 class="cond">Request your free estimate</h3><p>Fill in the form or call. It takes under a minute.</p></li>
        <li class="step"><span class="num cond">02</span><h3 class="cond">We visit and give you a written quote</h3><p>We look at the yard and tell you exactly what the cleanup includes.</p></li>
        <li class="step"><span class="num cond">03</span><h3 class="cond">Our crew clears it and hauls it away</h3><p>Leaves blown, collected and taken away. Your yard, clean.</p></li>
      </ol>
    </div>
  </section>

  
  <section class="areaband" aria-label="Service area">
    <div class="wrap">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#16291F" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
      <p><b>Serving Middlesex County, NJ</b> — Sayreville · Old Bridge · East Brunswick · South Amboy · Edison</p>
    </div>
  </section>

  
  <section class="faqs">
    <div class="wrap">
      <div class="faq-inner">
        <p class="eyebrow">Questions</p>
        <h2 class="big" style="margin-bottom:16px">Good to know</h2>
        <details class="faq" open>
          <summary><span>Do you haul the leaves away?</span><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#1F3A2B" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></summary>
          <p>Yes. Leaves are blown, collected and hauled away, so nothing is left piled at the curb.</p>
        </details>
        <details class="faq">
          <summary><span>Can I book a one-time cleanup?</span><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#1F3A2B" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></summary>
          <p>Yes. Pick "One-time leaf cleanup" in the form, or tell us when we call.</p>
        </details>
        <details class="faq">
          <summary><span>Do you offer seasonal service?</span><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#1F3A2B" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></summary>
          <p>Yes. We can come back through the season as the leaves keep falling. We agree how often at the estimate.</p>
        </details>
        <details class="faq">
          <summary><span>Do I need to be home for the estimate?</span><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#1F3A2B" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></summary>
          <p>It helps, so we can walk the yard together. If you can't be there, tell us when we call and we'll work something out.</p>
        </details>
        <details class="faq">
          <summary><span>Are you licensed and insured?</span><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#1F3A2B" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></summary>
          <p>Yes, Euro Style Landscape is licensed and insured.</p>
        </details>
        {offer && (
        <details class="faq">
          <summary><span>How does the 20% new client offer work?</span><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#1F3A2B" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></summary>
          <p>If you are new to Euro Style Landscape, you get 20% off your first leaf cleanup with us. Send the form or call to book your free estimate.</p>
        </details>
        )}
      </div>
    </div>
  </section>

  
  <div aria-hidden="true" style="background:#F4EFE4;line-height:0;margin-top:-1px"><svg viewBox="0 0 1440 48" preserveAspectRatio="none" style="display:block;width:100%;height:26px"><path d="M0,24 L0,19 L31,27 L69,23 L102,20 L145,29 L188,30 L211,30 L245,21 L288,14 L306,25 L342,27 L362,18 L405,21 L430,15 L461,27 L498,28 L517,24 L552,29 L592,17 L630,25 L648,18 L689,16 L710,14 L742,19 L777,24 L807,29 L829,19 L868,15 L901,21 L921,20 L945,32 L986,16 L1007,31 L1040,31 L1084,26 L1108,24 L1130,31 L1161,23 L1190,28 L1224,26 L1252,29 L1282,22 L1300,16 L1323,29 L1341,29 L1361,31 L1398,30 L1423,32 L1440,24 L1440,48 L0,48 Z" fill="#1F3A2B"></path></svg></div>
  <section class="final">
