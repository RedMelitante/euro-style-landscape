.area .lead{font-family:var(--font-barlow-condensed);font-weight:700;font-size:24px;line-height:1.1;text-transform:uppercase;color:#1F3A2B;margin-top:10px;display:flex;align-items:flex-start;gap:8px}
.area .lead svg{flex:none;margin-top:1px}
