.hero-grid > *{min-width:0}
.hero-grid{position:relative;z-index:2;display:grid;grid-template-columns:minmax(0,1fr);gap:22px;padding:34px 0 40px}
.badge{align-self:flex-start;display:inline-flex;align-items:center;gap:8px;padding:6px 14px;border-radius:999px;background:#D4892A;color:#16291F;font-family:var(--font-barlow-condensed);font-weight:700;letter-spacing:.12em;text-transform:uppercase;font-size:15px}
.hero h1{font-family:var(--font-barlow-condensed);font-weight:800;text-transform:uppercase;font-size:64px;line-height:.88;margin-top:14px;text-shadow:0 2px 18px rgba(0,0,0,.3)}
