.why{background:#16291F;color:#F4EFE4;padding:50px 0 58px}
.why-inner{display:flex;flex-direction:column;gap:30px}
.why img{display:block;width:100%;height:auto;aspect-ratio:4/3;object-fit:cover;border-radius:16px;box-shadow:0 0 0 3px #C9A46A}
.why h2{font-family:var(--font-barlow-condensed);font-weight:800;text-transform:uppercase;font-size:42px;line-height:.95;margin-top:12px}
