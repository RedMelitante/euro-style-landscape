.ba-inner{display:flex;flex-direction:column;gap:22px;position:relative;z-index:2}
.ba-frame{border-radius:16px;overflow:hidden;box-shadow:0 0 0 3px #C9A46A}
/* included */
.inc{padding:56px 0 60px}
.inc ul{list-style:none;margin:26px 0 0;padding:0;display:grid;grid-template-columns:1fr;gap:12px}
.inc li{display:flex;align-items:center;gap:16px;background:#FFFDF8;border:1px solid #E5DCC8;border-radius:14px;padding:16px}
.gc{flex:none;width:54px;height:54px;border-radius:999px;background:#C9A46A;display:flex;align-items:center;justify-content:center;box-shadow:0 0 0 3px #F4EFE4,0 0 0 5px #C9A46A}
.inc b{display:block;font-weight:800;font-size:23px;line-height:1;color:#1F3A2B}
