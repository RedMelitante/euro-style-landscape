.sticky{position:sticky;bottom:0;z-index:30;display:flex;gap:10px;padding:10px 12px calc(12px + env(safe-area-inset-bottom));background:#16291F;border-top:1px solid rgba(201,164,106,.45);box-shadow:0 -10px 30px rgba(0,0,0,.25)}
