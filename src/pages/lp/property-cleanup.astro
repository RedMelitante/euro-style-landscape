.ba-frame{border-radius:16px;overflow:hidden;box-shadow:0 0 0 3px #C9A46A}
.ph-box{margin-top:22px;border:2px dashed #D4892A;border-radius:12px;padding:12px 14px;background:rgba(212,137,42,.12);font-size:14.5px;line-height:1.5;color:#F2D9B8}
