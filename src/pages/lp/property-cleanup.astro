---
// Ad campaign page, from design/lp-property-cleanup-awareness.dc.html (see CAMPAIGN-PAGES-UPDATE.md).
import { Font, Image } from 'astro:assets';
import CampaignLayout from '../../layouts/CampaignLayout.astro';
import { photo } from '../../lib/images';
import logo from '../../assets/logo/euro-style-landscape-logo.jpg';
import NewClientOffer from '../../components/campaign/offer/NewClientOffer.astro';
import OfferPill from '../../components/campaign/offer/OfferPill.astro';
import { NEW_CLIENT_OFFER_ON as offer } from '../../lib/campaigns';

---
<CampaignLayout title="Fall Property Cleanup · Euro Style Landscape" viewContent="gallery" trackPage="property_cleanup">
  <Fragment slot="head">
    <Font cssVariable="--font-barlow-condensed" />
    <Font cssVariable="--font-barlow" preload={[{ weight: 400 }]} />
    <Font cssVariable="--font-great-vibes" />
  </Fragment>
<div style="background:#F4EFE4">

  
  <section class="hero" aria-label="Euro Style Landscape">
    <Image src={photo('front-lawn-tree.jpg')} alt="A well-kept front yard with a mature tree, fresh mulch beds and trimmed shrubs" widths={[480, 800, 1200, 1440]} sizes="100vw" format="webp" quality={45} decoding="async" loading="eager" fetchpriority="high" class="hero-img" />
    <div class="hero-shade"></div>
    <header class="top">
      <div class="wrap">
        <a href="/" aria-label="Euro Style Landscape home"><Image src={logo} alt="Euro Style Landscape" width={118} height={118} densities={[1, 2]} loading="eager" class="es-logo top-logo" /></a>
        <div class="top-actions">
          <a href="tel:+17328039646" class="top-phone" data-track-location="header" aria-label="Call (732) 803-9646"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#C9A46A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"></path></svg><span class="num">(732) 803-9646</span></a>
          <a href="/lp/property-cleanup-quote" class="top-quote btn-gold" data-track="quote_click" data-track-location="header" style="display:inline-flex;align-items:center;justify-content:center;gap:10px;height:56px;padding:0 28px;border-radius:999px;background:#C9A46A;color:#1F3A2B;text-decoration:none;font-family:var(--font-barlow-condensed);font-weight:700;font-size:21px;letter-spacing:.04em;text-transform:uppercase">{offer ? 'Claim 20% Off' : 'Get a Free Quote'}</a>
        </div>
      </div>
    </header>
    <div class="wrap" style="position:relative;width:100%">
      <div class="hero-copy">
        <OfferPill />
        <h1>Property<span class="gold">Cleanups</span><span class="script script-line">Done right, all season.</span></h1>
        <div class="rule"></div>
        <p class="sub">Leaves, debris, beds and lawn cleaned up and ready for winter by one local team in Middlesex County.{offer && ' New clients get 20% off their first property cleanup.'}</p>
        <div class="hero-btns">
          <a href={offer ? '#offer' : '#services'} class="btn-gold" style="display:inline-flex;align-items:center;justify-content:center;gap:10px;height:56px;padding:0 28px;border-radius:999px;background:#C9A46A;color:#1F3A2B;text-decoration:none;font-family:var(--font-barlow-condensed);font-weight:700;font-size:21px;letter-spacing:.04em;text-transform:uppercase">{offer ? 'See the Offer' : "See What's Included"} <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"></path></svg></a>
          <a href="#story" class="btn-out" style="display:inline-flex;align-items:center;justify-content:center;gap:10px;height:56px;padding:0 26px;border-radius:999px;border:2px solid rgba(244,239,228,.85);color:#F4EFE4;text-decoration:none;font-family:var(--font-barlow-condensed);font-weight:700;font-size:21px;letter-spacing:.04em;text-transform:uppercase">Meet the Team</a>
        </div>
      </div>
    </div>
  </section>
  <div aria-hidden="true" style="background:#16291F;line-height:0"><svg viewBox="0 0 1440 80" preserveAspectRatio="none" style="display:block;width:100%;height:clamp(36px,5vw,72px)"><path d="M0 46 C 240 86, 520 6, 820 30 S 1260 62, 1440 22 V80 H0Z" fill="#F4EFE4"></path><path d="M0 46 C 240 86, 520 6, 820 30 S 1260 62, 1440 22" fill="none" stroke="#C9A46A" stroke-width="3"></path></svg></div>

  
  <section class="strip" aria-label="Why Euro Style">
    <div class="wrap">
      <ul>
        <li><span class="ic-circle sm"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#C9A46A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"></path></svg></span><span class="cond">One local team</span></li>
        <li><span class="ic-circle sm"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#C9A46A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><path d="m9 12 2 2 4-4"></path></svg></span><span class="cond">Licensed &amp; insured</span></li>
        <li><span class="ic-circle sm"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#C9A46A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"></path><circle cx="12" cy="10" r="3"></circle></svg></span><span class="cond">Based in Sayreville, NJ</span></li>
      </ul>
    </div>
  </section>

  <NewClientOffer
    service="property cleanup"
    chips={['Leaf & debris removal', 'Bed cleanup & weeding', 'Shrub & hedge trimming', 'Mulch & bed edging', 'Lawn mowing & blowing', 'Leaf bagging & removal']}
    label="Claim 20% Off"
    href="/lp/property-cleanup-quote"
    track="quote_click"
    terms="*New clients only. Valid on your first property cleanup."
    btnStyle="display:inline-flex;align-items:center;justify-content:center;gap:10px;height:56px;padding:0 28px;border-radius:999px;background:#C9A46A;color:#1F3A2B;text-decoration:none;font-family:var(--font-barlow-condensed);font-weight:700;font-size:21px;letter-spacing:.04em;text-transform:uppercase"
  />

  
  <section class="svc" id="services">
    <div class="wrap">
      <p class="eyebrow" style="color:#1F3A2B">What&#39;s included</p>
      <h2>Cleanup <span style="color:#B8925A">includes</span></h2>
      <div class="svc-grid">
          <article class="svc-card">
            <span class="ic-circle"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#C9A46A" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2v13"></path><path d="M6 15h12"></path><path d="M6 15v5M9 15v5M12 15v5M15 15v5M18 15v5"></path></svg></span>
            <h3 class="cond">Leaf &amp; Debris Removal</h3>
            <p>Leaves, sticks and yard waste cleared away.</p>
          </article>
          <article class="svc-card">
            <span class="ic-circle"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#C9A46A" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 20h10"></path><path d="M12 20v-8"></path><path d="M12 12c0-3.5 2.5-6 6-6 0 3.5-2.5 6-6 6z"></path><path d="M12 14c0-3-2-5-5-5 0 3 2 5 5 5z"></path></svg></span>
            <h3 class="cond">Bed Cleanup &amp; Weeding</h3>
            <p>Beds cut back, weeded and refreshed.</p>
          </article>
          <article class="svc-card">
            <span class="ic-circle"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#C9A46A" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="6" cy="6" r="3"></circle><circle cx="6" cy="18" r="3"></circle><path d="M20 4 8.1 15.9M14.5 14.5 20 20M8.1 8.1 12 12"></path></svg></span>
            <h3 class="cond">Shrub &amp; Hedge Trimming</h3>
            <p>Neat, shaped shrubs that look cared for.</p>
          </article>
          <article class="svc-card">
            <span class="ic-circle"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#C9A46A" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 20h18"></path><path d="M5 20c0-4 3-7 7-7s7 3 7 7"></path><path d="M12 13V8"></path><path d="M12 8c0-2 1.5-4 4-4 0 2.5-1.5 4-4 4z"></path></svg></span>
            <h3 class="cond">Mulch &amp; Bed Edging</h3>
            <p>Fresh mulch and clean, crisp bed edges.</p>
          </article>
          <article class="svc-card">
            <span class="ic-circle"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#C9A46A" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10a3 3 0 1 0-3-3"></path><path d="M3 12h15a3 3 0 1 1-3 3"></path><path d="M3 16h7"></path></svg></span>
            <h3 class="cond">Lawn Mowing &amp; Blowing</h3>
            <p>A neat cut, with walks and driveway blown clean.</p>
          </article>
          <article class="svc-card">
            <span class="ic-circle"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#C9A46A" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8h12l-1 13H7z"></path><path d="M9 8V6a3 3 0 0 1 6 0v2"></path><path d="M10 13l1.5 1.5L14 12"></path></svg></span>
            <h3 class="cond">Leaf Bagging &amp; Removal</h3>
            <p>Leaves bagged and taken away.</p>
          </article>
      </div>
      <p class="also">We also design and build patios, walls and outdoor living spaces.</p>
    </div>
  </section>

  
  <section class="season" aria-label="Seasonal care">
    <svg class="leaf " style="left:78%;top:12%;width:54px;height:54px;transform:rotate(18deg)" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12,1 13.6,5.5 16.5,4 16,8 20.5,6.8 19,10.5 23,12 19,13.6 20,17 15.6,15.6 13,18.2 12.6,20 11.4,20 11,18.2 8.4,15.6 4,17 5,13.6 1,12 5,10.5 3.5,6.8 8,8 7.5,4 10.4,5.5" fill="#D4892A"></polygon><path d="M12 19.5V23.5" stroke="#D4892A" stroke-width="1.4" stroke-linecap="round"></path></svg>
    <svg class="leaf d" style="left:88%;top:58%;width:38px;height:38px;transform:rotate(-24deg)" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12,1 13.6,5.5 16.5,4 16,8 20.5,6.8 19,10.5 23,12 19,13.6 20,17 15.6,15.6 13,18.2 12.6,20 11.4,20 11,18.2 8.4,15.6 4,17 5,13.6 1,12 5,10.5 3.5,6.8 8,8 7.5,4 10.4,5.5" fill="#C9A46A"></polygon><path d="M12 19.5V23.5" stroke="#C9A46A" stroke-width="1.4" stroke-linecap="round"></path></svg>
    <svg class="leaf d" style="left:6%;top:76%;width:30px;height:30px;transform:rotate(-38deg)" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12,1 13.6,5.5 16.5,4 16,8 20.5,6.8 19,10.5 23,12 19,13.6 20,17 15.6,15.6 13,18.2 12.6,20 11.4,20 11,18.2 8.4,15.6 4,17 5,13.6 1,12 5,10.5 3.5,6.8 8,8 7.5,4 10.4,5.5" fill="#D4892A"></polygon><path d="M12 19.5V23.5" stroke="#D4892A" stroke-width="1.4" stroke-linecap="round"></path></svg>
    <svg class="leaf d" style="left:60%;top:80%;width:26px;height:26px;transform:rotate(40deg)" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12,1 13.6,5.5 16.5,4 16,8 20.5,6.8 19,10.5 23,12 19,13.6 20,17 15.6,15.6 13,18.2 12.6,20 11.4,20 11,18.2 8.4,15.6 4,17 5,13.6 1,12 5,10.5 3.5,6.8 8,8 7.5,4 10.4,5.5" fill="#C9A46A"></polygon><path d="M12 19.5V23.5" stroke="#C9A46A" stroke-width="1.4" stroke-linecap="round"></path></svg>
    <svg class="leaf " style="left:92%;top:30%;width:22px;height:22px;transform:rotate(70deg)" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12,1 13.6,5.5 16.5,4 16,8 20.5,6.8 19,10.5 23,12 19,13.6 20,17 15.6,15.6 13,18.2 12.6,20 11.4,20 11,18.2 8.4,15.6 4,17 5,13.6 1,12 5,10.5 3.5,6.8 8,8 7.5,4 10.4,5.5" fill="#D4892A"></polygon><path d="M12 19.5V23.5" stroke="#D4892A" stroke-width="1.4" stroke-linecap="round"></path></svg>
    <div class="wrap">
      <p class="eyebrow">Seasonal care</p>
      <h2>Fall cleanup season is here. Get your property <em>ready for winter.</em></h2>
      <ul>
          <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#C9A46A" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>Property cleanups</li>
          <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#C9A46A" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>Aeration + fertilization</li>
          <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#C9A46A" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>Lawn mowing + final cuts</li>
          <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#C9A46A" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>Planting + garden bed refresh</li>
      </ul>
      <a href="/lp/property-cleanup-quote" class="text-link" style="color:#C9A46A" data-track="quote_click" data-track-location="seasonal">Get a free cleanup quote <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"></path></svg></a>
    </div>
  </section>

  
  <section class="work" id="work" style="background:#16291F;padding-top:110px">
    <div class="wrap">
      <div class="work-head">
        <div>
          <p class="eyebrow" style="color:#C9A46A">The result</p>
          <h2>A cleaner yard.<br><span style="color:#C9A46A">A better-looking home.</span></h2>
        </div>
        <p class="lede">Real Euro Style lawn and bed care.</p>
      </div>
      
      <div class="res-grid" data-track-view="gallery">
          <figure class="g-item"><Image src={photo('front-lawn-beds.jpg')} alt="A tidy front lawn with mulched beds, shrubs and an ornamental tree" widths={[480, 800, 1200, 1600]} sizes="(min-width: 1024px) 50vw, 100vw" format="webp" quality={70} decoding="async" loading="lazy" style="aspect-ratio:4 / 3" /><figcaption>Front lawn &amp; beds, cleaned up</figcaption></figure>
          <figure class="g-item"><Image src={photo('front-lawn-tree.jpg')} alt="A well-kept front lawn with a mature tree and fresh mulch beds" widths={[480, 800, 1200, 1600]} sizes="(min-width: 1024px) 50vw, 100vw" format="webp" quality={70} decoding="async" loading="lazy" style="aspect-ratio:4 / 3" /><figcaption>Lawn &amp; tree beds, cared for</figcaption></figure>
      </div>
    </div>
  </section>
  <div aria-hidden="true" style="background:#16291F;line-height:0"><svg viewBox="0 0 1440 80" preserveAspectRatio="none" style="display:block;width:100%;height:clamp(36px,5vw,72px)"><path d="M0 46 C 240 86, 520 6, 820 30 S 1260 62, 1440 22 V80 H0Z" fill="#F4EFE4"></path><path d="M0 46 C 240 86, 520 6, 820 30 S 1260 62, 1440 22" fill="none" stroke="#C9A46A" stroke-width="3"></path></svg></div>

  
  <section class="how">
    <div class="wrap">
      <p class="eyebrow" style="color:#1F3A2B">How it works</p>
      <h2>Simple, from<br><span style="color:#B8925A">first visit to haul-away</span></h2>
      <div class="steps">
          <article class="step np">
            <span class="step-num cond">01</span>
            <h3 class="cond">Free on-site estimate</h3>
            <p>We walk your property and look at what needs cleaning up.</p>
          </article>
          <article class="step np">
            <span class="step-num cond">02</span>
            <h3 class="cond">Detailed written quote</h3>
            <p>You know exactly what the cleanup includes before we start.</p>
          </article>
          <article class="step np">
            <span class="step-num cond">03</span>
            <h3 class="cond">Cleanup &amp; haul-away</h3>
            <p>Our crew cleans up the property and hauls everything away.</p>
          </article>
      </div>
    </div>
  </section>

  
  <section class="story" id="story">
    <div class="wrap">
      <figure class="story-photo" style="margin-top:0;margin-left:0">
        <Image src={photo('team.jpg')} alt="The Euro Style Landscape crew standing together on a job site" widths={[480, 800, 1200, 1600]} sizes="(min-width: 1024px) 50vw, 100vw" format="webp" quality={70} decoding="async" loading="lazy" />
        <figcaption>The Euro Style crew</figcaption>
      </figure>
      <div class="story-text">
        <p class="eyebrow" style="color:#1F3A2B">Our story</p>
        <h2><small>Welcome to</small>Euro Style Landscape</h2>
        <p>We're a local crew based in Sayreville. You deal with the same team from the first visit to the final haul-away, and we can keep your property looking its best afterwards.</p>
        <span class="script">The same crew, every visit</span>
      </div>
    </div>
  </section>

  
  <section class="cta">
    <div class="wrap">
      <div class="cta-box">
        <h2>{offer ? 'New clients save 20% on their first cleanup.' : 'Get your property cleaned up before winter.'}</h2>
        <p>Free on-site estimate and a detailed written quote.{offer && ' *New clients only, valid on your first property cleanup.'}</p>
        <a href="/lp/property-cleanup-quote" class="btn-gold" data-track="quote_click" data-track-location="cta_band" style="display:inline-flex;align-items:center;justify-content:center;gap:10px;height:56px;padding:0 28px;border-radius:999px;background:#C9A46A;color:#1F3A2B;text-decoration:none;font-family:var(--font-barlow-condensed);font-weight:700;font-size:21px;letter-spacing:.04em;text-transform:uppercase;margin-top:6px">{offer ? 'Claim 20% Off' : 'Get a Free Quote'} <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"></path></svg></a>
        <a href="tel:+17328039646" class="call" data-track-location="cta_band">Or call (732) 803-9646</a>
      </div>
    </div>
  </section>

  
  <footer class="foot">
    <div class="wrap">
      <div class="foot-grid">
        <div style="display:flex;flex-direction:column;gap:14px">
          <Image src={logo} alt="Euro Style Landscape" width={130} height={130} densities={[1, 2]} loading="eager" class="es-logo foot-logo" />
          <p style="font-size:16px;line-height:1.6;max-width:300px">European-style landscape design, construction and care.</p>
        </div>
        <div>
          <h4>Get in touch</h4>
          <ul>
            <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C9A46A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"></path></svg><a href="tel:+17328039646" data-track-location="footer">(732) 803-9646</a></li>
            <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C9A46A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg><a href="/">eurostylelandscape.com</a></li>
            <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C9A46A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"></path><circle cx="12" cy="10" r="3"></circle></svg><span>Sayreville, NJ · Serving Middlesex County</span></li>
          </ul>
        </div>
        <div>
          <h4>Explore</h4>
          <ul>
            <li><a href="/services">Services</a></li>
            <li><a href="/our-work">Our Work</a></li>
            <li><a href="/contact">Contact</a></li>
          </ul>
        </div>
      </div>
      <p class="foot-services">Construction | Lawn maintenance | Fencing | Planting | And more</p>
      <div class="foot-bottom">
        <span>Copyright © 2026 Euro Style Landscape. All rights reserved</span>
        <span style="display:inline-flex;gap:18px"><a href="/privacy-policy">Privacy policy</a><a href="/terms">Terms</a></span>
      </div>
    </div>
  </footer>

</div>
</CampaignLayout>

<style is:global>
*{box-sizing:border-box}
body{margin:0;background:#F4EFE4;color:#22302A;font-family:var(--font-barlow);-webkit-font-smoothing:antialiased}
img{max-width:100%}
h1,h2,h3,p{margin:0;text-wrap:pretty}
a{color:inherit}
.cond{font-family:var(--font-barlow-condensed);text-transform:uppercase}
.script{font-family:var(--font-great-vibes);text-transform:none;font-weight:400}
.wrap{max-width:1240px;margin:0 auto;padding:0 20px}
.eyebrow{display:flex;align-items:center;gap:12px;font-family:var(--font-barlow-condensed);font-weight:700;font-size:16px;letter-spacing:.2em;text-transform:uppercase}
.eyebrow::before{content:"";width:32px;height:2px;background:#C9A46A}
.ic-circle{flex:none;width:60px;height:60px;border-radius:999px;background:#1F3A2B;display:flex;align-items:center;justify-content:center;box-shadow:inset 0 0 0 2px rgba(201,164,106,.55)}
.ic-circle.sm{width:48px;height:48px}
.text-link{display:inline-flex;align-items:center;gap:6px;font-weight:700;font-size:16px;text-decoration:none;color:#1F3A2B;border-bottom:2px solid #C9A46A;padding-bottom:2px}
.text-link:hover{color:#2F6844}
.btn-gold:hover{background:#B8925A !important}
.btn-out:hover{background:rgba(244,239,228,.1) !important}
/* header */
.top{position:absolute;top:0;left:0;right:0;z-index:5}
.top .wrap{display:flex;align-items:flex-start;justify-content:space-between;padding-top:14px}
.top-logo{display:block;width:84px;height:84px;filter:drop-shadow(0 4px 14px rgba(0,0,0,.35))}
.top-actions{display:flex;align-items:center;gap:12px;padding-top:16px}
.top-phone{width:48px;height:48px;border-radius:999px;border:1.5px solid rgba(244,239,228,.7);display:flex;align-items:center;justify-content:center;color:#F4EFE4;text-decoration:none;background:rgba(22,41,31,.35)}
.top-phone .num{display:none}
.top-quote{display:none !important}
.leaf.d{display:none}
/* hero */
.hero{position:relative;min-height:720px;display:flex;align-items:flex-end;background:#16291F;overflow:hidden}
.hero-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:58% 50%}
.hero-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(22,41,31,.78) 0%,rgba(22,41,31,.18) 26%,rgba(22,41,31,.35) 46%,rgba(22,41,31,.92) 72%,#16291F 100%)}
.hero-copy{position:relative;padding:150px 0 28px;color:#F4EFE4}
.hero h1{font-family:var(--font-barlow-condensed);font-weight:800;text-transform:uppercase;font-size:58px;line-height:.9;letter-spacing:.005em;text-shadow:0 2px 18px rgba(0,0,0,.35)}
.hero h1 .gold{color:#C9A46A;display:block}
.hero .script-line{display:block;font-size:52px;line-height:1;margin:2px 0 0 4px;transform:rotate(-4deg);transform-origin:left center;color:#F4EFE4}
.hero .rule{width:72px;height:3px;background:#C9A46A;margin:22px 0 18px}
.hero .sub{font-size:18px;line-height:1.55;color:rgba(244,239,228,.9);max-width:520px}
.hero-btns{display:flex;flex-direction:column;gap:12px;margin-top:26px}
/* strip */
.strip{background:#F4EFE4;padding:8px 0 36px}
.strip ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column}
.strip li{display:flex;align-items:center;gap:16px;padding:16px 0;border-bottom:1px solid rgba(201,164,106,.55)}
.strip li:last-child{border-bottom:0}
.strip li .cond{font-weight:700;font-size:22px;color:#1F3A2B;letter-spacing:.02em}
/* story */
.story{padding:28px 0 72px}
.story .wrap{display:flex;flex-direction:column;gap:40px}
.story-photo{position:relative;margin:0 12px 12px 0}
.story-photo::after{content:"";position:absolute;inset:14px -12px -12px 14px;border:2px solid #C9A46A;border-radius:18px;z-index:0}
.story-photo img{position:relative;z-index:1;display:block;width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:18px}
.story-photo figcaption{position:absolute;z-index:2;left:14px;bottom:14px;padding:6px 12px;border-radius:999px;background:#1F3A2B;color:#F4EFE4;font-size:14px;font-weight:600}
