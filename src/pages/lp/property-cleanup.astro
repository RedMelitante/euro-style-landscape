.res-grid{display:grid;grid-template-columns:1fr;gap:14px;margin-top:22px}
.res-grid .g-item{margin:0}
.svc .also{margin-top:22px;font-size:15.5px;color:#5A655D;padding-left:12px;border-left:3px solid #C9A46A}
.step.np{background:#FFFDF8;border:1px solid #E5DCC8;border-radius:16px;padding:22px}
.step.np .step-num{position:static;box-shadow:none}
.step.np h3{margin-top:16px}
.work-more{margin-top:34px;display:flex}
/* services */
.svc{padding:64px 0 76px}
.svc h2{color:#1F3A2B}
.svc-grid{display:grid;grid-template-columns:1fr;gap:16px;margin-top:30px}
.svc-card{background:#FFFDF8;border:1px solid #E5DCC8;border-top:4px solid #C9A46A;border-radius:14px;padding:24px 22px;display:flex;flex-direction:column;gap:12px}
