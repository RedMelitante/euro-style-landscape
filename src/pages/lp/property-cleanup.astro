.season .text-link{color:#C9A46A;margin-top:26px}
.leaf{position:absolute;z-index:1;opacity:.95}
/* how */
.how{padding:100px 0 64px}
.how h2{color:#1F3A2B}
.steps{display:grid;grid-template-columns:1fr;gap:34px;margin-top:32px;counter-reset:s}
.step h3{font-weight:800;font-size:28px;line-height:1;color:#1F3A2B;margin-top:22px}
.step p{font-size:17px;line-height:1.6;color:#4A554D;margin-top:8px}
.step-photo{position:relative}
.step-photo img{display:block;width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:14px}
.step-num{position:absolute;left:16px;bottom:-20px;width:58px;height:58px;border-radius:999px;background:#C9A46A;color:#1F3A2B;font-weight:800;font-size:26px;display:flex;align-items:center;justify-content:center;box-shadow:0 0 0 5px #F4EFE4}
/* cta */
.cta{padding:8px 0 76px}
.cta-box{border-top:2px solid #C9A46A;border-bottom:2px solid #C9A46A;padding:44px 4px;text-align:center;display:flex;flex-direction:column;align-items:center;gap:16px;position:relative}
.cta-box::before,.cta-box::after{content:"";position:absolute;left:0;right:0;height:1px;background:#C9A46A}
.cta-box::before{top:5px}.cta-box::after{bottom:5px}
.cta h2{font-family:var(--font-barlow-condensed);font-weight:800;text-transform:uppercase;font-size:42px;line-height:.98;color:#1F3A2B;max-width:640px}
.cta p{font-size:17px;color:#4A554D}
.cta .call{font-size:17px;font-weight:600;color:#1F3A2B;text-decoration:none;border-bottom:2px solid #C9A46A}
/* footer */
.foot{background:#16291F;color:#BDC7BC;padding:52px 0 0}
.foot-grid{display:grid;grid-template-columns:1fr;gap:30px}
.foot-logo{display:block;width:130px;height:130px}
