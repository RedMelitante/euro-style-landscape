.foot ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:10px;font-size:16px}
.foot li{display:flex;align-items:center;gap:10px}
.foot a{color:#E9E3D6;text-decoration:none}.foot a:hover{color:#C9A46A}
.foot-services{margin-top:40px;border-top:1px solid rgba(201,164,106,.3);padding:16px 0;text-align:center;font-family:var(--font-barlow-condensed);font-weight:600;font-size:14px;letter-spacing:.24em;text-transform:uppercase;color:#9FAA9E}
.foot-bottom{border-top:1px solid rgba(244,239,228,.08);padding:16px 0 26px;display:flex;flex-wrap:wrap;justify-content:space-between;gap:8px 24px;font-size:14px}
