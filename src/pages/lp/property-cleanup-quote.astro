---
// Ad campaign page, from design/lp-property-cleanup-leads.dc.html (see CAMPAIGN-PAGES-UPDATE.md).
import { Font, Image } from 'astro:assets';
import CampaignLayout from '../../layouts/CampaignLayout.astro';
import TimelineField from '../../components/campaign/TimelineField.astro';
import SmsConsent from '../../components/SmsConsent.astro';
import CampaignFormScript from '../../components/campaign/CampaignFormScript.astro';
import { photo } from '../../lib/images';
import logo from '../../assets/logo/euro-style-landscape-logo.jpg';
import NewClientOffer from '../../components/campaign/offer/NewClientOffer.astro';
import { NEW_CLIENT_OFFER_ON as offer, NEW_CLIENT_OFFER_CODE } from '../../lib/campaigns';

---
<CampaignLayout title="Free Fall Cleanup Estimate · Euro Style Landscape">
  <Fragment slot="head">
    <Font cssVariable="--font-barlow-condensed" />
    <Font cssVariable="--font-barlow" preload={[{ weight: 400 }]} />
    <Font cssVariable="--font-great-vibes" />
  </Fragment>
<div style="background:#F4EFE4">

  
  <header class="topbar">
    <div class="wrap">
      <Image src={logo} alt="Euro Style Landscape" width={74} height={74} densities={[1, 2]} loading="eager" class="es-logo" />
      <a href="tel:+17328039646" class="call-pill" data-track-location="top_bar"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"></path></svg><span>Call (732) 803-9646</span></a>
    </div>
  </header>

  
  <section class="hero">
    <div class="hero-photo"><Image src={photo('front-lawn-tree.jpg')} alt="A well-kept front yard with a mature tree, fresh mulch beds and trimmed shrubs" widths={[480, 800, 1200, 1440]} sizes="100vw" format="webp" quality={45} decoding="async" loading="eager" fetchpriority="high" /></div>
    <svg class="leaf " style="left:84%;top:6%;width:30px;height:30px;--r:20deg;animation-delay:0s" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12,1 13.6,5.5 16.5,4 16,8 20.5,6.8 19,10.5 23,12 19,13.6 20,17 15.6,15.6 13,18.2 12.6,20 11.4,20 11,18.2 8.4,15.6 4,17 5,13.6 1,12 5,10.5 3.5,6.8 8,8 7.5,4 10.4,5.5" fill="#D4892A"></polygon><path d="M12 19.5V23.5" stroke="#D4892A" stroke-width="1.4" stroke-linecap="round"></path></svg>
    <svg class="leaf d" style="left:48%;top:70%;width:26px;height:26px;--r:-30deg;animation-delay:2s" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12,1 13.6,5.5 16.5,4 16,8 20.5,6.8 19,10.5 23,12 19,13.6 20,17 15.6,15.6 13,18.2 12.6,20 11.4,20 11,18.2 8.4,15.6 4,17 5,13.6 1,12 5,10.5 3.5,6.8 8,8 7.5,4 10.4,5.5" fill="#C9A46A"></polygon><path d="M12 19.5V23.5" stroke="#C9A46A" stroke-width="1.4" stroke-linecap="round"></path></svg>
    <svg class="leaf d" style="left:4%;top:88%;width:22px;height:22px;--r:50deg;animation-delay:4s" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12,1 13.6,5.5 16.5,4 16,8 20.5,6.8 19,10.5 23,12 19,13.6 20,17 15.6,15.6 13,18.2 12.6,20 11.4,20 11,18.2 8.4,15.6 4,17 5,13.6 1,12 5,10.5 3.5,6.8 8,8 7.5,4 10.4,5.5" fill="#D4892A"></polygon><path d="M12 19.5V23.5" stroke="#D4892A" stroke-width="1.4" stroke-linecap="round"></path></svg>
    <div class="wrap">
      <div class="hero-grid">
        <div class="hero-copy">
          <span class:list={['badge', { 'badge-offer': offer }]}><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12,1 13.6,5.5 16.5,4 16,8 20.5,6.8 19,10.5 23,12 19,13.6 20,17 15.6,15.6 13,18.2 12.6,20 11.4,20 11,18.2 8.4,15.6 4,17 5,13.6 1,12 5,10.5 3.5,6.8 8,8 7.5,4 10.4,5.5" fill="#16291F" stroke="none"></polygon></svg>{offer ? '20% off · New clients' : 'Fall cleanup season'}</span>
          <h1>Property<span class="g">Cleanups</span></h1>
          <span class="script">A cleaner yard. A better-looking home.</span>
          <p class="sub">Fall cleanup season is here. {offer ? 'New clients get 20% off their first property cleanup in Middlesex County.' : 'Book your free on-site consultation in Middlesex County.'}</p>
        </div>
        <div class="form-wrap">
        <div class="form-card" id="quote" data-form-card>
          
          
          <form action="/api/lead" method="post" data-campaign-form style="display:flex;flex-direction:column;gap:14px">
            <div>
              <p class="cond form-title">{offer ? 'Claim 20% off your first cleanup' : 'Get your free quote'}</p>
              <p class="form-sub">{offer && 'New clients only. '}Takes under a minute.</p>
            </div>
            <input type="hidden" name="source" value="fb-fall-cleanup-landing">
            <input type="hidden" name="offer" value={offer ? NEW_CLIENT_OFFER_CODE : 'none'}>
            <input type="hidden" name="form_id" value="fb-fall-cleanup-landing">
            <div class="hp" aria-hidden="true"><label>Leave empty<input type="text" name="website" tabindex="-1" autocomplete="off"></label></div>
            <label class="fld"><span>Full name</span><input class="qf" name="name" type="text" autocomplete="name" required></label>
            <label class="fld"><span>Email</span><input class="qf" name="email" type="email" autocomplete="email" maxlength="200" required></label>
            <div class="row2">
              <label class="fld"><span>Phone</span><input class="qf" name="phone" type="tel" inputmode="tel" autocomplete="tel" required></label>
              <label class="fld"><span>ZIP code</span><input class="qf" name="zip" type="text" inputmode="numeric" pattern="[0-9]{5}" maxlength="5" autocomplete="postal-code" required></label>
            </div>
            <label class="fld"><span>Service needed</span>
              <select class="qf" name="service" required>
                <option value="">Choose a service</option>
                <option selected>Fall property cleanup</option>
                <option>Lawn mowing &amp; maintenance</option>
                <option>Aeration &amp; fertilization</option>
                <option>Planting &amp; bed refresh</option>
                <option>Other</option>
              </select>
            </label>
            <TimelineField />
            <label class="fld"><span>Tell us about your yard <em>(optional)</em></span><textarea class="qf" name="message" rows="3"></textarea></label>
            <SmsConsent id="lp-pc" />
            <button type="submit" class="submit cond"><span data-label>{offer ? 'Claim my 20% off' : 'Book my free consultation'}</span> <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"></path></svg></button>
            <p class="form-error" role="alert" data-form-error hidden>Sorry, your request didn't go through. Please try again or call us on (732) 803-9646.</p>
            <p class="fine">Free and no obligation. We'll call you to book a time to visit.{offer && <><br>*20% off applies to your first property cleanup. New clients only.</>}</p>
          </form>
          
          
            <div role="status" class="success" tabindex="-1" data-success hidden>
              <span class="ok"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#1F3A2B" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span>
              <p class="cond form-title">Thanks!</p>
              <p>We'll call you shortly to book your visit.</p>
              <a href="tel:+17328039646" class="call-pill" data-track-location="form_success"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"></path></svg><span>Call (732) 803-9646</span></a>
              <button type="button" class="edit" data-reset>Edit my details</button>
            </div>
          
        </div>
        </div>
        <ul class="hero-checks">
          {offer && <li><span class="ck"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#C9A46A" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span>20% off your first cleanup*</li>}
          <li><span class="ck"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#C9A46A" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span>Free on-site consultation</li>
          <li><span class="ck"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#C9A46A" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span>Detailed written quote</li>
          <li><span class="ck"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#C9A46A" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span>Licensed &amp; insured</li>
        </ul>
      </div>
    </div>
  </section>
  <div aria-hidden="true" style="background:#1F3A2B;line-height:0;margin-top:-1px"><svg viewBox="0 0 1440 48" preserveAspectRatio="none" style="display:block;width:100%;height:26px"><path d="M0,24 L0,21 L36,31 L58,25 L95,29 L133,32 L153,33 L171,29 L197,31 L222,20 L262,29 L297,31 L330,26 L368,18 L393,34 L415,30 L445,14 L484,16 L507,32 L526,23 L568,14 L612,22 L645,33 L686,26 L726,27 L756,32 L788,18 L834,25 L855,15 L877,29 L901,22 L940,27 L982,34 L1027,23 L1058,30 L1102,26 L1138,25 L1173,32 L1204,32 L1229,24 L1268,14 L1313,22 L1350,19 L1390,24 L1425,32 L1440,24 L1440,48 L0,48 Z" fill="#16291F"></path></svg></div>

  
  <section class="ba">
    <svg class="leaf d" style="left:90%;top:10%;width:28px;height:28px;--r:-20deg;animation-delay:1s" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12,1 13.6,5.5 16.5,4 16,8 20.5,6.8 19,10.5 23,12 19,13.6 20,17 15.6,15.6 13,18.2 12.6,20 11.4,20 11,18.2 8.4,15.6 4,17 5,13.6 1,12 5,10.5 3.5,6.8 8,8 7.5,4 10.4,5.5" fill="#D4892A"></polygon><path d="M12 19.5V23.5" stroke="#D4892A" stroke-width="1.4" stroke-linecap="round"></path></svg>
    <div class="wrap">
      <div class="ba-inner">
        <div class="ba-text">
          <span class="script">A cleaner yard.</span>
          <h2>Real Euro Style lawn &amp; bed care</h2>
          <p>Leaves and debris cleared, beds cleaned up and the lawn cut, so the property looks cared for.</p>
        </div>
        <div class="res-duo">
          <figure><Image src={photo('front-lawn-beds.jpg')} alt="A tidy front lawn with mulched beds, shrubs and an ornamental tree" widths={[480, 800, 1200, 1600]} sizes="(min-width: 1024px) 50vw, 100vw" format="webp" quality={70} decoding="async" loading="lazy" /><figcaption>Beds cleaned up</figcaption></figure>
          <figure><Image src={photo('front-lawn-tree.jpg')} alt="A well-kept front lawn with a mature tree and fresh mulch beds" widths={[480, 800, 1200, 1600]} sizes="(min-width: 1024px) 50vw, 100vw" format="webp" quality={70} decoding="async" loading="lazy" /><figcaption>Lawn cared for</figcaption></figure>
        </div>
      </div>
    </div>
  </section>
  <div aria-hidden="true" style="background:#16291F;line-height:0;margin-top:-1px"><svg viewBox="0 0 1440 48" preserveAspectRatio="none" style="display:block;width:100%;height:26px"><path d="M0,24 L0,28 L45,31 L90,28 L122,30 L167,32 L191,19 L234,30 L267,34 L304,19 L325,28 L352,18 L372,31 L415,34 L434,33 L464,28 L502,33 L540,19 L577,14 L621,30 L641,15 L660,20 L706,21 L743,14 L785,28 L813,28 L849,20 L883,21 L921,23 L954,14 L993,16 L1025,34 L1051,27 L1086,16 L1126,22 L1154,21 L1188,23 L1206,16 L1242,17 L1272,17 L1317,23 L1347,16 L1365,14 L1389,20 L1408,29 L1438,26 L1440,24 L1440,48 L0,48 Z" fill="#F4EFE4"></path></svg></div>

  <NewClientOffer
    service="property cleanup"
    chips={['Leaf & debris removal', 'Bed cleanup & weeding', 'Shrub & hedge trimming', 'Mulch & bed edging', 'Lawn mowing & blowing', 'Leaf bagging & removal']}
    label="Claim 20% off"
    href="#quote"
    terms="*New clients only. Valid on your first property cleanup."
  />

  
  <section class="inc">
    <div class="wrap">
      <p class="eyebrow">What's included</p>
      <h2 class="big">Everything your yard<br><span style="color:#B8925A">needs this fall</span></h2>
      <ul>
        <li><span class="gc"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#1F3A2B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2v13"></path><path d="M6 15h12"></path><path d="M6 15v5M9 15v5M12 15v5M15 15v5M18 15v5"></path></svg></span><span><b class="cond">Leaf &amp; debris removal</b><span>Leaves, sticks and yard waste cleared away.</span></span></li>
        <li><span class="gc"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#1F3A2B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="3"></circle><path d="M12 11v10M12 16c-2.5 0-4.5-1.5-5-4M12 18c2.5 0 4.5-1.5 5-4"></path></svg></span><span><b class="cond">Bed cleanup &amp; weeding</b><span>Beds cut back, weeded and refreshed.</span></span></li>
        <li><span class="gc"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#1F3A2B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="6" cy="6" r="3"></circle><circle cx="6" cy="18" r="3"></circle><path d="M20 4 8.1 15.9M14.5 14.5 20 20M8.1 8.1 12 12"></path></svg></span><span><b class="cond">Shrub &amp; hedge trimming</b><span>Neat, shaped shrubs that look cared for.</span></span></li>
        <li><span class="gc"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#1F3A2B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 20h18"></path><path d="M5 20c0-4 3-7 7-7s7 3 7 7"></path><path d="M12 13V8"></path><path d="M12 8c0-2 1.5-4 4-4 0 2.5-1.5 4-4 4z"></path></svg></span><span><b class="cond">Mulch &amp; bed edging</b><span>Fresh mulch and clean, crisp bed edges.</span></span></li>
        <li><span class="gc"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#1F3A2B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10a3 3 0 1 0-3-3"></path><path d="M3 12h15a3 3 0 1 1-3 3"></path><path d="M3 16h7"></path></svg></span><span><b class="cond">Lawn mowing &amp; blowing</b><span>A neat cut, with walks and driveway blown clean.</span></span></li>
        <li><span class="gc"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#1F3A2B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><path d="m9 12 2 2 4-4"></path></svg></span><span><b class="cond">Licensed &amp; insured</b><span>Peace of mind on every job.</span></span></li>
      </ul>
      <div class="inc-cta"><a href="#quote" class="btn-gold">{offer ? 'Claim 20% off' : 'Get my free quote'} <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"></path></svg></a></div>
    </div>
  </section>

  
  <section class="why">
    <div class="wrap">
      <div class="why-inner">
        <Image src={photo('team.jpg')} alt="The Euro Style Landscape crew standing together on a job site" widths={[480, 800, 1200, 1600]} sizes="(min-width: 1024px) 50vw, 100vw" format="webp" quality={70} decoding="async" loading="lazy" />
        <div>
          <p class="eyebrow">Why Euro Style</p>
          <h2>A local crew<br><span>you deal with directly</span></h2>
          <ul>
          <li><span class="ck"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#C9A46A" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span>One local team</li>
          <li><span class="ck"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#C9A46A" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span>Free on-site consultation</li>
          <li><span class="ck"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#C9A46A" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span>Detailed written quotes</li>
          <li><span class="ck"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#C9A46A" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span>Ongoing maintenance available</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  
  <section class="how">
    <div class="wrap">
      <p class="eyebrow">How it works</p>
      <h2 class="big">Three simple steps</h2>
      <ol class="steps">
        <li class="step"><span class="num cond">01</span><h3 class="cond">We visit and walk your property</h3><p>We come out, walk the yard with you and look at what needs doing.</p></li>
        <li class="step"><span class="num cond">02</span><h3 class="cond">You get a written quote</h3><p>A detailed written quote, so you know exactly what you are getting.</p></li>
        <li class="step"><span class="num cond">03</span><h3 class="cond">Our crew gets it done and cleans up</h3><p>We do the work and leave your property clean.</p></li>
      </ol>
    </div>
  </section>


  
  <section class="area">
    <div class="wrap">
      <div class="area-inner">
        <div>
          <p class="eyebrow">Service area</p>
          <p class="lead"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#C9A46A" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"></path><circle cx="12" cy="10" r="3"></circle></svg><span>Based in Sayreville, NJ · Serving Middlesex County</span></p>
          <ul>
          <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#C9A46A" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>Sayreville</li>
          <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#C9A46A" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>South Amboy</li>
          <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#C9A46A" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>Perth Amboy</li>
          <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#C9A46A" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>Old Bridge</li>
          <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#C9A46A" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>East Brunswick</li>
          <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#C9A46A" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>South River</li>
          <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#C9A46A" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>Spotswood</li>
          <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#C9A46A" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>Woodbridge</li>
