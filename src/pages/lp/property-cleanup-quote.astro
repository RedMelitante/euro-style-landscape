<style is:global>
*{box-sizing:border-box}
body{margin:0;background:#F4EFE4;color:#22302A;font-family:var(--font-barlow);-webkit-font-smoothing:antialiased}
h1,h2,h3,p{margin:0;text-wrap:pretty}
.cond{font-family:var(--font-barlow-condensed);text-transform:uppercase}
.script{font-family:var(--font-great-vibes);font-weight:400;text-transform:none}
.wrap{max-width:1240px;margin:0 auto;padding:0 20px}
.eyebrow{display:flex;align-items:center;gap:12px;font-family:var(--font-barlow-condensed);font-weight:700;font-size:16px;letter-spacing:.2em;text-transform:uppercase;color:#1F3A2B}
.eyebrow::before{content:"";width:32px;height:2px;background:#C9A46A}
h2.big{font-family:var(--font-barlow-condensed);font-weight:800;text-transform:uppercase;font-size:42px;line-height:.95;color:#1F3A2B;margin-top:12px}
.ck{flex:none;width:28px;height:28px;border-radius:999px;border:2px solid #C9A46A;display:flex;align-items:center;justify-content:center}
.confirm{display:inline-block;padding:3px 9px;border:1.5px dashed #D4892A;border-radius:6px;color:#A35F12;background:#FFF4E6;font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase}
.leaf{position:absolute;z-index:1;opacity:.9;transform:rotate(var(--r));animation:sway 7s ease-in-out infinite alternate;pointer-events:none}
@keyframes sway{from{transform:translateY(-6px) rotate(var(--r))}to{transform:translateY(14px) rotate(calc(var(--r) + 28deg))}}
@media (prefers-reduced-motion: reduce){.leaf{animation:none}}
.leaf.d{display:none}
/* buttons */
.btn-gold{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:56px;padding:0 28px;border-radius:999px;background:#C9A46A;color:#1F3A2B;text-decoration:none;font-family:var(--font-barlow-condensed);font-weight:700;font-size:21px;letter-spacing:.04em;text-transform:uppercase;border:0;cursor:pointer}
.btn-gold:hover{background:#B8925A}
.btn-line{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:56px;padding:0 26px;border-radius:999px;border:2px solid rgba(244,239,228,.85);color:#F4EFE4;text-decoration:none;font-family:var(--font-barlow-condensed);font-weight:700;font-size:21px;letter-spacing:.04em;text-transform:uppercase}
.btn-line:hover{background:rgba(244,239,228,.1)}
/* top bar */
.topbar{background:#1F3A2B;border-bottom:1px solid rgba(201,164,106,.35)}
.topbar .wrap{height:76px;display:flex;align-items:center;justify-content:space-between;gap:12px}
.topbar img{display:block;width:62px;height:62px}
.call-pill{display:inline-flex;align-items:center;gap:8px;min-height:46px;padding:0 16px;border-radius:999px;border:2px solid #C9A46A;color:#F4EFE4;text-decoration:none;font-weight:700;font-size:16px;white-space:nowrap}
.call-pill svg{color:#C9A46A}
.call-pill:hover{background:rgba(201,164,106,.15)}
/* hero */
.hero{position:relative;background:#1F3A2B;color:#F4EFE4;overflow:hidden}
.hero-photo{position:absolute;left:0;right:0;top:0;height:400px}
.hero-photo img{width:100%;height:100%;object-fit:cover;object-position:center 40%;display:block}
.hero-photo::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(31,58,43,.55) 0%,rgba(31,58,43,.55) 40%,#1F3A2B 100%)}
.hero-grid > *{min-width:0}
.hero-grid{position:relative;z-index:2;display:grid;grid-template-columns:minmax(0,1fr);gap:22px;padding:34px 0 40px}
.badge{align-self:flex-start;display:inline-flex;align-items:center;gap:8px;padding:6px 14px;border-radius:999px;background:#D4892A;color:#16291F;font-family:var(--font-barlow-condensed);font-weight:700;letter-spacing:.12em;text-transform:uppercase;font-size:15px}
.badge.badge-offer{background:#C9A46A;font-weight:800}
.hero h1{font-family:var(--font-barlow-condensed);font-weight:800;text-transform:uppercase;font-size:64px;line-height:.88;margin-top:14px;text-shadow:0 2px 18px rgba(0,0,0,.3)}
.hero h1 .g{display:block;color:#C9A46A}
.hero .script{display:block;font-size:34px;line-height:1.1;color:#F4EFE4;margin-top:10px}
.hero .sub{font-size:17.5px;line-height:1.55;color:rgba(244,239,228,.9);margin-top:14px;max-width:520px}
.hero-checks{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:12px}
.hero-checks li{display:flex;align-items:center;gap:12px;font-family:var(--font-barlow-condensed);font-weight:700;font-size:21px;text-transform:uppercase;letter-spacing:.02em}
/* form */
.form-card{background:#F4EFE4;color:#22302A;border-radius:18px;padding:22px 18px;box-shadow:0 24px 60px rgba(0,0,0,.35);border-top:5px solid #C9A46A;scroll-margin-top:12px}
.form-title{font-weight:800;font-size:32px;line-height:1;color:#1F3A2B}
.form-sub{font-size:15px;color:#5A655D;margin-top:4px}
.fld{display:flex;flex-direction:column;gap:6px;font-size:15px;font-weight:600;color:#1F3A2B}
.fld em{font-weight:400;font-style:normal;color:#6A746C}
.qf{width:100%;min-height:52px;padding:12px 14px;border:1.5px solid #D6CCB6;border-radius:10px;background:#FFFFFF;font:inherit;font-size:16px;font-weight:400;color:#22302A}
textarea.qf{min-height:84px;resize:vertical}
.qf:focus{outline:none;border-color:#1F3A2B;box-shadow:0 0 0 3px rgba(201,164,106,.45)}
.row2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
.submit{display:flex;align-items:center;justify-content:center;gap:10px;min-height:60px;border:0;border-radius:999px;background:#C9A46A;color:#1F3A2B;font-weight:800;font-size:22px;letter-spacing:.04em;cursor:pointer;margin-top:4px}
.submit:hover{background:#B8925A}
.submit:focus-visible,.btn-gold:focus-visible,.call-pill:focus-visible{outline:3px solid #D4892A;outline-offset:3px}
.fine{font-size:14px;line-height:1.5;color:#5A655D;text-align:center}
.success{display:flex;flex-direction:column;align-items:center;text-align:center;gap:12px;padding:30px 4px}
.success .ok{width:68px;height:68px;border-radius:999px;background:#C9A46A;display:flex;align-items:center;justify-content:center}
.success p{font-size:17px;line-height:1.5}
.success .call-pill{color:#1F3A2B;background:#FFFFFF;margin-top:6px}
.success .edit{border:0;background:none;color:#5A655D;text-decoration:underline;font:inherit;font-size:14px;cursor:pointer;min-height:44px}
/* before/after */
.ba{background:#16291F;color:#F4EFE4;padding:46px 0 56px;position:relative;overflow:hidden}
.ba .script{font-size:46px;line-height:1;color:#C9A46A}
.ba h2{font-family:var(--font-barlow-condensed);font-weight:800;text-transform:uppercase;font-size:34px;line-height:1;margin-top:6px}
.ba p{font-size:16.5px;line-height:1.55;color:#BDC7BC;margin-top:10px}
.ba-inner{display:flex;flex-direction:column;gap:22px;position:relative;z-index:2}
.ba-frame{border-radius:16px;overflow:hidden;box-shadow:0 0 0 3px #C9A46A}
.res-duo{display:grid;grid-template-columns:1fr;gap:14px;flex:1}
