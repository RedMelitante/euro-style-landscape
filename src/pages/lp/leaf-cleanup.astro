---
// Ad campaign page, from design/lp-leaf-cleanup-awareness.dc.html (see CAMPAIGN-PAGES-UPDATE.md).
import { Font, Image } from 'astro:assets';
import CampaignLayout from '../../layouts/CampaignLayout.astro';
import NewClientOffer from '../../components/campaign/offer/NewClientOffer.astro';
import OfferPill from '../../components/campaign/offer/OfferPill.astro';
import OfferLine from '../../components/campaign/offer/OfferLine.astro';
import { NEW_CLIENT_OFFER_ON } from '../../lib/campaigns';
import { photo } from '../../lib/images';
import logo from '../../assets/logo/esl-logo-on-dark.png';

import { RATING, REVIEW_COUNT } from '../../lib/reviews';
---
<CampaignLayout title="Fall Leaf Cleanup · Eurostyle Landscape" viewContent="load" trackPage="leaf_cleanup">
  <Fragment slot="head">
    <Font cssVariable="--font-barlow-condensed" />
    <Font cssVariable="--font-barlow" preload={[{ weight: 400 }]} />
    <Font cssVariable="--font-kaushan" />
  </Fragment>
<div style="background:#EFF4E7">

  
  <section class="hero">
    
    <Image src={photo('hero-firepit-patio.jpg')} alt="Autumn trees with orange and brown leaves" widths={[480, 800, 1200, 1440]} sizes="100vw" format="webp" quality={45} decoding="async" loading="eager" fetchpriority="high" class="hero-img" />
    <div class="hero-shade"></div>
    <div class="frame"></div>
    <svg class="leaf " style="left:78%;top:16%;width:30px;height:30px;--r:24deg;animation-delay:0s" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12,1 13.6,5.5 16.5,4 16,8 20.5,6.8 19,10.5 23,12 19,13.6 20,17 15.6,15.6 13,18.2 12.6,20 11.4,20 11,18.2 8.4,15.6 4,17 5,13.6 1,12 5,10.5 3.5,6.8 8,8 7.5,4 10.4,5.5" fill="#E8902A"></polygon><path d="M12 19.5V23.5" stroke="#E8902A" stroke-width="1.4" stroke-linecap="round"></path></svg>
    <svg class="leaf d" style="left:86%;top:44%;width:22px;height:22px;--r:-30deg;animation-delay:3s" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12,1 13.6,5.5 16.5,4 16,8 20.5,6.8 19,10.5 23,12 19,13.6 20,17 15.6,15.6 13,18.2 12.6,20 11.4,20 11,18.2 8.4,15.6 4,17 5,13.6 1,12 5,10.5 3.5,6.8 8,8 7.5,4 10.4,5.5" fill="#B9BB4A"></polygon><path d="M12 19.5V23.5" stroke="#B9BB4A" stroke-width="1.4" stroke-linecap="round"></path></svg>
    <svg class="leaf d" style="left:62%;top:70%;width:26px;height:26px;--r:60deg;animation-delay:5s" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12,1 13.6,5.5 16.5,4 16,8 20.5,6.8 19,10.5 23,12 19,13.6 20,17 15.6,15.6 13,18.2 12.6,20 11.4,20 11,18.2 8.4,15.6 4,17 5,13.6 1,12 5,10.5 3.5,6.8 8,8 7.5,4 10.4,5.5" fill="#E8902A"></polygon><path d="M12 19.5V23.5" stroke="#E8902A" stroke-width="1.4" stroke-linecap="round"></path></svg>
    <div class="wrap hero-in">
      <div class="hero-top">
        <Image src={logo} alt="Eurostyle Landscape" width={96} height={96} densities={[1, 2]} loading="eager" class="es-logo" />
        <a href="tel:+17328039646" class="hero-phone" data-track-location="hero"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"></path></svg><span>(732) 803-9646</span></a>
      </div>
      <div class="hero-copy">
        <OfferPill />
        <p class="eyebrow"><span class="dot"></span>Now booking · Fall 2026 leaf cleanups</p>
        <h1>Fall leaf cleanup<span>done right.</span></h1>
        <p class="sub">Leaves cleared from your lawn, beds and walkways, then collected and hauled away by one local team.</p>
        <div class="hero-btns">
          <a href="#included" class="btn-gold">See what's included <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12l7 7 7-7"></path></svg></a>
          <a href="/lp/leaf-cleanup-quote" class="btn-line" data-track="quote_click" data-track-location="hero">Get a free quote</a>
        </div>
        <p class="hero-rating"><svg class="g-logo" width="18" height="18" viewBox="0 0 48 48" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.1H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.6-.4-3.9z"/><path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.1H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.6-.4-3.9z"/></svg><span class="stars5" role="img" aria-label="5 out of 5 stars"><svg width="15" height="15" viewBox="0 0 24 24" fill="#F4B400" aria-hidden="true"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"></path></svg><svg width="15" height="15" viewBox="0 0 24 24" fill="#F4B400" aria-hidden="true"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"></path></svg><svg width="15" height="15" viewBox="0 0 24 24" fill="#F4B400" aria-hidden="true"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"></path></svg><svg width="15" height="15" viewBox="0 0 24 24" fill="#F4B400" aria-hidden="true"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"></path></svg><svg width="15" height="15" viewBox="0 0 24 24" fill="#F4B400" aria-hidden="true"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"></path></svg></span><span><b>{RATING}</b> from {REVIEW_COUNT} Google reviews</span></p>
      </div>
    </div>
  </section>

  
  <section class="why">
    <div class="wrap">
      <p class="eyebrow" style="color:#0F4A2F"><span class="dot"></span>Why leaf cleanup matters</p>
      <h2 class="big">Leaves now,<br><span class="o">less work later</span></h2>
      <p class="lede">A few reasons homeowners clear the leaves in the fall instead of waiting for spring.</p>
      <div class="why-grid">
        <article class="why-card"><span class="ring" style="width:64px;height:64px;background:#0F4A2F"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#EFF4E7" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg></span><h3 class="cond">Healthier lawn in spring</h3><p>Leaves left on the grass block sunlight and trap moisture, which can leave thin, patchy spots by spring.</p></article>
        <article class="why-card"><span class="ring" style="width:64px;height:64px;background:#0F4A2F"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#EFF4E7" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 20h10"></path><path d="M12 20v-8"></path><path d="M12 12c0-3.5 2.5-6 6-6 0 3.5-2.5 6-6 6z"></path><path d="M12 14c0-3-2-5-5-5 0 3 2 5 5 5z"></path></svg></span><h3 class="cond">Clear beds</h3><p>Leaves left piled in beds mat down over plants. Clearing them out gives your beds a clean start in spring.</p></article>
        <article class="why-card"><span class="ring" style="width:64px;height:64px;background:#0F4A2F"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#EFF4E7" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5"></path><path d="M5 9.5V21h14V9.5"></path><path d="M10 21v-6h4v6"></path></svg></span><h3 class="cond">Curb appeal all winter</h3><p>A leaf-free lawn, walkway and driveway looks cared for right through the holidays.</p></article>
      </div>
    </div>
  </section>

  
  <section class="inc" id="included">
    <div class="frame-in"></div>
    <svg class="leaf " style="left:6%;top:10%;width:26px;height:26px;--r:-20deg;animation-delay:1s" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12,1 13.6,5.5 16.5,4 16,8 20.5,6.8 19,10.5 23,12 19,13.6 20,17 15.6,15.6 13,18.2 12.6,20 11.4,20 11,18.2 8.4,15.6 4,17 5,13.6 1,12 5,10.5 3.5,6.8 8,8 7.5,4 10.4,5.5" fill="#E8902A"></polygon><path d="M12 19.5V23.5" stroke="#E8902A" stroke-width="1.4" stroke-linecap="round"></path></svg>
    <svg class="leaf d" style="left:90%;top:78%;width:24px;height:24px;--r:40deg;animation-delay:4s" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12,1 13.6,5.5 16.5,4 16,8 20.5,6.8 19,10.5 23,12 19,13.6 20,17 15.6,15.6 13,18.2 12.6,20 11.4,20 11,18.2 8.4,15.6 4,17 5,13.6 1,12 5,10.5 3.5,6.8 8,8 7.5,4 10.4,5.5" fill="#B9BB4A"></polygon><path d="M12 19.5V23.5" stroke="#B9BB4A" stroke-width="1.4" stroke-linecap="round"></path></svg>
    <div class="wrap">
      <p class="eyebrow g"><span class="dot"></span>What's included</p>
      <h2 class="big">Your leaf cleanup,<br><span class="g">start to finish</span></h2>
      <ul>
        <li><span class="ring" style="width:72px;height:72px;background:#0B3A25"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#EFF4E7" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2v13"></path><path d="M6 15h12"></path><path d="M6 15v5M9 15v5M12 15v5M15 15v5M18 15v5"></path></svg></span><h3 class="cond">Blowing &amp; raking</h3><p>Leaves blown and raked off the lawn, walkways and driveway.</p></li>
        <li><span class="ring" style="width:72px;height:72px;background:#0B3A25"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#EFF4E7" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 20h10"></path><path d="M12 20v-8"></path><path d="M12 12c0-3.5 2.5-6 6-6 0 3.5-2.5 6-6 6z"></path><path d="M12 14c0-3-2-5-5-5 0 3 2 5 5 5z"></path></svg></span><h3 class="cond">Bed &amp; shrub clean-out</h3><p>Leaves cleared out of beds and from around shrubs.</p></li>
        <li><span class="ring" style="width:72px;height:72px;background:#0B3A25"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#EFF4E7" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 4h14v11H1z"></path><path d="M15 8h4l3 3v4h-7"></path><circle cx="5.5" cy="18" r="2"></circle><circle cx="18.5" cy="18" r="2"></circle></svg></span><h3 class="cond">Collection &amp; haul-away</h3><p>Leaves collected and hauled away.</p></li>
        <li><span class="ring" style="width:72px;height:72px;background:#0B3A25"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#EFF4E7" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21h18"></path><path d="M6 21v-5M9 21v-8M12 21v-6M15 21v-9M18 21v-5"></path></svg></span><h3 class="cond">Final mow</h3><p>A last cut so the lawn goes into winter clean.</p></li>
      </ul>
    </div>
  </section>

  <NewClientOffer
    service="leaf cleanup"
    chips={['Leaf blowing & raking', 'Bed & shrub clean-out', 'Collection & haul-away', 'One-time or seasonal']}
    label="Claim my 20% off"
    href="/lp/leaf-cleanup-quote"
    track="quote_click"
    terms="*Valid on your first leaf cleanup with Eurostyle Landscape. New clients only."
    script="kaushan"
  />

  
  <section class="plans">
    <div class="wrap">
      <p class="eyebrow" style="color:#0F4A2F"><span class="dot"></span>Pick what suits you</p>
      <h2 class="big">One-time or seasonal</h2>
      <div class="plan-grid">
        <article class="plan one">
          <span class="ring" style="width:58px;height:58px;background:#0F4A2F"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#EFF4E7" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 4h14v11H1z"></path><path d="M15 8h4l3 3v4h-7"></path><circle cx="5.5" cy="18" r="2"></circle><circle cx="18.5" cy="18" r="2"></circle></svg></span>
          <h3>One-time cleanup</h3>
          <p>One visit. We clear the leaves from the whole property and haul them away.</p>
        </article>
        <article class="plan season">
          <span class="ring" style="width:58px;height:58px;background:#0B3A25"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#EFF4E7" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 2l4 4-4 4"></path><path d="M3 11V9a3 3 0 0 1 3-3h15"></path><path d="M7 22l-4-4 4-4"></path><path d="M21 13v2a3 3 0 0 1-3 3H3"></path></svg></span>
          <h3>Seasonal service</h3>
          <span class="brush">All Fall Long.</span>
          <p>We come back as the leaves keep falling, so your yard stays clean through the season.</p>
        </article>
      </div>
      <p class="ask">Ask about ongoing maintenance.</p>
    </div>
  </section>

  
  <section class="team">
    <div class="wrap team-in">
      <figure><Image src={photo('team-2.jpg')} alt="The Eurostyle Landscape crew standing together on a job site" widths={[480, 800, 1200, 1600]} sizes="(min-width: 1024px) 50vw, 100vw" format="webp" quality={70} decoding="async" loading="lazy" /></figure>
      <div>
        <p class="eyebrow g"><span class="dot"></span>Meet the team</p>
        <h2 class="big">The crew behind<br><span class="g">your leaf cleanup</span></h2>
        <p class="copy">One local team, based in Sayreville. Licensed &amp; insured, and the same crew from the first visit to the final clean-up.</p>
        <span class="brush">See you this fall.</span>
      </div>
    </div>
  </section>

  
  <section class="beyond">
    <div class="wrap">
      <div class="beyond-head">
        <div>
          <p class="eyebrow" style="color:#0F4A2F"><span class="dot"></span>The result</p>
          <h2 class="big">A clean yard,<br><span style="color:#197148">ready for winter</span></h2>
        </div>
        <p class="lede">No leaves on the lawn, nothing smothering the beds, and clear walkways through the season.</p>
      </div>
      <div class="pgrid res">
          <figure><Image src={photo('autumn-leaves.jpg')} alt="Autumn trees and fallen leaves behind a curved stone seat wall" widths={[480, 800, 1200, 1600]} sizes="(min-width: 1024px) 50vw, 100vw" format="webp" quality={70} decoding="async" loading="lazy" /><figcaption>Fall leaves &amp; a finished patio</figcaption></figure>
          <figure><Image src={photo('leaf-cleanup-blowers.jpg')} alt="Leaf removal in Monroe, NJ" widths={[480, 800, 1200, 1600]} sizes="(min-width: 1024px) 50vw, 100vw" format="webp" quality={70} decoding="async" loading="lazy" /><figcaption>Leaf removal in Monroe, NJ</figcaption></figure>
      </div>
    </div>
  </section>

  <section class="reviews" aria-label="Google reviews">
    <div class="wrap">
      <p class="eyebrow" style="color:#0F4A2F"><span class="dot"></span>Reviews</p>
      <h2 class="big">What our neighbors say</h2>
      <p class="rv-sum"><svg class="g-logo" width="22" height="22" viewBox="0 0 48 48" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.1H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.6-.4-3.9z"/><path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.1H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.6-.4-3.9z"/></svg><svg width="20" height="20" viewBox="0 0 24 24" fill="#F4B400" aria-hidden="true"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"></path></svg><span><b>{RATING}</b> from {REVIEW_COUNT} Google reviews</span></p>
      <div class="rv-grid">
        <figure class="rv-card">
          <span class="stars5" role="img" aria-label="5 out of 5 stars"><svg width="18" height="18" viewBox="0 0 24 24" fill="#F4B400" aria-hidden="true"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"></path></svg><svg width="18" height="18" viewBox="0 0 24 24" fill="#F4B400" aria-hidden="true"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"></path></svg><svg width="18" height="18" viewBox="0 0 24 24" fill="#F4B400" aria-hidden="true"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"></path></svg><svg width="18" height="18" viewBox="0 0 24 24" fill="#F4B400" aria-hidden="true"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"></path></svg><svg width="18" height="18" viewBox="0 0 24 24" fill="#F4B400" aria-hidden="true"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"></path></svg></span>
          <blockquote>&ldquo;They did a great job on my place! The area was getting complaints and it looked like a disaster because our old landscaper wasn&rsquo;t taking care of it and it had gone unnoticed. They took care of it for an great price, and did a very good job&rdquo;</blockquote>
          <figcaption><b>Shuvan H.</b><span>Google review</span></figcaption>
        </figure>
        <figure class="rv-card">
          <span class="stars5" role="img" aria-label="5 out of 5 stars"><svg width="18" height="18" viewBox="0 0 24 24" fill="#F4B400" aria-hidden="true"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"></path></svg><svg width="18" height="18" viewBox="0 0 24 24" fill="#F4B400" aria-hidden="true"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"></path></svg><svg width="18" height="18" viewBox="0 0 24 24" fill="#F4B400" aria-hidden="true"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"></path></svg><svg width="18" height="18" viewBox="0 0 24 24" fill="#F4B400" aria-hidden="true"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"></path></svg><svg width="18" height="18" viewBox="0 0 24 24" fill="#F4B400" aria-hidden="true"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"></path></svg></span>
          <blockquote>&ldquo;Huge shoutout to Sean and his team for an amazing backyard makeover! &hellip; We hired them to clear out our old stone yard, level everything out for a new lawn, build a custom brick patio, clean up some overgrown and dead trees and install a vinyl fence. They absolutely nailed it. &hellip;&rdquo;</blockquote>
          <figcaption><b>Caleb D.</b><span>Google review</span></figcaption>
        </figure>
        <figure class="rv-card">
