---
// Ad campaign page, from design/lp-leaf-cleanup-awareness.dc.html (see CAMPAIGN-PAGES-UPDATE.md).
import { Font, Image } from 'astro:assets';
import CampaignLayout from '../../layouts/CampaignLayout.astro';
import { photo } from '../../lib/images';
import logo from '../../assets/logo/euro-style-landscape-logo.jpg';

---
<CampaignLayout title="Fall Leaf Cleanup · Euro Style Landscape" viewContent="load">
  <Fragment slot="head">
    <Font cssVariable="--font-barlow-condensed" />
    <Font cssVariable="--font-barlow" preload={[{ weight: 400 }]} />
    <Font cssVariable="--font-kaushan" />
  </Fragment>
<div style="background:#F4EFE4">

  
  <section class="hero">
    
    <Image src={photo('hero-firepit-patio.jpg')} alt="Autumn trees with orange and brown leaves" widths={[480, 800, 1200, 1440]} sizes="100vw" format="webp" quality={45} decoding="async" loading="eager" fetchpriority="high" class="hero-img" />
    <div class="hero-shade"></div>
    <div class="frame"></div>
    <svg class="leaf " style="left:78%;top:16%;width:30px;height:30px;--r:24deg;animation-delay:0s" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12,1 13.6,5.5 16.5,4 16,8 20.5,6.8 19,10.5 23,12 19,13.6 20,17 15.6,15.6 13,18.2 12.6,20 11.4,20 11,18.2 8.4,15.6 4,17 5,13.6 1,12 5,10.5 3.5,6.8 8,8 7.5,4 10.4,5.5" fill="#E8902A"></polygon><path d="M12 19.5V23.5" stroke="#E8902A" stroke-width="1.4" stroke-linecap="round"></path></svg>
    <svg class="leaf d" style="left:86%;top:44%;width:22px;height:22px;--r:-30deg;animation-delay:3s" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12,1 13.6,5.5 16.5,4 16,8 20.5,6.8 19,10.5 23,12 19,13.6 20,17 15.6,15.6 13,18.2 12.6,20 11.4,20 11,18.2 8.4,15.6 4,17 5,13.6 1,12 5,10.5 3.5,6.8 8,8 7.5,4 10.4,5.5" fill="#C9A46A"></polygon><path d="M12 19.5V23.5" stroke="#C9A46A" stroke-width="1.4" stroke-linecap="round"></path></svg>
    <svg class="leaf d" style="left:62%;top:70%;width:26px;height:26px;--r:60deg;animation-delay:5s" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12,1 13.6,5.5 16.5,4 16,8 20.5,6.8 19,10.5 23,12 19,13.6 20,17 15.6,15.6 13,18.2 12.6,20 11.4,20 11,18.2 8.4,15.6 4,17 5,13.6 1,12 5,10.5 3.5,6.8 8,8 7.5,4 10.4,5.5" fill="#E8902A"></polygon><path d="M12 19.5V23.5" stroke="#E8902A" stroke-width="1.4" stroke-linecap="round"></path></svg>
    <div class="wrap hero-in">
      <div class="hero-top">
        <Image src={logo} alt="Euro Style Landscape" width={96} height={96} densities={[1, 2]} loading="eager" class="es-logo" />
        <a href="tel:+17328039646" class="hero-phone" data-track-location="hero"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"></path></svg><span>(732) 803-9646</span></a>
      </div>
      <div class="hero-copy">
        <p class="eyebrow"><span class="dot"></span>Now booking · Fall 2026 leaf cleanups</p>
        <h1>Fall leaf cleanup<span>done right.</span></h1>
        <p class="sub">Leaves cleared from your lawn, beds and walkways, then collected and hauled away by one local team.</p>
        <div class="hero-btns">
          <a href="#included" class="btn-gold">See what's included <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12l7 7 7-7"></path></svg></a>
          <a href="/lp/leaf-cleanup-quote" class="btn-line" data-track="quote_click" data-track-location="hero">Get a free quote</a>
        </div>
      </div>
    </div>
  </section>

  
  <section class="why">
    <div class="wrap">
      <p class="eyebrow" style="color:#1F3A2B"><span class="dot"></span>Why leaf cleanup matters</p>
      <h2 class="big">Leaves now,<br><span class="o">less work later</span></h2>
      <p class="lede">A few reasons homeowners clear the leaves in the fall instead of waiting for spring.</p>
      <div class="why-grid">
        <article class="why-card"><span class="ring" style="width:64px;height:64px;background:#1F3A2B"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#F4EFE4" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg></span><h3 class="cond">Healthier lawn in spring</h3><p>Leaves left on the grass block sunlight and trap moisture, which can leave thin, patchy spots by spring.</p></article>
        <article class="why-card"><span class="ring" style="width:64px;height:64px;background:#1F3A2B"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#F4EFE4" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 20h10"></path><path d="M12 20v-8"></path><path d="M12 12c0-3.5 2.5-6 6-6 0 3.5-2.5 6-6 6z"></path><path d="M12 14c0-3-2-5-5-5 0 3 2 5 5 5z"></path></svg></span><h3 class="cond">Clear beds</h3><p>Leaves left piled in beds mat down over plants. Clearing them out gives your beds a clean start in spring.</p></article>
        <article class="why-card"><span class="ring" style="width:64px;height:64px;background:#1F3A2B"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#F4EFE4" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5"></path><path d="M5 9.5V21h14V9.5"></path><path d="M10 21v-6h4v6"></path></svg></span><h3 class="cond">Curb appeal all winter</h3><p>A leaf-free lawn, walkway and driveway looks cared for right through the holidays.</p></article>
      </div>
    </div>
  </section>

  
  <section class="inc" id="included">
    <div class="frame-in"></div>
    <svg class="leaf " style="left:6%;top:10%;width:26px;height:26px;--r:-20deg;animation-delay:1s" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12,1 13.6,5.5 16.5,4 16,8 20.5,6.8 19,10.5 23,12 19,13.6 20,17 15.6,15.6 13,18.2 12.6,20 11.4,20 11,18.2 8.4,15.6 4,17 5,13.6 1,12 5,10.5 3.5,6.8 8,8 7.5,4 10.4,5.5" fill="#E8902A"></polygon><path d="M12 19.5V23.5" stroke="#E8902A" stroke-width="1.4" stroke-linecap="round"></path></svg>
    <svg class="leaf d" style="left:90%;top:78%;width:24px;height:24px;--r:40deg;animation-delay:4s" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12,1 13.6,5.5 16.5,4 16,8 20.5,6.8 19,10.5 23,12 19,13.6 20,17 15.6,15.6 13,18.2 12.6,20 11.4,20 11,18.2 8.4,15.6 4,17 5,13.6 1,12 5,10.5 3.5,6.8 8,8 7.5,4 10.4,5.5" fill="#C9A46A"></polygon><path d="M12 19.5V23.5" stroke="#C9A46A" stroke-width="1.4" stroke-linecap="round"></path></svg>
    <div class="wrap">
      <p class="eyebrow g"><span class="dot"></span>What's included</p>
      <h2 class="big">Your leaf cleanup,<br><span class="g">start to finish</span></h2>
      <ul>
        <li><span class="ring" style="width:72px;height:72px;background:#16291F"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#F4EFE4" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2v13"></path><path d="M6 15h12"></path><path d="M6 15v5M9 15v5M12 15v5M15 15v5M18 15v5"></path></svg></span><h3 class="cond">Blowing &amp; raking</h3><p>Leaves blown and raked off the lawn, walkways and driveway.</p></li>
        <li><span class="ring" style="width:72px;height:72px;background:#16291F"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#F4EFE4" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 20h10"></path><path d="M12 20v-8"></path><path d="M12 12c0-3.5 2.5-6 6-6 0 3.5-2.5 6-6 6z"></path><path d="M12 14c0-3-2-5-5-5 0 3 2 5 5 5z"></path></svg></span><h3 class="cond">Bed &amp; shrub clean-out</h3><p>Leaves cleared out of beds and from around shrubs.</p></li>
        <li><span class="ring" style="width:72px;height:72px;background:#16291F"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#F4EFE4" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 4h14v11H1z"></path><path d="M15 8h4l3 3v4h-7"></path><circle cx="5.5" cy="18" r="2"></circle><circle cx="18.5" cy="18" r="2"></circle></svg></span><h3 class="cond">Collection &amp; haul-away</h3><p>Leaves collected and hauled away.</p></li>
        <li><span class="ring" style="width:72px;height:72px;background:#16291F"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#F4EFE4" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21h18"></path><path d="M6 21v-5M9 21v-8M12 21v-6M15 21v-9M18 21v-5"></path></svg></span><h3 class="cond">Final mow</h3><p>A last cut so the lawn goes into winter clean.</p></li>
      </ul>
    </div>
  </section>

  
  <section class="plans">
    <div class="wrap">
      <p class="eyebrow" style="color:#1F3A2B"><span class="dot"></span>Pick what suits you</p>
      <h2 class="big">One-time or seasonal</h2>
      <div class="plan-grid">
        <article class="plan one">
          <span class="ring" style="width:58px;height:58px;background:#1F3A2B"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#F4EFE4" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 4h14v11H1z"></path><path d="M15 8h4l3 3v4h-7"></path><circle cx="5.5" cy="18" r="2"></circle><circle cx="18.5" cy="18" r="2"></circle></svg></span>
          <h3>One-time cleanup</h3>
          <p>One visit. We clear the leaves from the whole property and haul them away.</p>
        </article>
        <article class="plan season">
          <span class="ring" style="width:58px;height:58px;background:#16291F"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#F4EFE4" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 2l4 4-4 4"></path><path d="M3 11V9a3 3 0 0 1 3-3h15"></path><path d="M7 22l-4-4 4-4"></path><path d="M21 13v2a3 3 0 0 1-3 3H3"></path></svg></span>
          <h3>Seasonal service</h3>
          <span class="brush">All Fall Long.</span>
          <p>We come back as the leaves keep falling, so your yard stays clean through the season.</p>
        </article>
      </div>
      <p class="ask">Ask about ongoing maintenance.</p>
    </div>
  </section>

  
  <section class="team">
    <div class="wrap team-in">
      <figure><Image src={photo('team-2.jpg')} alt="The Euro Style Landscape crew standing together on a job site" widths={[480, 800, 1200, 1600]} sizes="(min-width: 1024px) 50vw, 100vw" format="webp" quality={70} decoding="async" loading="lazy" /></figure>
      <div>
        <p class="eyebrow g"><span class="dot"></span>Meet the team</p>
        <h2 class="big">The crew behind<br><span class="g">your leaf cleanup</span></h2>
        <p class="copy">One local team, based in Sayreville. Licensed &amp; insured, and the same crew from the first visit to the final clean-up.</p>
        <span class="brush">See you this fall.</span>
      </div>
    </div>
  </section>

  
  <section class="beyond">
    <div class="wrap">
      <div class="beyond-head">
        <div>
          <p class="eyebrow" style="color:#1F3A2B"><span class="dot"></span>The result</p>
          <h2 class="big">A clean yard,<br><span style="color:#B8925A">ready for winter</span></h2>
        </div>
        <p class="lede">No leaves on the lawn, nothing smothering the beds, and clear walkways through the season.</p>
      </div>
      <div class="pgrid res">
          <figure><Image src={photo('autumn-leaves.jpg')} alt="Autumn trees and fallen leaves behind a curved stone seat wall" widths={[480, 800, 1200, 1600]} sizes="(min-width: 1024px) 50vw, 100vw" format="webp" quality={70} decoding="async" loading="lazy" /><figcaption>Fall leaves &amp; a finished patio</figcaption></figure>
          <figure><Image src={photo('driveway-lawn-edges.jpg')} alt="A new driveway with straw-covered lawn edges and a rake on the grass" widths={[480, 800, 1200, 1600]} sizes="(min-width: 1024px) 50vw, 100vw" format="webp" quality={70} decoding="async" loading="lazy" /><figcaption>Driveway &amp; lawn edges, finished</figcaption></figure>
      </div>
    </div>
  </section>

  
  <section class="cta">
    <div class="frame-in"></div>
    <svg class="leaf " style="left:8%;top:16%;width:30px;height:30px;--r:-24deg;animation-delay:0s" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12,1 13.6,5.5 16.5,4 16,8 20.5,6.8 19,10.5 23,12 19,13.6 20,17 15.6,15.6 13,18.2 12.6,20 11.4,20 11,18.2 8.4,15.6 4,17 5,13.6 1,12 5,10.5 3.5,6.8 8,8 7.5,4 10.4,5.5" fill="#E8902A"></polygon><path d="M12 19.5V23.5" stroke="#E8902A" stroke-width="1.4" stroke-linecap="round"></path></svg>
    <svg class="leaf " style="left:86%;top:22%;width:24px;height:24px;--r:30deg;animation-delay:3s" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12,1 13.6,5.5 16.5,4 16,8 20.5,6.8 19,10.5 23,12 19,13.6 20,17 15.6,15.6 13,18.2 12.6,20 11.4,20 11,18.2 8.4,15.6 4,17 5,13.6 1,12 5,10.5 3.5,6.8 8,8 7.5,4 10.4,5.5" fill="#C9A46A"></polygon><path d="M12 19.5V23.5" stroke="#C9A46A" stroke-width="1.4" stroke-linecap="round"></path></svg>
    <svg class="leaf d" style="left:78%;top:74%;width:28px;height:28px;--r:60deg;animation-delay:5s" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12,1 13.6,5.5 16.5,4 16,8 20.5,6.8 19,10.5 23,12 19,13.6 20,17 15.6,15.6 13,18.2 12.6,20 11.4,20 11,18.2 8.4,15.6 4,17 5,13.6 1,12 5,10.5 3.5,6.8 8,8 7.5,4 10.4,5.5" fill="#E8902A"></polygon><path d="M12 19.5V23.5" stroke="#E8902A" stroke-width="1.4" stroke-linecap="round"></path></svg>
    <svg class="leaf d" style="left:16%;top:70%;width:20px;height:20px;--r:10deg;animation-delay:2s" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12,1 13.6,5.5 16.5,4 16,8 20.5,6.8 19,10.5 23,12 19,13.6 20,17 15.6,15.6 13,18.2 12.6,20 11.4,20 11,18.2 8.4,15.6 4,17 5,13.6 1,12 5,10.5 3.5,6.8 8,8 7.5,4 10.4,5.5" fill="#C9A46A"></polygon><path d="M12 19.5V23.5" stroke="#C9A46A" stroke-width="1.4" stroke-linecap="round"></path></svg>
    <div class="wrap">
      <h2>Ready to clear the leaves <span class="g">this fall?</span></h2>
      <a href="/lp/leaf-cleanup-quote" class="btn-gold" data-track="quote_click" data-track-location="cta_band">Get a free quote <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"></path></svg></a>
      <a href="tel:+17328039646" class="call" data-track-location="cta_band">Or call (732) 803-9646</a>
    </div>
  </section>

  
  <footer class="foot">
    <div class="wrap">
      <div class="foot-in">
        <Image src={logo} alt="Euro Style Landscape" width={120} height={120} densities={[1, 2]} loading="eager" class="es-logo" />
        <ul>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C9A46A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"></path></svg><a href="tel:+17328039646" data-track-location="footer">(732) 803-9646</a></li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C9A46A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg><a href="/">eurostylelandscape.com</a></li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C9A46A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"></path><circle cx="12" cy="10" r="3"></circle></svg><span>Sayreville, NJ · Serving Middlesex County</span></li>
        </ul>
      </div>
      <div class="legal">
        <span>Powered by <a href="https://www.digitalservicesmaster.com/" style="text-decoration:underline">Digital Services Master</a> Copyright © 2026. All rights reserved</span>
        <a href="/privacy-policy" style="text-decoration:underline">Privacy policy</a>
      </div>
    </div>
  </footer>

</div>
</CampaignLayout>

<style is:global>
*{box-sizing:border-box}
body{margin:0;background:#F4EFE4;color:#22302A;font-family:var(--font-barlow);-webkit-font-smoothing:antialiased}
h1,h2,h3,p{margin:0;text-wrap:pretty}
.cond{font-family:var(--font-barlow-condensed);text-transform:uppercase}
.brush{font-family:var(--font-kaushan);font-weight:400;text-transform:none}
.wrap{max-width:1200px;margin:0 auto;padding:0 20px}
.eyebrow{font-family:var(--font-barlow-condensed);font-weight:700;font-size:15px;letter-spacing:.26em;text-transform:uppercase;display:flex;align-items:center;gap:10px}
.eyebrow .dot{width:8px;height:8px;border-radius:999px;background:#E8902A;flex:none}
h2.big{font-family:var(--font-barlow-condensed);font-weight:800;text-transform:uppercase;font-size:44px;line-height:.95;margin-top:12px}
.o{color:#E8902A}.g{color:#C9A46A}
.ring{flex:none;border-radius:999px;display:flex;align-items:center;justify-content:center;box-shadow:inset 0 0 0 2.5px #E8902A}
.leaf{position:absolute;z-index:1;opacity:.85;transform:rotate(var(--r));animation:sway 8s ease-in-out infinite alternate;pointer-events:none}
@keyframes sway{from{transform:translateY(-6px) rotate(var(--r))}to{transform:translateY(16px) rotate(calc(var(--r) + 30deg))}}
@media (prefers-reduced-motion: reduce){.leaf{animation:none}}
.leaf.d{display:none}
.btn-gold{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:56px;padding:0 28px;border-radius:999px;background:#C9A46A;color:#16291F;text-decoration:none;font-family:var(--font-barlow-condensed);font-weight:700;font-size:21px;letter-spacing:.05em;text-transform:uppercase}
.btn-gold:hover{background:#B8925A}
.btn-line{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:56px;padding:0 26px;border-radius:999px;border:1.5px solid rgba(244,239,228,.85);color:#F4EFE4;text-decoration:none;font-family:var(--font-barlow-condensed);font-weight:700;font-size:21px;letter-spacing:.05em;text-transform:uppercase}
.btn-line:hover{background:rgba(244,239,228,.1)}
a:focus-visible{outline:3px solid #E8902A;outline-offset:3px}
/* hero */
.hero{position:relative;min-height:760px;background:#16291F;color:#F4EFE4;overflow:hidden;display:flex}
.hero-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 0%;filter:saturate(1.1) brightness(.85)}
.hero-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(22,41,31,.72) 0%,rgba(22,41,31,.35) 30%,rgba(22,41,31,.7) 58%,rgba(22,41,31,.97) 82%,#16291F 100%)}
.frame{position:absolute;inset:12px;border:1px solid rgba(244,239,228,.55);border-radius:4px;pointer-events:none;z-index:3}
.hero-in{position:relative;z-index:4;width:100%;display:flex;flex-direction:column;padding-top:30px;padding-bottom:46px}
.hero-top{display:flex;align-items:center;justify-content:space-between}
.hero-top img{display:block;width:70px;height:70px}
.hero-phone{width:46px;height:46px;border-radius:999px;border:1.5px solid rgba(244,239,228,.6);display:flex;align-items:center;justify-content:center;color:#C9A46A;text-decoration:none}
.hero-phone span{display:none}
.hero-copy{margin-top:auto;padding-top:120px}
