.btn-line{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:56px;padding:0 26px;border-radius:999px;border:1.5px solid rgba(244,239,228,.85);color:#EFF4E7;text-decoration:none;font-family:var(--font-barlow-condensed);font-weight:700;font-size:21px;letter-spacing:.05em;text-transform:uppercase}
