<style is:global>
*{box-sizing:border-box}
body{margin:0;background:#EFF4E7;color:#0B3A25;font-family:var(--font-barlow);-webkit-font-smoothing:antialiased}
h1,h2,h3,p{margin:0;text-wrap:pretty}
