.rv-card{margin:0;background:#FFFFFF;border:1px solid #D9E2D2;border-radius:14px;padding:22px 20px;display:flex;flex-direction:column;gap:12px;box-shadow:0 8px 24px rgba(11,58,37,.06)}
.rv-card blockquote{margin:0;font-size:16px;line-height:1.6;color:#2E343A}
.rv-card figcaption{display:flex;flex-direction:column;gap:2px;margin-top:auto;font-size:14px;color:#4A554D}
.rv-card figcaption b{font-size:16px;color:#0B3A25}
.rv-more{display:inline-block;margin-top:18px;font-size:15px;font-weight:700;color:#0F4A2F;text-decoration:underline;text-underline-offset:3px}
.faq{padding:44px 0 64px;background:#EFF4E7}
.faq h2{color:#0F4A2F}
.qa-list{display:flex;flex-direction:column;gap:10px;margin-top:22px;max-width:820px}
.qa{background:#FFFFFF;border:1px solid #D9E2D2;border-radius:12px}
.qa summary{list-style:none;cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:18px 20px;font-size:18px;font-weight:700;color:#0F4A2F}
.qa summary::-webkit-details-marker{display:none}
.qa .pm{flex:none;color:#197148;transition:transform .2s}
.qa[open] .pm{transform:rotate(45deg)}
.qa p{padding:0 20px 18px;font-size:16px;line-height:1.6;color:#4A554D}
@media (min-width:768px){.rv-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media (min-width:1024px){.reviews{padding:90px 0 24px}.faq{padding:56px 0 90px}}
</style>
