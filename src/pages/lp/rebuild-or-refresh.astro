---
// Ad campaign page, from design/lp-rebuild-or-refresh-leads.dc.html (see CAMPAIGN-PAGES-UPDATE.md).
import { Font, Image } from 'astro:assets';
import CampaignLayout from '../../layouts/CampaignLayout.astro';
import TimelineField from '../../components/campaign/TimelineField.astro';
import SmsConsent from '../../components/SmsConsent.astro';
import CampaignFormScript from '../../components/campaign/CampaignFormScript.astro';
import NewClientOffer from '../../components/campaign/offer/NewClientOffer.astro';
import OfferPill from '../../components/campaign/offer/OfferPill.astro';
import OfferFormStrip from '../../components/campaign/offer/OfferFormStrip.astro';
import OfferLine from '../../components/campaign/offer/OfferLine.astro';
import { NEW_CLIENT_OFFER_ON as offer, NEW_CLIENT_OFFER_CODE } from '../../lib/campaigns';
import { photo } from '../../lib/images';
import logo from '../../assets/logo/esl-logo-on-dark.png';

---
<CampaignLayout title="Rebuild or Refresh Your Property · Euro Style Landscape">
  <Fragment slot="head">
    <Font cssVariable="--font-barlow-condensed" />
    <Font cssVariable="--font-barlow" preload={[{ weight: 400 }]} />
    <Font cssVariable="--font-montserrat" />
    <Font cssVariable="--font-great-vibes" />
    <Font cssVariable="--font-caveat" />
  </Fragment>
<div style="background:#EFF4E7">

  
  <header class="topbar">
    <div class="wrap">
      <Image src={logo} alt="Euro Style Landscape" width={74} height={74} densities={[1, 2]} loading="eager" class="es-logo" />
      <a href="tel:+17328039646" class="call-pill" data-track-location="top_bar"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>Call (732) 803-9646</a>
    </div>
  </header>

  
  <section class="hero">
    <div class="hero-photo"><Image src={photo('raised-patio-rear.jpg')} alt="Raised paver patio with wide steps behind a white house" widths={[480, 800, 1200, 1440]} sizes="100vw" format="webp" quality={45} decoding="async" loading="eager" fetchpriority="high" class="hero-2027" /><Image src={photo('front-lawn-tree.jpg')} alt="A front yard with a mature tree, mulched beds and trimmed shrubs" widths={[480, 800, 1200, 1440]} sizes="100vw" format="webp" quality={45} decoding="async" hidden loading="lazy" class="hero-fall" /></div>
    <div class="fall-only" style="display:contents" hidden>
      <svg class="leaf " style="left:86%;top:8%;width:30px;height:30px;--r:20deg;animation-delay:0s" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12,1 13.6,5.5 16.5,4 16,8 20.5,6.8 19,10.5 23,12 19,13.6 20,17 15.6,15.6 13,18.2 12.6,20 11.4,20 11,18.2 8.4,15.6 4,17 5,13.6 1,12 5,10.5 3.5,6.8 8,8 7.5,4 10.4,5.5" fill="#E07A2B"></polygon><path d="M12 19.5V23.5" stroke="#E07A2B" stroke-width="1.4" stroke-linecap="round"></path></svg>
      <svg class="leaf d" style="left:48%;top:70%;width:24px;height:24px;--r:-30deg;animation-delay:2s" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12,1 13.6,5.5 16.5,4 16,8 20.5,6.8 19,10.5 23,12 19,13.6 20,17 15.6,15.6 13,18.2 12.6,20 11.4,20 11,18.2 8.4,15.6 4,17 5,13.6 1,12 5,10.5 3.5,6.8 8,8 7.5,4 10.4,5.5" fill="#E07A2B"></polygon><path d="M12 19.5V23.5" stroke="#E07A2B" stroke-width="1.4" stroke-linecap="round"></path></svg>
      <svg class="leaf d" style="left:6%;top:88%;width:22px;height:22px;--r:50deg;animation-delay:4s" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12,1 13.6,5.5 16.5,4 16,8 20.5,6.8 19,10.5 23,12 19,13.6 20,17 15.6,15.6 13,18.2 12.6,20 11.4,20 11,18.2 8.4,15.6 4,17 5,13.6 1,12 5,10.5 3.5,6.8 8,8 7.5,4 10.4,5.5" fill="#B9BB4A"></polygon><path d="M12 19.5V23.5" stroke="#B9BB4A" stroke-width="1.4" stroke-linecap="round"></path></svg>
    </div>
    <div class="wrap">
      <div class="hero-grid">
        <div class="hero-copy">
          <OfferPill text="New clients · 20% off your first refresh" />
          <p class="eyebrow" data-eyebrow>Now booking 2027 projects</p>
          <h1 data-headline>Rebuild or Refresh?</h1>
          <p class="sub">Take your yard from ordinary to extraordinary, designed, built and cared for by one local team.</p>
        </div>
        <div class="form-wrap">
        <div class="form-card" id="quote" data-form-card>
          
          <div data-step1>
            <p class="step-k cond">Step 1 of 2</p>
            <p class="form-title cond">What are you planning?</p>
            <OfferFormStrip service="property refresh" />
            <div class="choices">
              <button type="button" class="choice" data-pick="rebuild">
                <span class="ch-ic"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#B9BB4A" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M3 9.5h18M3 14.5h18M9 4v5.5M15 9.5v5M9 14.5V20"></path></svg></span>
                <span class="ch-t"><b class="cond">Rebuild</b><span>Patios, walls, outdoor kitchens, fire pits</span></span>
                <span class="ch-go"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"></path></svg></span>
              </button>
              <button type="button" class="choice" data-pick="refresh">
                <span class="ch-ic"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#B9BB4A" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 20h10"></path><path d="M12 20v-8"></path><path d="M12 12c0-3.5 2.5-6 6-6 0 3.5-2.5 6-6 6z"></path><path d="M12 14c0-3-2-5-5-5 0 3 2 5 5 5z"></path></svg></span>
                <span class="ch-t"><b class="cond">Refresh</b><span>Planting, beds, lawn care, fencing, cleanups</span></span>
                <span class="ch-go"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"></path></svg></span>
              </button>
            </div>
            <p class="fine">Free and no obligation. Takes under a minute.{offer && <><br>*20% off applies to your first property refresh. New clients only.</>}</p>
          </div>
          <div data-step2 hidden>
            <form action="/api/lead" method="post" data-campaign-form style="display:flex;flex-direction:column;gap:14px">
              <div class="s2-head">
                <button type="button" class="back" data-back><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"></path></svg> Back</button>
                <span class="step-k cond">Step 2 of 2</span>
              </div>
              <p class="form-title cond" data-choice-title data-rebuild="Tell us about your project" data-refresh="What do you need refreshed?"></p>
              <input type="hidden" name="project_choice" value="">
              <input type="hidden" name="ad_headline" value="2027">
              <input type="hidden" name="source" value="fb-rebuild-refresh-landing">
              {/* The 20% offer goes with Refresh leads only: CampaignFormScript sets it when a path is picked. */}
              <input type="hidden" name="offer" value="none" data-offer-choice={offer ? 'refresh' : undefined} data-offer-value={NEW_CLIENT_OFFER_CODE}>
            <input type="hidden" name="form_id" value="fb-rebuild-refresh-landing">
              <div class="hp" aria-hidden="true"><label>Leave empty<input type="text" name="website" tabindex="-1" autocomplete="off"></label></div>
              <label class="fld"><span>Full name</span><input class="qf" name="name" type="text" autocomplete="name" required></label>
            <label class="fld"><span>Email</span><input class="qf" name="email" type="email" autocomplete="email" maxlength="200" required></label>
              <div class="row2">
                <label class="fld"><span>Phone</span><input class="qf" name="phone" type="tel" inputmode="tel" autocomplete="tel" required></label>
                <label class="fld"><span>ZIP code</span><input class="qf" name="zip" type="text" inputmode="numeric" pattern="[0-9]{5}" maxlength="5" autocomplete="postal-code" required></label>
              </div>
              <div data-choice-block="rebuild" style="display:contents" hidden>
              <label class="fld"><span>Project type</span><select class="qf" name="service" disabled required><option value="">Choose a project</option><option>Paver patio</option><option>Retaining wall</option><option>Outdoor kitchen</option><option>Fire pit &amp; seating wall</option><option>Decks</option><option>Full backyard design</option><option>Not sure yet</option></select></label>
              <div class="row2">
                <label class="fld"><span>Rough budget</span><select class="qf" name="budget"><option value="">Choose</option><option>Under $5k</option><option>$5k – $15k</option><option>$15k – $30k</option><option>$30k+</option><option>Not sure yet</option></select></label>
              </div>
              </div>
              <div data-choice-block="refresh" style="display:contents" hidden>
              <label class="fld"><span>Service</span><select class="qf" name="service" disabled required><option value="">Choose a service</option><option>Fall cleanup</option><option>Planting &amp; landscape install</option><option>Garden bed refresh</option><option>Lawn maintenance</option><option>Fencing &amp; gates</option><option>Not sure yet</option></select></label>
              </div>
              <TimelineField />
              <label class="fld"><span>Tell us about your property <em>(optional)</em></span><textarea class="qf" name="message" rows="3"></textarea></label>
              <SmsConsent id="lp-rr" />
              <button type="submit" class="submit cond"><span data-label>Book my free consultation</span> <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"></path></svg></button>
              <p class="form-error" role="alert" data-form-error hidden>Sorry, your request didn't go through. Please try again or call us on (732) 803-9646.</p>
              <p class="fine">Free and no obligation. We'll call you to book a time to visit.{offer && <><br>*20% off applies to your first property refresh. New clients only.</>}</p>
            </form>
          </div>
          
            <div role="status" class="success" tabindex="-1" data-success hidden>
              <span class="ok"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#0F4A2F" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span>
              <p class="form-title cond">Thanks!</p>
              <p>We'll call you shortly to book your on-site consultation.</p>
              <a href="tel:+17328039646" class="call-pill" data-track-location="form_success"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>Call (732) 803-9646</a>
            </div>
          
        </div>
        </div>
      </div>
    </div>
  </section>
  <script is:inline>
    if ((new URLSearchParams(location.search).get('h') || '').toLowerCase() === 'fall') {
      document.querySelector('.hero-2027').hidden = true;
      var img = document.querySelector('.hero-fall');
      img.hidden = false;
      img.loading = 'eager';
      document.querySelectorAll('.fall-only').forEach(function (el) { el.hidden = false; });
      var eye = document.querySelector('[data-eyebrow]');
      eye.textContent = 'Now scheduling fall services';
      eye.className = 'eyebrow fall';
      var h1 = document.querySelector('[data-headline]');
      h1.textContent = 'Fall Is the Perfect Time to Refresh Your Property';
      h1.className = 'long';
      document.querySelector('input[name="ad_headline"]').value = 'fall';
    }
  </script>

  
  <section class="trust" aria-label="Why choose us">
    <div class="wrap">
      <ul>
        <li><span class="tic"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#B9BB4A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"></path></svg></span><span class="cond">Free design consultation</span></li>
        <li><span class="tic"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#B9BB4A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><path d="m9 12 2 2 4-4"></path></svg></span><span class="cond">Licensed &amp; insured</span></li>
        <li><span class="tic"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#B9BB4A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"></path></svg></span><span class="cond">One local team</span></li>
      </ul>
    </div>
  </section>

  
  <section class="rebuild">
    <div class="wrap reb-in">
      <div>
        <p class="label">Rebuild</p>
        <h2 class="h">Outdoor living,<br><span>built to last</span></h2>
        <ul class="dl">
          <li><span class="dia" aria-hidden="true"></span>Paver patios</li>
          <li><span class="dia" aria-hidden="true"></span>Outdoor kitchens</li>
          <li><span class="dia" aria-hidden="true"></span>Fire pits &amp; seating walls</li>
          <li><span class="dia" aria-hidden="true"></span>Retaining walls + more</li>
        </ul>
        <p class="plan"><b>Plan this winter, build in spring.</b> 2027 dates are booking now.</p>
      </div>
      <div class="reb-photos">
        <figure><Image src={photo('raised-patio-built.jpg')} alt="Raised paver patio with steps behind a house" widths={[480, 800, 1200, 1600]} sizes="(min-width: 1024px) 50vw, 100vw" format="webp" quality={70} decoding="async" loading="lazy" /><span class="tab cond">Raised patio</span></figure>
        <figure><Image src={photo('walkway-steps.jpg')} alt="Paver walkway with a dark border leading to wide steps" widths={[480, 800, 1200, 1600]} sizes="(min-width: 1024px) 50vw, 100vw" format="webp" quality={70} decoding="async" loading="lazy" /><span class="tab cond">Fresh walkway</span></figure>
      </div>
    </div>
  </section>

  
  <section class="refresh">
    <div class="wrap ref-in">
      <div>
        <p class="label">Refresh</p>
        <h2 class="h">Our refresh <span>services</span></h2>
        <ul class="rl">
          <li><span class="ric"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#B9BB4A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2v13"></path><path d="M6 15h12"></path><path d="M6 15v5M9 15v5M12 15v5M15 15v5M18 15v5"></path></svg></span><span class="cond">Yard cleanup</span></li>
          <li><span class="ric"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#B9BB4A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="3"></circle><path d="M12 11v10M12 16c-2.5 0-4.5-1.5-5-4M12 18c2.5 0 4.5-1.5 5-4"></path></svg></span><span class="cond">Bed cleanup</span></li>
          <li><span class="ric"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#B9BB4A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 20h10"></path><path d="M12 20v-8"></path><path d="M12 12c0-3.5 2.5-6 6-6 0 3.5-2.5 6-6 6z"></path><path d="M12 14c0-3-2-5-5-5 0 3 2 5 5 5z"></path></svg></span><span class="cond">Planting</span></li>
          <li><span class="ric"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#B9BB4A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21h18"></path><path d="M6 21v-5M9 21v-8M12 21v-6M15 21v-9M18 21v-5"></path></svg></span><span class="cond">Lawn care</span></li>
          <li><span class="ric"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#B9BB4A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4 2.5 6v14h3V6z"></path><path d="M12 4l-1.5 2v14h3V6z"></path><path d="M20 4l-1.5 2v14h3V6z"></path><path d="M5.5 9h5M5.5 16h5M13.5 9h5M13.5 16h5"></path></svg></span><span class="cond">Fencing &amp; gates</span></li>
          <li><span class="ric"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#B9BB4A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 2l4 4-4 4"></path><path d="M3 11V9a3 3 0 0 1 3-3h15"></path><path d="M7 22l-4-4 4-4"></path><path d="M21 13v2a3 3 0 0 1-3 3H3"></path></svg></span><span class="cond">Landscape maintenance</span></li>
        </ul>
      </div>
      <div class="polas">
          <figure class="pola a"><Image src={photo('striped-lawn-wood-fence.jpg')} alt="Lawn maintenance in East Brunswick, NJ" widths={[480, 800, 1200, 1600]} sizes="(min-width: 1024px) 50vw, 100vw" format="webp" quality={70} decoding="async" loading="lazy" /><figcaption>Healthier lawns</figcaption></figure>
          <figure class="pola b"><Image src={photo('black-mulch-rings-river-rock-beds.jpg')} alt="Bush trimming and mulch installation in Sayreville, NJ" widths={[480, 800, 1200, 1600]} sizes="(min-width: 1024px) 50vw, 100vw" format="webp" quality={70} decoding="async" loading="lazy" /><figcaption>Cleaner beds</figcaption></figure>
          <figure class="pola c"><Image src={photo('backyard-after.jpg')} alt="A finished backyard with new lawn, paver walkway and deck" widths={[480, 800, 1200, 1600]} sizes="(min-width: 1024px) 50vw, 100vw" format="webp" quality={70} decoding="async" loading="lazy" /><figcaption>Finished landscapes</figcaption></figure>
      </div>
    </div>
  </section>

  <NewClientOffer
    id="new-client-offer"
    service="property refresh"
    chips={['Yard & bed cleanup', 'Planting & landscape install', 'Garden bed refresh', 'Lawn maintenance', 'Fencing & gates']}
    label="Claim 20% off your first refresh"
    href="#quote"
    terms="*Valid on your first property refresh with Euro Style Landscape. New clients only."
  />

  
  <section class="work">
    <div class="wrap">
      <p class="label">Recent work</p>
      <h2 class="h">Real Euro Style <span>projects</span></h2>
      <div class="ggrid">
        <figure class="gi"><Image src={photo('backyard-patio-deck-sod-putting-green.jpg')} alt="Deck installation, paver patio installation, artificial turf installation and planting in Linden, NJ" widths={[480, 800, 1200, 1600]} sizes="(min-width: 1024px) 50vw, 100vw" format="webp" quality={70} decoding="async" loading="lazy" /><span class="tab cond">Deck, patio &amp; turf</span></figure>
        <figure class="gi"><Image src={photo('raised-patio-night.jpg')} alt="Raised paver patio at night with lights in the steps" widths={[480, 800, 1200, 1600]} sizes="(min-width: 1024px) 50vw, 100vw" format="webp" quality={70} decoding="async" loading="lazy" /><span class="tab cond">Patio with step lighting</span></figure>
        <figure class="gi"><Image src={photo('paver-walkway-veneer-steps-plantings.jpg')} alt="Paver walkway, masonry stoop, mulch installation and planting in Sewaren, NJ" widths={[480, 800, 1200, 1600]} sizes="(min-width: 1024px) 50vw, 100vw" format="webp" quality={70} decoding="async" loading="lazy" /><span class="tab cond">Paver walkway & stoop</span></figure>
        <figure class="gi"><Image src={photo('circular-paver-driveway-lawn-island.jpg')} alt="Paver walkway installation in Sayreville, NJ" widths={[480, 800, 1200, 1600]} sizes="(min-width: 1024px) 50vw, 100vw" format="webp" quality={70} decoding="async" loading="lazy" /><span class="tab cond">Paver walkway</span></figure>
        <figure class="gi"><Image src={photo('paver-patio-dark-border-seat-wall.jpg')} alt="Paver patio, Belgian block edging, seating wall and block columns installed in Avenel, NJ" widths={[480, 800, 1200, 1600]} sizes="(min-width: 1024px) 50vw, 100vw" format="webp" quality={70} decoding="async" loading="lazy" /><span class="tab cond">Patio &amp; seat wall</span></figure>
        <figure class="gi"><Image src={photo('front-entry-after.jpg')} alt="Stone front entry steps and walkway" widths={[480, 800, 1200, 1600]} sizes="(min-width: 1024px) 50vw, 100vw" format="webp" quality={70} decoding="async" loading="lazy" /><span class="tab cond">Stone front steps</span></figure>
      </div>
    </div>
  </section>

  
  <section class="team">
    <div class="wrap team-in">
      <div class="ring"><Image src={photo('team.jpg')} alt="The Euro Style Landscape crew standing together on a job site" widths={[480, 800, 1200, 1600]} sizes="(min-width: 1024px) 50vw, 100vw" format="webp" quality={70} decoding="async" loading="lazy" /></div>
      <div>
        <p class="label">Meet the team</p>
        <h2 class="h">Your local <span>crew</span></h2>
        <p class="copy">One local team, from the first visit to the final clean-up.</p>
        <span class="script">Based in Sayreville, NJ</span>
      </div>
    </div>
  </section>

  <div class="wrap hf">
    
    <section class="how">
      <p class="label">How it works</p>
      <h2 class="h">Three <span>simple steps</span></h2>
      <ol class="steps">
