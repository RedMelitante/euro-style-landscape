.leaf.d{display:none}
.btn-gold{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:56px;padding:0 28px;border-radius:999px;background:#B9BB4A;color:#0B3A25;text-decoration:none;font-family:var(--font-barlow-condensed);font-weight:800;font-size:21px;letter-spacing:.05em;text-transform:uppercase;border:0;cursor:pointer}
