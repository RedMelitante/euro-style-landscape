---
// Ad campaign page, from design/lp-property-refresh-awareness.dc.html (see CAMPAIGN-PAGES-UPDATE.md).
import { Font, Image } from 'astro:assets';
import CampaignLayout from '../../layouts/CampaignLayout.astro';
import NewClientOffer from '../../components/campaign/offer/NewClientOffer.astro';
import OfferPill from '../../components/campaign/offer/OfferPill.astro';
import OfferLine from '../../components/campaign/offer/OfferLine.astro';
import { photo } from '../../lib/images';
import logo from '../../assets/logo/euro-style-landscape-logo.jpg';

---
<CampaignLayout title="Property Refresh · Euro Style Landscape" viewContent="load" trackPage="property_refresh">
  <Fragment slot="head">
    <Font cssVariable="--font-barlow-condensed" />
    <Font cssVariable="--font-barlow" preload={[{ weight: 400 }]} />
    <Font cssVariable="--font-great-vibes" />
  </Fragment>
<div style="background:#F3EEE4">

  
  <section class="h2o">
    <Image src={photo('raised-patio-wide.jpg')} alt="Wide raised paver patio with steps across the back of a house" widths={[480, 800, 1200, 1440]} sizes="100vw" format="webp" quality={45} decoding="async" loading="eager" fetchpriority="high" class="h2o-img" />
    <div class="h2o-shade"></div>
    <div class="h2o-frame"></div>
    <div class="wrap h2o-in">
      <div class="h2o-top">
        <Image src={logo} alt="Euro Style Landscape" width={96} height={96} densities={[1, 2]} loading="eager" class="es-logo" />
        <a href="tel:+17328039646" class="h2o-phone" data-track-location="hero"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"></path></svg><span>(732) 803-9646</span></a>
      </div>
      <div class="h2o-body">
        <div class="h2o-copy">
          <OfferPill text="New clients · 20% off your first refresh" />
          <p class="h2o-eyebrow"><span class="dot"></span>Design · Build · Maintain</p>
          <h1>Premium care.<span>Beautiful results.</span></h1>
          <p class="sub">European-style landscaping that refreshes your property and boosts curb appeal, from one local team in Middlesex County.</p>
          <div class="h2o-btns">
            <a href="#work" class="btn-gold">See Our Work <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"></path></svg></a>
            <a href="/lp/rebuild-or-refresh" class="btn-line" data-track="estimate_click" data-track-location="hero">Get a Free Estimate</a>
          </div>
        </div>
        <div class="h2o-badge"><div class="badge" aria-label="Licensed and insured">
            <svg viewBox="0 0 120 120" aria-hidden="true">
              <defs><path id="bt" d="M60,60 m-41,0 a41,41 0 1,1 82,0"></path><path id="bb" d="M60,60 m-45,0 a45,45 0 0,0 90,0"></path></defs>
              <circle cx="60" cy="60" r="58" fill="#1F3A2B"></circle>
              <circle cx="60" cy="60" r="53" fill="none" stroke="#C9A46A" stroke-width="2"></circle>
              <circle cx="60" cy="60" r="33" fill="none" stroke="#C9A46A" stroke-width="1" stroke-opacity=".6"></circle>
              <text font-family="Barlow Condensed, sans-serif" font-weight="800" font-size="15" letter-spacing="2.4" fill="#F4EFE4"><textPath href="#bt" startOffset="50%" text-anchor="middle">LICENSED &amp;</textPath></text>
              <text font-family="Barlow Condensed, sans-serif" font-weight="800" font-size="15" letter-spacing="2.4" fill="#F4EFE4"><textPath href="#bb" startOffset="50%" text-anchor="middle" dominant-baseline="hanging">INSURED</textPath></text>
              <g transform="translate(46,45) scale(1.15)"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" fill="none" stroke="#C9A46A" stroke-width="2" stroke-linejoin="round"></path><path d="m9 12 2 2 4-4" fill="none" stroke="#C9A46A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></g>
            </svg>
          </div></div>
      </div>
    </div>
  </section>

  
  <section class="rr-sec">
    <div class="wrap">
      <p class="label">Our services</p>
      <h2 class="h">Refresh it <span>or rebuild it</span></h2>
      <p class="lede">From a tidy refresh to a brand-new outdoor living space, one team handles it.</p>
      <div class="rr-grid">
        <article class="rr ref">
          <div class="rr-photo"><Image src={photo('stone-pillars-gate.jpg')} alt="White vinyl gate and fence between stacked-stone pillars with lanterns" widths={[480, 800, 1200, 1600]} sizes="(min-width: 1024px) 50vw, 100vw" format="webp" quality={70} decoding="async" loading="lazy" /><span class="tab cond">Refresh</span></div>
          <div class="rr-body">
            <ul><li><span class="gck" style="width:26px;height:26px"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#1F3A2B" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span>Planting &amp; landscape install</li><li><span class="gck" style="width:26px;height:26px"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#1F3A2B" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span>Garden bed refresh</li><li><span class="gck" style="width:26px;height:26px"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#1F3A2B" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span>Lawn maintenance</li><li><span class="gck" style="width:26px;height:26px"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#1F3A2B" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span>Fencing &amp; gates</li></ul>
            <a href="/services#planting" class="tlink">Explore refresh services <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"></path></svg></a>
          </div>
        </article>
        <article class="rr reb">
          <div class="rr-photo"><Image src={photo('raised-patio-rear.jpg')} alt="Raised paver patio with wide steps behind a white house" widths={[480, 800, 1200, 1600]} sizes="(min-width: 1024px) 50vw, 100vw" format="webp" quality={70} decoding="async" loading="lazy" /><span class="tab cond">Rebuild</span></div>
          <div class="rr-body">
            <ul><li><span class="gck" style="width:26px;height:26px"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#1F3A2B" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span>Paver patios</li><li><span class="gck" style="width:26px;height:26px"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#1F3A2B" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span>Retaining walls</li><li><span class="gck" style="width:26px;height:26px"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#1F3A2B" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span>Outdoor kitchens</li><li><span class="gck" style="width:26px;height:26px"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#1F3A2B" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span>Fire pits &amp; seating walls</li></ul>
            <a href="/services#construction" class="tlink">Explore outdoor living <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"></path></svg></a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <NewClientOffer
    id="new-client-offer"
    service="property refresh"
    chips={['Yard & bed cleanup', 'Planting & landscape install', 'Garden bed refresh', 'Lawn maintenance', 'Fencing & gates']}
    label="Claim 20% Off Your First Refresh"
    href="/lp/rebuild-or-refresh"
    track="estimate_click"
    terms="*Valid on your first property refresh with Euro Style Landscape. New clients only."
  />

  
  <section class="gal" id="work">
    <div class="wrap">
      <p class="label">Our work</p>
      <h2>Another property<span class="script">Transformation!</span></h2>
      <svg class="swoosh" viewBox="0 0 220 14" aria-hidden="true"><path d="M4 10 C 60 2, 140 2, 216 8" fill="none" stroke="#C9A46A" stroke-width="3" stroke-linecap="round"></path></svg>
      
      <div class="ggrid" data-track-view="gallery">
        <figure class="gi big"><Image src={photo('walkway-steps.jpg')} alt="Paver walkway with a dark border leading to wide paver steps" widths={[480, 800, 1200, 1600]} sizes="(min-width: 1024px) 50vw, 100vw" format="webp" quality={70} decoding="async" loading="lazy" /><span class="tab cond">Fresh Walkway</span></figure>
        <figure class="gi "><Image src={photo('hero-firepit-patio.jpg')} alt="Circular paver patio with a curved stone seat wall" widths={[480, 800, 1200, 1600]} sizes="(min-width: 1024px) 50vw, 100vw" format="webp" quality={70} decoding="async" loading="lazy" /><span class="tab cond">Outdoor Living</span></figure>
        <figure class="gi "><Image src={photo('raised-patio-built.jpg')} alt="Raised paver patio with steps behind a house" widths={[480, 800, 1200, 1600]} sizes="(min-width: 1024px) 50vw, 100vw" format="webp" quality={70} decoding="async" loading="lazy" /><span class="tab cond">Raised Patio</span></figure>
        <figure class="gi "><Image src={photo('stone-pillars-gate.jpg')} alt="White vinyl gate between stacked-stone pillars with lanterns" widths={[480, 800, 1200, 1600]} sizes="(min-width: 1024px) 50vw, 100vw" format="webp" quality={70} decoding="async" loading="lazy" /><span class="tab cond">Stone Pillars &amp; Gate</span></figure>
        <figure class="gi "><Image src={photo('front-walkway.jpg')} alt="Curved paver walkway lined with topiaries leading to a brick-front home" widths={[480, 800, 1200, 1600]} sizes="(min-width: 1024px) 50vw, 100vw" format="webp" quality={70} decoding="async" loading="lazy" /><span class="tab cond">Front Walkway</span></figure>
      </div>
      {/* Before/after: add the BeforeAfter slider (design/component-before-after.dc.html) here once the client
          sends real before photos of these projects. No placeholder at launch. */}
    </div>
  </section>

  
  <section class="team">
    <svg class="leaf d" style="left:92%;top:10%;width:24px;height:24px;--r:24deg;animation-delay:0s" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12,1 13.6,5.5 16.5,4 16,8 20.5,6.8 19,10.5 23,12 19,13.6 20,17 15.6,15.6 13,18.2 12.6,20 11.4,20 11,18.2 8.4,15.6 4,17 5,13.6 1,12 5,10.5 3.5,6.8 8,8 7.5,4 10.4,5.5" fill="#E07A2B"></polygon><path d="M12 19.5V23.5" stroke="#E07A2B" stroke-width="1.4" stroke-linecap="round"></path></svg>
    <div class="wrap team-in">
      <div class="frame"><Image src={photo('team.jpg')} alt="The Euro Style Landscape crew standing together on a job site" widths={[480, 800, 1200, 1600]} sizes="(min-width: 1024px) 50vw, 100vw" format="webp" quality={70} decoding="async" loading="lazy" /></div>
      <div>
        <p class="label">Meet the team</p>
        <h2 class="h">The crew behind <span>every yard</span></h2>
        <p>Based in Sayreville. The same local crew from the first visit to the final clean-up. Licensed &amp; insured.</p>
      </div>
    </div>
  </section>

  <div class="wrap dh">
    
    <section class="diff">
      <p class="label">Why Euro Style</p>
      <h2 class="h">What makes us <span>different</span></h2>
      <ul>
        <li><span class="gck" style="width:40px;height:40px"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1F3A2B" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span><span class="cond">One team, design to build</span></li>
        <li><span class="gck" style="width:40px;height:40px"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1F3A2B" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span><span class="cond">Free on-site consultation</span></li>
        <li><span class="gck" style="width:40px;height:40px"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1F3A2B" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span><span class="cond">Detailed written quotes</span></li>
        <li><span class="gck" style="width:40px;height:40px"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1F3A2B" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span><span class="cond">Ongoing maintenance available</span></li>
      </ul>
    </section>

    
    <section class="how">
      <p class="label">How it works</p>
      <h2 class="h">Three <span>simple steps</span></h2>
      <ol class="steps">
        <li class="step"><span class="sic"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#C9A46A" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="3" width="14" height="18" rx="2"></rect><path d="M9 3h6v3H9z"></path><path d="M9 11h6M9 15h4"></path></svg><span class="sn cond">1</span></span><div><h3 class="cond">Free consultation</h3><p>We visit, walk the property with you and talk through what you want.</p></div></li>
        <li class="step"><span class="sic"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#C9A46A" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"></path></svg><span class="sn cond">2</span></span><div><h3 class="cond">Design &amp; written quote</h3><p>You get a plan and a detailed written quote before any work starts.</p></div></li>
        <li class="step"><span class="sic"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#C9A46A" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5"></path><path d="M5 9.5V21h14V9.5"></path><path d="M10 21v-6h4v6"></path></svg><span class="sn cond">3</span></span><div><h3 class="cond">We build or refresh, then clean up</h3><p>Our crew does the work and leaves your property clean.</p></div></li>
      </ol>
    </section>
  </div>

  
  <section class="season">
    <svg class="leaf " style="left:84%;top:14%;width:40px;height:40px;--r:18deg;animation-delay:0s" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12,1 13.6,5.5 16.5,4 16,8 20.5,6.8 19,10.5 23,12 19,13.6 20,17 15.6,15.6 13,18.2 12.6,20 11.4,20 11,18.2 8.4,15.6 4,17 5,13.6 1,12 5,10.5 3.5,6.8 8,8 7.5,4 10.4,5.5" fill="#E07A2B"></polygon><path d="M12 19.5V23.5" stroke="#E07A2B" stroke-width="1.4" stroke-linecap="round"></path></svg>
    <svg class="leaf d" style="left:92%;top:62%;width:28px;height:28px;--r:-24deg;animation-delay:3s" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12,1 13.6,5.5 16.5,4 16,8 20.5,6.8 19,10.5 23,12 19,13.6 20,17 15.6,15.6 13,18.2 12.6,20 11.4,20 11,18.2 8.4,15.6 4,17 5,13.6 1,12 5,10.5 3.5,6.8 8,8 7.5,4 10.4,5.5" fill="#C9A46A"></polygon><path d="M12 19.5V23.5" stroke="#C9A46A" stroke-width="1.4" stroke-linecap="round"></path></svg>
    <svg class="leaf d" style="left:70%;top:80%;width:22px;height:22px;--r:40deg;animation-delay:5s" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12,1 13.6,5.5 16.5,4 16,8 20.5,6.8 19,10.5 23,12 19,13.6 20,17 15.6,15.6 13,18.2 12.6,20 11.4,20 11,18.2 8.4,15.6 4,17 5,13.6 1,12 5,10.5 3.5,6.8 8,8 7.5,4 10.4,5.5" fill="#E07A2B"></polygon><path d="M12 19.5V23.5" stroke="#E07A2B" stroke-width="1.4" stroke-linecap="round"></path></svg>
    <div class="wrap">
      <p class="label">This season</p>
      <h2>Fall is the perfect time to refresh. <span>Winter is the perfect time to plan spring projects.</span></h2>
      <a href="/lp/landscape-cleanup-quote" class="tlink" data-track="estimate_click" data-track-location="seasonal">See fall services <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"></path></svg></a>
    </div>
  </section>

  
  <section class="cta">
    <div class="wrap">
      <div class="gr"></div>
      <h2>Ready to see what your property could look like?</h2>
      <OfferLine text="New clients get 20% off their first property refresh." light />
      <a href="/lp/rebuild-or-refresh" class="btn-gold" data-track="estimate_click" data-track-location="cta_band">Get a Free Estimate <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"></path></svg></a>
      <a href="tel:+17328039646" class="call" data-track-location="cta_band">Or call (732) 803-9646</a>
    </div>
  </section>

  
  <footer class="foot">
    <div class="wrap">
      <div class="foot-in">
        <div class="foot-brand"><Image src={logo} alt="Euro Style Landscape" width={118} height={118} densities={[1, 2]} loading="eager" class="es-logo" /><span>Design · Build · Maintain</span></div>
        <ul>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C9A46A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"></path></svg><a href="tel:+17328039646" data-track-location="footer">(732) 803-9646</a></li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C9A46A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg><a href="/">eurostylelandscape.com</a></li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C9A46A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"></path><circle cx="12" cy="10" r="3"></circle></svg><span>Sayreville, NJ · Serving Middlesex County</span></li>
        </ul>
      </div>
      <div class="legal">
        <span>Copyright © 2026 Euro Style Landscape. All rights reserved</span>
        <a href="/privacy-policy" style="text-decoration:underline">Privacy policy</a>
      </div>
    </div>
  </footer>

</div>
</CampaignLayout>

<style is:global>
/* hero (matches the other campaign pages) */
.h2o{position:relative;min-height:740px;background:#16291F;color:#F4EFE4;overflow:hidden;display:flex}
.h2o-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:62% 85%}
.h2o-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(22,41,31,.75) 0%,rgba(22,41,31,.3) 28%,rgba(22,41,31,.72) 56%,rgba(22,41,31,.97) 82%,#16291F 100%)}
.h2o-frame{position:absolute;inset:12px;border:1px solid rgba(244,239,228,.55);border-radius:4px;pointer-events:none;z-index:3}
.h2o .h2o-in{position:relative;z-index:4;width:100%;display:flex;flex-direction:column;padding-top:28px;padding-bottom:44px}
.h2o-top{display:flex;align-items:center;justify-content:space-between}
.h2o-top img{display:block;width:72px;height:72px}
.h2o-phone{width:46px;height:46px;border-radius:999px;border:1.5px solid rgba(244,239,228,.6);display:flex;align-items:center;justify-content:center;color:#C9A46A;text-decoration:none}
.h2o-phone span{display:none}
.h2o-copy{flex:1 1 auto;min-width:0}
.h2o-body{margin-top:auto;padding-top:120px;display:flex;align-items:flex-end;justify-content:space-between;gap:40px}
.h2o-eyebrow{font-family:var(--font-barlow-condensed);font-weight:700;font-size:15px;letter-spacing:.24em;text-transform:uppercase;display:flex;align-items:center;gap:10px;color:#F4EFE4}
.h2o-eyebrow .dot{width:8px;height:8px;border-radius:999px;background:#C9A46A}
.h2o h1{font-family:var(--font-barlow-condensed);font-weight:800;text-transform:uppercase;font-size:52px;overflow-wrap:break-word;line-height:.9;margin-top:14px;text-shadow:0 2px 20px rgba(0,0,0,.35)}
.h2o h1 span{display:block;color:#C9A46A}
.h2o .sub{font-size:18px;line-height:1.55;color:rgba(244,239,228,.9);margin-top:16px;max-width:520px}
