---
// Ad campaign page, from design/lp-landscape-cleanup-awareness.dc.html (see CAMPAIGN-PAGES-UPDATE.md).
import { Font, Image } from 'astro:assets';
import CampaignLayout from '../../layouts/CampaignLayout.astro';
import NewClientOffer from '../../components/campaign/offer/NewClientOffer.astro';
import OfferPill from '../../components/campaign/offer/OfferPill.astro';
import OfferLine from '../../components/campaign/offer/OfferLine.astro';
import { photo } from '../../lib/images';
import logo from '../../assets/logo/euro-style-landscape-logo.jpg';

---
<CampaignLayout title="Fall Yard Cleanup · Euro Style Landscape" viewContent="load" trackPage="yard_cleanup_awareness">
  <Fragment slot="head">
    <Font cssVariable="--font-barlow-condensed" />
    <Font cssVariable="--font-barlow" preload={[{ weight: 400 }]} />
    <Font cssVariable="--font-montserrat" />
    <Font cssVariable="--font-kaushan" />
    <Font cssVariable="--font-great-vibes" />
  </Fragment>
<div style="background:#F4EFE4">

  
  <section class="h2o">
    <Image src={photo('front-walkway.jpg')} alt="Curved paver walkway lined with topiaries and lawn in front of a brick home" widths={[480, 800, 1200, 1440]} sizes="100vw" format="webp" quality={45} decoding="async" loading="eager" fetchpriority="high" class="h2o-img" />
    <div class="h2o-shade"></div>
    <div class="h2o-frame"></div>
    <svg class="leaf d" style="left:84%;top:30%;width:26px;height:26px;--r:20deg;animation-delay:0s" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12,1 13.6,5.5 16.5,4 16,8 20.5,6.8 19,10.5 23,12 19,13.6 20,17 15.6,15.6 13,18.2 12.6,20 11.4,20 11,18.2 8.4,15.6 4,17 5,13.6 1,12 5,10.5 3.5,6.8 8,8 7.5,4 10.4,5.5" fill="#C45A2C"></polygon><path d="M12 19.5V23.5" stroke="#C45A2C" stroke-width="1.4" stroke-linecap="round"></path></svg>
    <svg class="leaf d" style="left:70%;top:82%;width:22px;height:22px;--r:-30deg;animation-delay:3s" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12,1 13.6,5.5 16.5,4 16,8 20.5,6.8 19,10.5 23,12 19,13.6 20,17 15.6,15.6 13,18.2 12.6,20 11.4,20 11,18.2 8.4,15.6 4,17 5,13.6 1,12 5,10.5 3.5,6.8 8,8 7.5,4 10.4,5.5" fill="#C9A46A"></polygon><path d="M12 19.5V23.5" stroke="#C9A46A" stroke-width="1.4" stroke-linecap="round"></path></svg>
    <div class="wrap h2o-in">
      <div class="h2o-top">
        <Image src={logo} alt="Euro Style Landscape" width={96} height={96} densities={[1, 2]} loading="eager" class="es-logo" />
        <a href="tel:+17328039646" class="h2o-phone" data-track-location="hero"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"></path></svg><span>(732) 803-9646</span></a>
      </div>
      <div class="h2o-body">
        <div class="h2o-copy">
          <OfferPill />
          <p class="h2o-eyebrow"><span class="dot"></span>Now booking · Fall cleanup season</p>
          <h1>Fall landscape cleanup<span>for a cleaner, healthier yard</span></h1>
          <p class="sub">Leaves, beds and lawn cleared and ready for winter, then cared for all year by one local team in Middlesex County.</p>
          <div class="h2o-btns">
            <a href="#cleanup" class="btn-gold">See What's Included <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"></path></svg></a>
            <a href="/lp/landscape-cleanup-quote" class="btn-line" data-track="estimate_click" data-track-location="hero">Get a Free Estimate</a>
          </div>
        </div>
        <div class="h2o-badge"><div class="badge" aria-label="Licensed and insured">
            <svg viewBox="0 0 120 120" aria-hidden="true">
              <defs><path id="bt" d="M60,60 m-41,0 a41,41 0 1,1 82,0"></path><path id="bb" d="M60,60 m-45,0 a45,45 0 0,0 90,0"></path></defs>
              <circle cx="60" cy="60" r="58" fill="#1F3A2B"></circle>
              <circle cx="60" cy="60" r="53" fill="none" stroke="#C9A46A" stroke-width="2"></circle>
              <circle cx="60" cy="60" r="33" fill="none" stroke="#C9A46A" stroke-width="1" stroke-opacity=".6"></circle>
              <text font-family="Barlow Condensed, sans-serif" font-weight="800" font-size="15" letter-spacing="2.4" fill="#F4EFE4"><textPath href="#bt" startOffset="50%" text-anchor="middle">LICENSED &amp;</textPath></text>
              <text font-family="Barlow Condensed, sans-serif" font-weight="800" font-size="15" letter-spacing="2.4" fill="#F4EFE4"><textPath href="#bb" startOffset="50%" text-anchor="middle" dominant-baseline="hanging">INSURED</textPath></text>
              <g transform="translate(46,45) scale(1.15)"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" fill="none" stroke="#C9A46A" stroke-width="2" stroke-linejoin="round"></path><path d="m9 12 2 2 4-4" fill="none" stroke="#C9A46A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></g>
            </svg>
          </div></div>
      </div>
    </div>
  </section>

  
  <section class="year">
    <svg class="leaf d" style="left:94%;top:6%;width:24px;height:24px;--r:30deg;animation-delay:1s" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12,1 13.6,5.5 16.5,4 16,8 20.5,6.8 19,10.5 23,12 19,13.6 20,17 15.6,15.6 13,18.2 12.6,20 11.4,20 11,18.2 8.4,15.6 4,17 5,13.6 1,12 5,10.5 3.5,6.8 8,8 7.5,4 10.4,5.5" fill="#C45A2C"></polygon><path d="M12 19.5V23.5" stroke="#C45A2C" stroke-width="1.4" stroke-linecap="round"></path></svg>
    <div class="wrap">
      <p class="label">Care all year</p>
      <h2 class="h">It starts with a fall cleanup</h2>
      <span class="brush">Then we keep it looking cared for, all year.</span>
      <ol class="timeline">
        <li class="season now">
          <div class="s-head"><span class="sicon" style="background:#C45A2C"><svg width="28" height="28" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12,1 13.6,5.5 16.5,4 16,8 20.5,6.8 19,10.5 23,12 19,13.6 20,17 15.6,15.6 13,18.2 12.6,20 11.4,20 11,18.2 8.4,15.6 4,17 5,13.6 1,12 5,10.5 3.5,6.8 8,8 7.5,4 10.4,5.5" fill="#F4EFE4"></polygon></svg></span><h3 class="cond">Fall</h3><span class="now-tag cond">Now</span></div>
          <ul><li><span class="gck" style="width:22px;height:22px;background:#E9E1CF"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#1F3A2B" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span>Leaf &amp; debris cleanup</li><li><span class="gck" style="width:22px;height:22px;background:#E9E1CF"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#1F3A2B" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span>Bed cleanup</li><li><span class="gck" style="width:22px;height:22px;background:#E9E1CF"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#1F3A2B" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span>Final mow</li><li><span class="gck" style="width:22px;height:22px;background:#E9E1CF"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#1F3A2B" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span>Aeration &amp; fertilization</li></ul>
        </li>
        <li class="season">
          <div class="s-head"><span class="sicon" style="background:#1F3A2B"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#F4EFE4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2v20M4.9 7l14.2 10M4.9 17 19.1 7"></path><path d="m9 4 3 2 3-2M9 20l3-2 3 2"></path></svg></span><h3 class="cond">Winter</h3></div>
          <ul><li><span class="gck" style="width:22px;height:22px;background:#E9E1CF"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#1F3A2B" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span>Plan next year's patio or outdoor living project</li><li><span class="gck" style="width:22px;height:22px;background:#E9E1CF"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#1F3A2B" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span>Get the design and written quote ready before spring</li></ul>
        </li>
        <li class="season">
          <div class="s-head"><span class="sicon" style="background:#1F3A2B"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#F4EFE4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 20h10"></path><path d="M12 20v-8"></path><path d="M12 12c0-3.5 2.5-6 6-6 0 3.5-2.5 6-6 6z"></path><path d="M12 14c0-3-2-5-5-5 0 3 2 5 5 5z"></path></svg></span><h3 class="cond">Spring</h3></div>
          <ul><li><span class="gck" style="width:22px;height:22px;background:#E9E1CF"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#1F3A2B" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span>Spring cleanups</li><li><span class="gck" style="width:22px;height:22px;background:#E9E1CF"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#1F3A2B" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span>Planting</li><li><span class="gck" style="width:22px;height:22px;background:#E9E1CF"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#1F3A2B" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span>Lawn maintenance starts</li></ul>
        </li>
        <li class="season">
          <div class="s-head"><span class="sicon" style="background:#1F3A2B"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#F4EFE4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg></span><h3 class="cond">Summer</h3></div>
          <ul><li><span class="gck" style="width:22px;height:22px;background:#E9E1CF"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#1F3A2B" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span>Mowing</li><li><span class="gck" style="width:22px;height:22px;background:#E9E1CF"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#1F3A2B" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span>Bed care</li><li><span class="gck" style="width:22px;height:22px;background:#E9E1CF"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#1F3A2B" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span>Keeping everything looking sharp</li></ul>
        </li>
      </ol>
    </div>
  </section>

  
  <section class="svc" id="cleanup">
    <div class="wrap svc-in">
      <div>
        <p class="label">Fall cleanup</p>
        <h2 class="h">What your fall cleanup includes</h2>
        <p class="lede">Tap each item to see what we do. We confirm the exact list with you at the free estimate.</p>
        <p class="also">We also offer year-round lawn &amp; garden maintenance, planting and hardscaping.</p>
      </div>
      <div class="pills">
        <details class="pill" open>
          <summary><span class="gck" style="width:30px;height:30px;background:#C9A46A"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#1F3A2B" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span><span class="pt">Leaf &amp; Debris Cleanup</span><span class="chev"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#C9A46A" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></span></summary>
          <p>Leaves, sticks and debris blown, collected and hauled away from lawn, beds and hard surfaces.</p>
        </details>
        <details class="pill">
          <summary><span class="gck" style="width:30px;height:30px;background:#C9A46A"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#1F3A2B" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span><span class="pt">Bed Cleanup &amp; Refresh</span><span class="chev"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#C9A46A" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></span></summary>
          <p>Beds cleared out, cut back and tidied so they look finished through winter.</p>
        </details>
        <details class="pill">
          <summary><span class="gck" style="width:30px;height:30px;background:#C9A46A"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#1F3A2B" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span><span class="pt">Final Mow &amp; Edges</span><span class="chev"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#C9A46A" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></span></summary>
          <p>The last cut of the season, with clean edges along walks and beds.</p>
        </details>
        <details class="pill">
          <summary><span class="gck" style="width:30px;height:30px;background:#C9A46A"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#1F3A2B" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span><span class="pt">Aeration &amp; Fertilization</span><span class="chev"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#C9A46A" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></span></summary>
          <p>Helps your lawn come back thicker and stronger in spring.</p>
        </details>
      </div>
    </div>
  </section>

  <NewClientOffer
    id="new-client-offer"
    service="landscape cleanup"
    chips={['Leaf & debris cleanup', 'Bed cleanup & refresh', 'Final mow & edges', 'Aeration & fertilization']}
    label="Claim 20% Off Your First Cleanup"
    href="/lp/landscape-cleanup-quote"
    track="estimate_click"
    terms="*Valid on your first landscape cleanup with Euro Style Landscape. New clients only."
  />

  
  <section class="og">
    <div class="wrap og-in">
      <div>
        <h2>From overgrown<span>to outstanding</span></h2>
        <div class="rule"></div>
        <p>Leaves cleared, beds cleaned up and the lawn cut, so your property looks cared for through the winter.</p>
      </div>
      <figure>
        <div class="frame"><Image src={photo('front-yard-work.jpg')} alt="A front yard being cleared and regraded by the Euro Style crew" widths={[480, 800, 1200, 1600]} sizes="(min-width: 1024px) 50vw, 100vw" format="webp" quality={70} decoding="async" loading="lazy" /></div>
        <figcaption>Real Euro Style front yard project.</figcaption>
      </figure>
    </div>
  </section>

  
  <section class="why">
    <div class="wrap why-in">
      <div>
        <p class="label">Why homeowners choose us</p>
        <h2 class="h">Dependable from the first visit</h2>
      </div>
      <ul>
        <li><span class="gck" style="width:40px;height:40px;background:#C9A46A"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1F3A2B" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span><span class="cond">One local team</span></li>
        <li><span class="gck" style="width:40px;height:40px;background:#C9A46A"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1F3A2B" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span><span class="cond">Free on-site consultation</span></li>
        <li><span class="gck" style="width:40px;height:40px;background:#C9A46A"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1F3A2B" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span><span class="cond">Detailed written quotes</span></li>
        <li><span class="gck" style="width:40px;height:40px;background:#C9A46A"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1F3A2B" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span><span class="cond">Ongoing maintenance available</span></li>
      </ul>
    </div>
  </section>

  
  <section class="team">
    <div class="wrap team-in">
      <div class="frame"><Image src={photo('team-3.jpg')} alt="The Euro Style Landscape crew standing together on a job site" widths={[480, 800, 1200, 1600]} sizes="(min-width: 1024px) 50vw, 100vw" format="webp" quality={70} decoding="async" loading="lazy" /></div>
      <div>
        <p class="label">Meet the team</p>
        <h2 class="h">The crew behind every yard</h2>
        <p>Based in Sayreville. The same local crew from the first visit to the final clean-up.</p>
      </div>
    </div>
  </section>

  
  <section class="cta">
    <svg class="leaf d" style="left:6%;top:18%;width:26px;height:26px;--r:-24deg;animation-delay:0s" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12,1 13.6,5.5 16.5,4 16,8 20.5,6.8 19,10.5 23,12 19,13.6 20,17 15.6,15.6 13,18.2 12.6,20 11.4,20 11,18.2 8.4,15.6 4,17 5,13.6 1,12 5,10.5 3.5,6.8 8,8 7.5,4 10.4,5.5" fill="#C45A2C"></polygon><path d="M12 19.5V23.5" stroke="#C45A2C" stroke-width="1.4" stroke-linecap="round"></path></svg>
    <svg class="leaf d" style="left:92%;top:64%;width:22px;height:22px;--r:30deg;animation-delay:3s" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12,1 13.6,5.5 16.5,4 16,8 20.5,6.8 19,10.5 23,12 19,13.6 20,17 15.6,15.6 13,18.2 12.6,20 11.4,20 11,18.2 8.4,15.6 4,17 5,13.6 1,12 5,10.5 3.5,6.8 8,8 7.5,4 10.4,5.5" fill="#C9A46A"></polygon><path d="M12 19.5V23.5" stroke="#C9A46A" stroke-width="1.4" stroke-linecap="round"></path></svg>
    <div class="wrap">
      <div class="gr"></div>
      <h2>Ready for a cleaner yard before winter?</h2>
      <OfferLine text="New clients save 20% on their first landscape cleanup." />
      <a href="/lp/landscape-cleanup-quote" class="btn-gold" data-track="estimate_click" data-track-location="cta_band">Book Your Free Cleanup Estimate <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"></path></svg></a>
      <a href="tel:+17328039646" class="call" data-track-location="cta_band">Or call (732) 803-9646</a>
    </div>
  </section>

  
  <footer class="foot">
    <div class="wrap">
      <div class="foot-in">
        <Image src={logo} alt="Euro Style Landscape" width={118} height={118} densities={[1, 2]} loading="eager" class="es-logo" />
        <ul>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C9A46A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"></path></svg><a href="tel:+17328039646" data-track-location="footer">(732) 803-9646</a></li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C9A46A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg><a href="/">eurostylelandscape.com</a></li>
