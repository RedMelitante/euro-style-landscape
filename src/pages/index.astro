---
// Home (handoff update 6 §4 and update 7 §5). Body: src/components/pages/home.astro.
import BaseLayout from '../layouts/BaseLayout.astro';
import Home from '../components/pages/home.astro';
import { EMAIL } from '../lib/site';
import { groups } from '../lib/services';
import { business, faqPage } from '../lib/schema';

const site = Astro.site!;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    business(site, {
      email: EMAIL,
      logo: new URL('/logo.webp', site).href,
      areaServed: { '@type': 'AdministrativeArea', name: 'Middlesex County, NJ' },
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Landscape services',
        itemListElement: groups.map((g) => ({
          '@type': 'OfferCatalog',
          name: g.title,
          itemListElement: g.items.map((i) => ({
            '@type': 'Offer',
            itemOffered: { '@type': 'Service', name: i.title, description: i.text },
          })),
        })),
      },
    }),
    faqPage('home'),
  ],
};
---
<BaseLayout
  title="Euro Style Landscape · Landscape Design & Build in Middlesex County, NJ"
  description="European-style patios, retaining walls, decks, planting and garden care — designed and built by one local team. Book a free on-site consultation."
  current="home"
  ogPhoto="front-lawn-beds.jpg"
  jsonLd={jsonLd}
>
  <Home />
</BaseLayout>
