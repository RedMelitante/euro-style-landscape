---
// About. Body: src/components/pages/about.astro.
import BaseLayout from '../layouts/BaseLayout.astro';
import About from '../components/pages/about.astro';
import { business, breadcrumbs } from '../lib/schema';

const site = Astro.site!;
const jsonLd = { '@context': 'https://schema.org', '@graph': [business(site), breadcrumbs(site, ['About', '/about'])] };
---
<BaseLayout
  title="About Us · Euro Style Landscape"
  description="Meet the crew behind Euro Style Landscape: European-inspired landscape design and construction, from the first sketch to the final clean-up."
  current="about"
  jsonLd={jsonLd}
>
  <About />
</BaseLayout>
