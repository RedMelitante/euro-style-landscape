---
// NEW CLIENT OFFER: dark banner under the Home hero and after the services cards on the
// town pages (UPDATE-4-SITE.md §4). Hidden while NEW_CLIENT_OFFER_ON is false.
import Icon from '../Icon.astro';
import { NEW_CLIENT_OFFER_ON, NEW_CLIENT_OFFER_TERMS } from '../../lib/campaigns';
import { PHONE_DISPLAY, PHONE_HREF } from '../../lib/site';

interface Props {
  /** 'call' (the Cleanups service page): Claim 20% off + Call, instead of See cleanup services + Claim 20% off. */
  buttons?: 'default' | 'call';
}

const { buttons = 'default' } = Astro.props;
---
{NEW_CLIENT_OFFER_ON && (
  <section aria-label="New client special" class="offer-banner">
    <div class="container ob-inner">
      <div class="ob-copy">
        <span class="ob-pill"><Icon name="tag" size={16} strokeWidth={2.4} />New client special</span>
        <p class="ob-head"><span class="gold">20% off</span> your first cleanup or property refresh</p>
        <p class="ob-list">Property cleanups · Leaf cleanups · Landscape cleanups · Property refresh</p>
        <p class="ob-terms">{NEW_CLIENT_OFFER_TERMS}</p>
      </div>
      <div class="ob-btns">
        {buttons === 'call' ? (
          <>
            <a href="#quote" class="btn btn-sand ob-btn">Claim 20% off</a>
            <a href={PHONE_HREF} class="btn btn-ghost-light ob-btn">Call {PHONE_DISPLAY}</a>
          </>
        ) : (
          <>
            <a href="/services/cleanups" class="btn btn-sand ob-btn">See cleanup services</a>
            <a href="#quote" class="btn btn-ghost-light ob-btn">Claim 20% off <Icon name="arrow-right" size={18} strokeWidth={2.2} /></a>
          </>
        )}
      </div>
    </div>
  </section>
)}

<style>
  .offer-banner { background: var(--forest-800); color: var(--on-dark); border-top: 3px solid var(--sand-500); padding: clamp(28px, 4vw, 40px) 0; }
  .ob-inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px 40px; }
  .ob-copy { flex: 1 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 10px; }
  .ob-pill {
    display: inline-flex; align-items: center; gap: 8px; align-self: flex-start; padding: 6px 14px; border-radius: 999px;
    background: var(--sand-500); color: var(--charcoal); font-size: 13px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase;
  }
  .ob-head { margin: 0; font-size: clamp(1.5rem, 1.2rem + 1.1vw, 2.125rem); line-height: 1.15; font-weight: 800; letter-spacing: -0.015em; }
  .gold { color: var(--sand-500); }
  .ob-list { margin: 0; font-size: 15px; line-height: 1.55; color: #E4E0D6; }
  .ob-terms { margin: 0; font-size: 13px; line-height: 1.5; color: var(--on-dark-muted); }
  .ob-btns { flex: 0 1 auto; display: flex; flex-wrap: wrap; gap: 12px; width: min(100%, 460px); }
  .ob-btn { flex: 1 1 200px; height: 54px; padding: 0 22px; font-size: 16px; white-space: nowrap; }
</style>
