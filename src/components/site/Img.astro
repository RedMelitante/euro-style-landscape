---
// Photo from src/assets/images through Astro's image pipeline: AVIF/WebP srcset, lazy unless `eager`.
// No inline size styles, so the design CSS (.ph img, .hero img, ...) positions it.
import { Picture } from 'astro:assets';
import { photo } from '../../lib/images';

interface Props {
  src: string;
  alt: string;
  sizes?: string;
  /** Above the fold: load eagerly. */
  eager?: boolean;
  /** The page's main (LCP) image: fetchpriority="high". */
  priority?: boolean;
  class?: string;
  style?: string;
}
const { src, alt, sizes = '(min-width: 1200px) 600px, (min-width: 1024px) 50vw, 100vw', eager = false, priority = false, class: cls, style } = Astro.props;
const img = photo(src);
const maxW = Math.min(img.width, 1920);
const widths = [400, 640, 960, 1280, 1600].filter((w) => w < maxW).concat(maxW);
---
<Picture
  src={img}
  alt={alt}
  formats={['avif', 'webp']}
  widths={widths}
  sizes={sizes}
  loading={eager ? 'eager' : 'lazy'}
  decoding={eager ? 'auto' : 'async'}
  fetchpriority={priority ? 'high' : undefined}
  class={cls}
  style={style}
/>
