---
// Responsive project photo: AVIF/WebP with a JPEG fallback, lazy by default.
// `style` is applied to the <img> after a default `height:auto`, which stops the
// intrinsic height attribute from overriding CSS aspect-ratio. The <picture> wrapper is display:contents
// so the image lays out exactly like the plain <img> in the designs.
import { Picture } from 'astro:assets';
import { photo } from '../lib/images';

interface Props {
  src: string;
  alt: string;
  sizes: string;
  style?: string;
  class?: string;
  eager?: boolean;
  priority?: boolean;
  draggable?: 'true' | 'false';
}

const { src, alt, sizes, style, class: cls, eager = false, priority = false, draggable } = Astro.props;
const meta = photo(src);
const maxW = Math.min(meta.width, 1600);
const widths = [400, 640, 960, 1280].filter((w) => w < maxW).concat(maxW);
---
<Picture
  src={meta}
  alt={alt}
  formats={['avif', 'webp']}
  widths={widths}
  sizes={sizes}
  quality={70}
  loading={eager ? 'eager' : 'lazy'}
  decoding="async"
  fetchpriority={priority ? 'high' : undefined}
  draggable={draggable}
  class={cls}
  style={`height:auto;${style ?? ''}`}
  pictureAttributes={{ style: 'display:contents' }}
/>
