---
import Logo from './Logo.astro';
import { EMAIL, LOCATION, PHONE_DISPLAY, PHONE_HREF, SERVICE_AREA } from '../lib/site';
import { footerLinks } from '../lib/services';

interface Props {
  /** Ad landing version: contact details only, no site navigation. */
  minimal?: boolean;
}

const { minimal = false } = Astro.props;
---
<footer class="site-footer" style={`padding:${minimal ? 48 : 56}px 0 0`}>
  <div class="container cols" style={`--col:${minimal ? 240 : 220}px`}>
    <div class="col" style="gap:14px">
      <Logo size="footer" />
      <p class="tagline">European-inspired landscape design and construction.</p>
    </div>
    {minimal ? (
      <>
        <div class="col">
          <span class="col-title">Get in touch</span>
          <a href={PHONE_HREF} class="plain">{PHONE_DISPLAY}</a>
          <a href={`mailto:${EMAIL}`} class="plain">{EMAIL}</a>
          <span>{LOCATION}</span>
        </div>
        <div class="col">
          <span class="col-title">Areas we serve</span>
          <span style="line-height:1.6">{SERVICE_AREA}</span>
        </div>
      </>
    ) : (
      <>
        <nav aria-label="Services" class="col">
          <span class="col-title">Services</span>
          {footerLinks.map((l) => <a href={l.href} class="foot-link">{l.label}</a>)}
        </nav>
        <nav aria-label="Company" class="col">
          <span class="col-title">Company</span>
          <a href="/about" class="foot-link">About us</a>
          <a href="/our-work" class="foot-link">Our work</a>
          <a href="/contact" class="foot-link">Contact</a>
        </nav>
        <div class="col">
          <span class="col-title">Get in touch</span>
          <a href={PHONE_HREF} class="foot-link">{PHONE_DISPLAY}</a>
          <a href={`mailto:${EMAIL}`} class="foot-link">{EMAIL}</a>
          <span>{LOCATION}</span>
        </div>
      </>
    )}
  </div>
  <div class="container legal">
    <span>Powered by <a href="https://www.digitalservicesmaster.com/" class="credit">Digital Services Master</a> Copyright © 2026. All rights reserved</span>
    {minimal
      ? <a href="/privacy-policy" style="color:#BDC3B8">Privacy policy</a>
      : <a href="/privacy-policy" class="foot-link">Privacy policy</a>}
  </div>
</footer>

<style>
  .site-footer { background: var(--forest-900); color: var(--on-dark-muted); }
  .cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(var(--col), 100%), 1fr)); gap: 32px; }
  .col { display: flex; flex-direction: column; gap: 10px; font-size: 15px; }
  .col-title { color: var(--on-dark); font-weight: 600; font-size: 16px; }
  .tagline { margin: 0; font-size: 15px; line-height: 1.6; }
  .plain { color: var(--on-dark-muted); text-decoration: none; }
  .col a { overflow-wrap: anywhere; }
  .legal {
    margin-top: 40px; padding-top: 20px; padding-bottom: 28px;
    border-top: 1px solid rgba(243, 239, 230, .1);
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; font-size: 14px;
  }
  .credit { color: var(--on-dark); text-decoration: underline; }
  .credit:hover { color: var(--on-dark); }
</style>
