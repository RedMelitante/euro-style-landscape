---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { NAV, PHONE_DISPLAY, PHONE_HREF, type NavKey } from '../lib/site';
import { serviceHref, servicePages } from '../lib/servicePages';

interface Props {
  current: NavKey;
  /** '#quote' on pages with a form, '/contact' elsewhere. */
  quoteHref: string;
  /** Key of the service page being shown, highlighted in the Services menus (UPDATE-5-SITE.md §3). */
  currentService?: string;
}

const { current, quoteHref, currentService } = Astro.props;
const color = (on: boolean) => `color:${on ? '#C9A46A' : '#F3EFE6'}`;
---
<header class="site-header">
  <div class="container bar">
    <a href="/" aria-label="Euro Style Landscape home" class="brand"><Logo /></a>
    <nav class="d-only main-nav" aria-label="Main">
      {NAV.map((item) => item.key === 'services' ? (
        <div class="nav-dd" data-nav-dd>
          <a
            href={item.href}
            class="nav-link dd-trigger"
            aria-haspopup="true"
            aria-expanded="false"
            aria-current={item.key === current && !currentService ? 'page' : undefined}
            style={color(item.key === current)}
            data-dd-trigger
          >{item.label} <span class="dd-chev"><Icon name="chevron-down" size={16} strokeWidth={2.2} /></span></a>
          <div class="dd-menu">
            {servicePages.map((sp) => (
              <a href={serviceHref(sp.key)} class:list={{ 'dd-current': sp.key === currentService }} aria-current={sp.key === currentService ? 'page' : undefined}>{sp.menu}</a>
            ))}
            <a href="/services" class="dd-all">All services <Icon name="arrow-right" size={14} strokeWidth={2.2} /></a>
          </div>
        </div>
      ) : (
        <a
          href={item.href}
          class="nav-link"
          aria-current={item.key === current ? 'page' : undefined}
          style={color(item.key === current)}
        >{item.label}</a>
      ))}
    </nav>
    <div class="actions">
      <a href={PHONE_HREF} class="d-only phone-wide nav-link phone">
        <Icon name="phone" size={18} stroke="#C9A46A" />
        {PHONE_DISPLAY}
      </a>
      <a href={quoteHref} class="d-only btn btn-sand quote">Get a quote</a>
      <a href={PHONE_HREF} class="m-only icon-btn" aria-label="Call Euro Style Landscape">
        <Icon name="phone" size={20} />
      </a>
      <button type="button" class="m-only icon-btn" aria-label="Menu" aria-expanded="false" aria-controls="mobile-nav" data-menu-toggle>
        <Icon name="menu" size={20} />
      </button>
    </div>
  </div>
  <nav id="mobile-nav" class="m-only mobile-nav" aria-label="Mobile" hidden>
    {NAV.map((item) => (
      <>
        <a
          href={item.href}
          aria-current={item.key === current && !(item.key === 'services' && currentService) ? 'page' : undefined}
          style={color(item.key === current)}
        >{item.label}</a>
        {item.key === 'services' && (
          <div class="m-sub">
            {servicePages.map((sp) => (
              <a href={serviceHref(sp.key)} aria-current={sp.key === currentService ? 'page' : undefined} style={`color:${sp.key === currentService ? '#C9A46A' : '#BDC3B8'}`}>{sp.menu}</a>
            ))}
          </div>
        )}
      </>
    ))}
    <a href={quoteHref} class="btn btn-sand mobile-quote">Get a free quote</a>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('mobile-nav');
  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
    };
    toggle.addEventListener('click', () => setOpen(!!menu.hidden));
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) { setOpen(false); toggle.focus(); }
    });
  }

  // Desktop Services dropdown: CSS opens it on hover and keyboard focus. On touch screens (tablets
  // see the desktop menu) the first tap on "Services" opens it and a second tap follows the link.
  document.querySelectorAll<HTMLElement>('[data-nav-dd]').forEach((dd) => {
    const trigger = dd.querySelector<HTMLAnchorElement>('[data-dd-trigger]')!;
    const setOpen = (open: boolean) => {
      dd.classList.toggle('open', open);
      trigger.setAttribute('aria-expanded', String(open));
    };
    let touch = false;
    trigger.addEventListener('pointerdown', (e) => { touch = e.pointerType === 'touch'; });
    trigger.addEventListener('click', (e) => {
      if (touch && !dd.classList.contains('open')) { e.preventDefault(); setOpen(true); }
    });
    dd.addEventListener('mouseenter', () => trigger.setAttribute('aria-expanded', 'true'));
    dd.addEventListener('mouseleave', () => { if (!dd.classList.contains('open')) trigger.setAttribute('aria-expanded', 'false'); });
    dd.addEventListener('focusin', () => trigger.setAttribute('aria-expanded', 'true'));
    dd.addEventListener('focusout', (e) => {
      if (!dd.contains(e.relatedTarget as Node)) setOpen(false);
    });
    document.addEventListener('click', (e) => { if (!dd.contains(e.target as Node)) setOpen(false); });
    dd.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') { setOpen(false); (document.activeElement as HTMLElement | null)?.blur(); trigger.focus(); dd.classList.add('closed'); }
    });
    trigger.addEventListener('focus', () => dd.classList.remove('closed'));
    dd.addEventListener('mouseleave', () => dd.classList.remove('closed'));
  });
</script>

<style>
  .site-header { position: relative; z-index: 10; background: var(--forest-800); border-bottom: 1px solid var(--forest-700); }
  .bar { height: var(--header-h); display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .brand { display: flex; align-items: center; text-decoration: none; }
  .main-nav { display: flex; align-items: center; gap: 32px; font-size: 16px; }
  .main-nav a { text-decoration: none; }
  /* Services dropdown: opens on hover and keyboard focus (and on tap, via the script). */
  .main-nav { align-self: stretch; }
  .nav-dd { position: relative; display: flex; align-items: center; align-self: stretch; }
  .dd-trigger { display: flex; align-items: center; gap: 6px; }
  .dd-chev { display: flex; transition: transform .15s; }
  .dd-menu {
    position: absolute; top: 100%; left: 50%; transform: translateX(-50%); min-width: 270px; background: var(--white);
    border-radius: 12px; box-shadow: 0 18px 40px rgba(17, 22, 18, .22); padding: 8px; display: none; flex-direction: column; z-index: 40;
  }
  .dd-menu::before { content: ""; position: absolute; top: -8px; left: 0; right: 0; height: 8px; }
  .nav-dd:hover .dd-menu, .nav-dd:focus-within .dd-menu, .nav-dd.open .dd-menu { display: flex; }
  .nav-dd.closed .dd-menu { display: none; }
  .nav-dd:hover .dd-chev, .nav-dd:focus-within .dd-chev, .nav-dd.open .dd-chev { transform: rotate(180deg); }
  .dd-menu a { display: block; padding: 10px 12px; border-radius: 8px; color: var(--ink); font-size: 15px; font-weight: 600; white-space: nowrap; }
  .dd-menu a:hover, .dd-menu a:focus-visible { background: var(--stone-50); color: var(--green-700); }
  .dd-menu a.dd-current { background: var(--mint-100); color: var(--green-700); }
  .dd-menu a.dd-all { display: flex; align-items: center; gap: 6px; margin-top: 4px; padding-top: 12px; border-top: 1px solid var(--line); border-radius: 0 0 8px 8px; color: var(--green-700); }
  .actions { display: flex; align-items: center; gap: 12px; }
  .phone { display: flex; align-items: center; gap: 8px; color: var(--on-dark); text-decoration: none; font-size: 15px; font-weight: 600; white-space: nowrap; }
  .quote { height: 44px; padding: 0 18px; font-size: 15px; font-weight: 600; white-space: nowrap; }
  .icon-btn {
    display: flex; width: 44px; height: 44px; align-items: center; justify-content: center;
    border: 1px solid rgba(243, 239, 230, .45); border-radius: 8px;
    background: transparent; color: var(--on-dark); cursor: pointer;
  }
  .icon-btn:hover { color: var(--on-dark); }
  .mobile-nav { display: flex; flex-direction: column; gap: 2px; padding: 8px 16px 20px; border-top: 1px solid var(--forest-700); }
  .mobile-nav a:not(.btn) { display: flex; align-items: center; min-height: 48px; text-decoration: none; font-size: 17px; font-weight: 600; }
  .mobile-quote { margin-top: 10px; height: 52px; font-size: 16px; }
  .m-sub { display: flex; flex-direction: column; margin: 0 0 6px 4px; padding-left: 14px; border-left: 2px solid var(--forest-700); }
  .mobile-nav .m-sub a { min-height: 44px; font-size: 16px; font-weight: 500; }
</style>
