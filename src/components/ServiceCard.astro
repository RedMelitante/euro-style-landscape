---
// One service from services.json. The variant follows the data:
//   featured + image → wide feature card (photo left, text right)
//   image            → photo card
//   icon only        → icon card (no client photo yet)
// variant="mini" is the compact lawn-maintenance card.
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import { photoBg } from '../lib/images';
import type { ServiceItem } from '../lib/services';

interface Props {
  item: ServiceItem;
  variant?: 'mini';
  /** Put the item id on the card itself (Fencing / Planting / Landscape install anchors). */
  anchor?: boolean;
  class?: string;
}

const { item, variant, anchor = false, class: cls } = Astro.props;
const kind = variant === 'mini' ? 'mini' : item.image ? (item.featured ? 'feature' : 'photo') : 'icon';
const id = anchor ? item.id : undefined;
---
{kind === 'feature' && (
  <article id={id} class:list={['card', 'feature', cls]}>
    <div class="feature-img" style={`background-color:${photoBg(item.image!)}`}>
      <Photo src={item.image!} alt={item.alt!} sizes="(min-width: 1280px) 420px, (min-width: 768px) 40vw, 92vw" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover" />
      <span class="pill-sand badge">Starts with a free consultation</span>
    </div>
    <div class="feature-body">
      <h3 class="feature-title">{item.title}</h3>
      <p class="body-muted">{item.text}</p>
      {item.link && <a href={item.link.href} class="more">{item.link.label}<Icon name="arrow-right" size={14} strokeWidth={2.2} /></a>}
    </div>
  </article>
)}
{kind === 'photo' && (
  <article id={id} class:list={['card', 'photo', cls]}>
    <Photo src={item.image!} alt={item.alt!} sizes="(min-width: 1280px) 400px, (min-width: 768px) 45vw, 92vw" style={`display:block;width:100%;aspect-ratio:4 / 3;object-fit:cover;background-color:${photoBg(item.image!)}`} />
    <div class="photo-body">
      <h3 class="title">{item.title}</h3>
      <p class="body-muted">{item.text}</p>
      {item.link && <a href={item.link.href} class="more">{item.link.label}<Icon name="arrow-right" size={14} strokeWidth={2.2} /></a>}
    </div>
  </article>
)}
{kind === 'icon' && (
  <article id={id} class:list={['card', 'icon-card', cls]}>
    <span class="icon-circle disc-mint"><Icon name={item.icon ?? 'check'} size={24} /></span>
    <h3 class="icon-title">{item.title}</h3>
    <p class="body-muted">{item.text}</p>
  </article>
)}
{kind === 'mini' && (
  <div id={id} class:list={['mini', cls]}>
    <span class="icon-circle disc-green"><Icon name={item.icon ?? 'check'} size={22} /></span>
    <span class="stack" style="gap:4px">
      <span class="mini-title">{item.title}</span>
      <span class="mini-text">{item.text}</span>
    </span>
  </div>
)}

<style>
  .feature { display: flex; flex-wrap: wrap; }
  .feature-img { position: relative; flex: 1 1 320px; min-height: 260px; }
  .badge { position: absolute; top: 16px; left: 16px; }
  .feature-body { flex: 1 1 260px; padding: clamp(22px, 3vw, 32px); display: flex; flex-direction: column; gap: 12px; }
  .feature-title { margin: 0; font-size: clamp(1.375rem, 1.2rem + .5vw, 1.75rem); line-height: 1.25; font-weight: 700; }
  .photo { display: flex; flex-direction: column; }
  .photo-body { padding: 22px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
  .title { margin: 0; font-size: 22px; line-height: 1.3; font-weight: 600; }
  .more { margin-top: auto; padding-top: 6px; display: flex; align-items: center; gap: 6px; font-size: 15px; font-weight: 600; min-height: 44px; }
  .icon-card { overflow: visible; padding: 22px; display: flex; flex-direction: column; gap: 12px; }
  .disc-mint { width: 52px; height: 52px; background: var(--mint-100); color: var(--green-700); }
  .icon-title { margin: 0; font-size: 20px; line-height: 1.3; font-weight: 600; }
  .mini { background: var(--stone-50); border: 1px solid var(--line); border-radius: 12px; padding: 18px; display: flex; gap: 14px; align-items: flex-start; }
  .disc-green { width: 44px; height: 44px; background: var(--green-600); color: var(--white); }
  .mini-title { font-size: 17px; font-weight: 600; }
  .mini-text { font-size: 15px; line-height: 1.55; color: var(--ink-muted); }
</style>
