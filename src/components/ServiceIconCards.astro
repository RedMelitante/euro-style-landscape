---
// The 3 icon cards under the photo service cards on Home and the town pages, so those overviews
// show all 7 services (UPDATE-5-SITE.md §6). Each links to its service page.
import Icon, { type IconName } from './Icon.astro';
import { serviceHref } from '../lib/servicePages';

const cards: { key: string; icon: IconName; title: string; text: string; cta: string }[] = [
  { key: 'cleanups', icon: 'rake', title: 'Cleanups & property refresh', text: 'Property, leaf and landscape cleanups, plus property refreshes that give a tired yard a fresh, finished look.', cta: 'Cleanups & refresh' },
  { key: 'snow-removal', icon: 'snowflake', title: 'Snow removal', text: 'Plowing, shoveling, salting and de-icing, plus seasonal snow contracts so winter is covered.', cta: 'Snow removal' },
  { key: 'commercial', icon: 'building', title: 'Commercial services', text: 'Grounds care, snow removal, small construction and cleanups for commercial properties, with one call and one invoice.', cta: 'Commercial services' },
];
---
<div class="grid-auto" style="--min:300px;--gap:20px">
  {cards.map((c) => (
    <article class="card ic-card">
      <span aria-hidden="true" class="ic-box"><Icon name={c.icon} size={26} /></span>
      <h3 class="ic-title">{c.title}</h3>
      <p class="body-muted">{c.text}</p>
      <a href={serviceHref(c.key)} class="btn btn-sm btn-outline ic-cta">{c.cta} <Icon name="arrow-up-right" size={14} strokeWidth={2.2} /></a>
    </article>
  ))}
</div>

<style>
  .ic-card { padding: 24px; display: flex; flex-direction: column; gap: 12px; }
  .ic-box { width: 52px; height: 52px; border-radius: 12px; background: var(--sage-100); color: var(--green-700); display: flex; align-items: center; justify-content: center; }
  .ic-title { margin: 0; font-size: 22px; line-height: 1.3; font-weight: 700; }
  .ic-cta { align-self: flex-start; margin-top: auto; }
</style>
