---
import BeforeAfter from './BeforeAfter.astro';
import Photo from './Photo.astro';

type Img = { src: string; alt: string; label?: string };
export type Project =
  | { id: string; title: string; category: string; kind: 'pair'; before: Img; after: Img }
  | { id: string; title: string; category: string; kind: 'single'; image: Img };

interface Props {
  project: Project;
  categoryLabel: string;
}

const { project: p, categoryLabel } = Astro.props;
const sizes = '(min-width: 1280px) 390px, (min-width: 800px) 45vw, 92vw';
---
<article class="card-p" data-cat={p.category}>
  {p.kind === 'pair' ? (
    <BeforeAfter
      beforeSrc={p.before.src}
      afterSrc={p.after.src}
      before={p.before.alt}
      after={p.after.alt}
      beforeLabel={p.before.label}
      afterLabel={p.after.label}
      ratio="4 / 3"
      sizes={sizes}
    />
  ) : (
    <Photo src={p.image.src} alt={p.image.alt} sizes={sizes} style="display:block;width:100%;aspect-ratio:4 / 3;object-fit:cover;border-radius:12px" />
  )}
  <div class="meta">
    <h3>{p.title}</h3>
    <span class="tag">{categoryLabel}</span>
  </div>
</article>

<style>
  .card-p { background: var(--white); border: 1px solid var(--line); border-radius: 16px; padding: 12px; display: flex; flex-direction: column; gap: 12px; }
  .meta { display: flex; flex-direction: column; gap: 10px; padding: 4px 6px 6px; }
  h3 { margin: 0; font-size: 18px; line-height: 1.35; font-weight: 600; }
</style>
