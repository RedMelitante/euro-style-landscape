---
// Client logo (assets/logo/euro-style-landscape-logo.jpg). Its background is --forest-800,
// so it sits seamlessly in the header; on the darker footer it reads as a rounded tile.
import { Image } from 'astro:assets';
import logo from '../assets/logo/euro-style-landscape-logo.jpg';

interface Props {
  size?: 'header' | 'footer';
}

const { size = 'header' } = Astro.props;
const px = size === 'header' ? 76 : 112;
---
<Image
  src={logo}
  alt="Euro Style Landscape"
  width={px}
  height={px}
  densities={[1, 2]}
  loading="eager"
  class:list={['logo', size]}
/>

<style>
  .logo { display: block; flex: none; }
  .header { width: 76px; height: 76px; }
  .footer { width: 112px; height: 112px; border-radius: 10px; }
  @media (max-width: 767px) { .header { width: 64px; height: 64px; } }
</style>
