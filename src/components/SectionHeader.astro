---
import Icon from './Icon.astro';
// Theme section header: H2 left; kicker, description and optional link right;
// green divider below. `badge` adds the sand pill above the H2. Without a
// kicker the description sits alone on the right.
interface Props {
  title: string;
  kicker?: string;
  description: string;
  link?: { href: string; label: string };
  badge?: string;
  /** Links under the description, e.g. "See the full construction page" on /services. */
  pageLinks?: { href: string; label: string }[];
}

const { title, kicker, description, link, badge, pageLinks = [] } = Astro.props;
---
<div class="sh">
  {badge ? (
    <div class="left stack" style="gap:12px">
      <span class="pill-sand">{badge}</span>
      <h2 class="h2">{title}</h2>
    </div>
  ) : (
    <h2 class="h2 left">{title}</h2>
  )}
  {kicker ? (
    <div class="right">
      {link ? (
        <div class="kicker-row">
          <p class="kicker">{kicker}</p>
          <a href={link.href} class="more">{link.label}</a>
        </div>
      ) : (
        <p class="kicker">{kicker}</p>
      )}
      <p class="body-muted">{description}</p>
      {pageLinks.map((l) => <a href={l.href} class="page-link">{l.label} <Icon name="arrow-right" size={14} strokeWidth={2.2} /></a>)}
    </div>
  ) : pageLinks.length ? (
    <div class="right" style="gap:6px">
      <p class="body-muted">{description}</p>
      {pageLinks.map((l) => <a href={l.href} class="page-link">{l.label} <Icon name="arrow-right" size={14} strokeWidth={2.2} /></a>)}
    </div>
  ) : (
    <p class="body-muted right">{description}</p>
  )}
</div>
<div class="rule"></div>

<style>
  .sh { display: flex; flex-wrap: wrap; gap: 24px 48px; align-items: flex-end; justify-content: space-between; }
  .left { flex: 1 1 480px; }
  .right { flex: 1 1 420px; display: flex; flex-direction: column; gap: 8px; }
  .kicker-row { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; }
  .more { font-size: 15px; color: var(--green-700); }
  .page-link { align-self: flex-start; display: flex; align-items: center; gap: 6px; min-height: 44px; font-size: 15px; font-weight: 600; color: var(--green-700); }
</style>
