---
// Gold "New client special · 20% off" pill in a campaign page's hero. Hidden while the offer is off.
import { NEW_CLIENT_OFFER_ON } from '../../../lib/campaigns';
import '../../../styles/campaign-offer.css';

interface Props {
  text?: string;
  /** The page's own badge class instead of .hero-offer (/lp/property-cleanup-quote). */
  class?: string;
}

const { text = 'New client special · 20% off', class: cls = 'hero-offer' } = Astro.props;
---
{NEW_CLIENT_OFFER_ON && (
  <span class={cls}><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z"></path><circle cx="7.5" cy="7.5" r="1.5"></circle></svg>{text}</span>
)}
