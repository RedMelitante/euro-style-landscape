---
// Home hero: one large and two small real-project photos. Above the fold,
// so all three load eagerly and the large one gets fetchpriority="high".
import Photo from './Photo.astro';
import Icon from './Icon.astro';

const fill = 'display:block;width:100%;height:100%;object-fit:cover';
---
<div class="mosaic">
  <div class="tile big" style="background-color:#4C6A4B">
    <Photo
      src="hero-firepit-patio.jpg"
      alt="Circular paver patio with a curved stone seat wall"
      sizes="(min-width: 1280px) 400px, (min-width: 1100px) 32vw, 58vw"
      style={`${fill};object-position:50% 60%`}
      eager
      priority
    />
    <span class="chip">
      <Icon name="check" size={14} stroke="#2F6844" strokeWidth={2.4} />
      Real Euro Style projects
    </span>
  </div>
  <div class="tile" style="background-color:#1B1F1B">
    <Photo src="raised-patio-night.jpg" alt="Raised paver patio at night with lit steps" sizes="(min-width: 1280px) 280px, (min-width: 1100px) 22vw, 40vw" style={fill} eager />
  </div>
  <div class="tile" style="background-color:#4C6A4B">
    <Photo src="front-walkway.jpg" alt="Curved paver walkway to a brick-front home" sizes="(min-width: 1280px) 280px, (min-width: 1100px) 22vw, 40vw" style={`${fill};object-position:50% 70%`} eager />
  </div>
</div>

<style>
  .mosaic {
    flex: 1.25 1 520px; min-width: 0; display: grid; grid-template-columns: 1.45fr 1fr; grid-template-rows: 1fr 1fr;
    gap: 12px; height: clamp(360px, 40vw, 560px);
  }
  .tile { position: relative; border-radius: 18px; overflow: hidden; }
  .big { grid-row: span 2; }
  .chip {
    position: absolute; left: 14px; bottom: 14px; display: flex; align-items: center; gap: 8px; padding: 8px 12px;
    border-radius: 999px; background: rgba(255, 255, 255, .92); color: var(--ink); font-size: 13px; font-weight: 700;
  }
</style>
