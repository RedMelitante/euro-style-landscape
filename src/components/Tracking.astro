---
// Meta Pixel, GA4 and Google Ads. Each loads only when its ID env var is set
// (HANDOFF §6 — IDs still to come, never hard-coded).
// window.esTrack.lead() is called by the quote forms after the server accepts a
// lead; tel: clicks fire Contact / call conversions. Elements with
// data-track="quote_click" or "estimate_click" (campaign pages) fire a custom event.
// A page opened with ad params (UTMs, fbclid, gclid) is remembered for 30 days
// as `es_ad_landing`, so a form sent from another page still credits the ad.
import {
  PUBLIC_META_PIXEL_ID as pixelId,
  PUBLIC_GA4_ID as ga4Id,
  PUBLIC_GADS_ID as adsId,
  PUBLIC_GADS_LEAD_LABEL as adsLeadLabel,
  PUBLIC_GADS_CALL_LABEL as adsCallLabel,
} from 'astro:env/client';

const gtagId = ga4Id || adsId;
const cfg = {
  pixel: Boolean(pixelId),
  gtag: Boolean(gtagId),
  adsLead: adsId && adsLeadLabel ? `${adsId}/${adsLeadLabel}` : '',
  adsCall: adsId && adsCallLabel ? `${adsId}/${adsCallLabel}` : '',
};
---
{pixelId && (
  <script is:inline define:vars={{ pixelId }}>
    !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', pixelId);
    fbq('track', 'PageView');
  </script>
)}
{gtagId && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gtagId}`}></script>}
{gtagId && (
  <script is:inline define:vars={{ ga4Id, adsId }}>
    window.dataLayer = window.dataLayer || [];
    window.gtag = function () { window.dataLayer.push(arguments); };
    window.gtag('js', new Date());
    if (ga4Id) window.gtag('config', ga4Id);
    if (adsId) window.gtag('config', adsId);
  </script>
)}
<script is:inline define:vars={{ cfg }}>
  try {
    if (/[?&](utm_[a-z]+|fbclid|gclid)=/.test(location.search)) {
      localStorage.setItem('es_ad_landing', JSON.stringify({ url: location.href, t: Date.now() }));
    }
  } catch (e) { /* storage blocked: attribution falls back to the form page's own URL */ }
  window.esTrack = {
    lead: function (d) {
      if (cfg.pixel && window.fbq) window.fbq('track', 'Lead', Object.assign({ content_name: d.service }, d.extra), { eventID: d.eventId });
      if (cfg.gtag && window.gtag) {
        window.gtag('event', 'generate_lead', Object.assign({ service: d.service }, d.extra));
        if (cfg.adsLead) window.gtag('event', 'conversion', { send_to: cfg.adsLead, transaction_id: d.eventId });
      }
    },
    call: function () {
      if (cfg.pixel && window.fbq) window.fbq('track', 'Contact');
      if (cfg.gtag && window.gtag) {
        window.gtag('event', 'click_to_call');
        if (cfg.adsCall) window.gtag('event', 'conversion', { send_to: cfg.adsCall });
      }
    },
  };
  document.addEventListener('click', function (e) {
    var a = e.target && e.target.closest && e.target.closest('a[href^="tel:"]');
    if (a) window.esTrack.call();
    var t = e.target && e.target.closest && e.target.closest('[data-track="quote_click"],[data-track="estimate_click"]');
    if (t) {
      var loc = { location: t.dataset.trackLocation || '' };
      if (cfg.pixel && window.fbq) window.fbq('trackCustom', t.dataset.track === 'quote_click' ? 'QuoteClick' : 'EstimateClick', loc);
      if (cfg.gtag && window.gtag) window.gtag('event', t.dataset.track, loc);
    }
  });
</script>
