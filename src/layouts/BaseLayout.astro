---
// Website pages (handoff updates 6-7 design): offer top bar, white sticky header with Services and Areas
// dropdowns, footer with social icons, mobile sticky bar and the GoHighLevel chat widget.
// `minimal` (privacy policy, terms): logo + "Back to website" header and a one-line footer.
// The free design consultation ad page uses LandingLayout; the /lp/* ad pages use CampaignLayout.
import { Font, getImage, Image } from 'astro:assets';
import '../styles/tokens.css';
import '../styles/site.css';
import TopBar from '../components/site/TopBar.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import MobileBar from '../components/site/MobileBar.astro';
import Tracking from '../components/Tracking.astro';
import ChatWidget from '../components/ChatWidget.astro';
import logo from '../assets/logo/esl-logo-on-light.png';
import { photo } from '../lib/images';
import type { NavKey } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  /** Current nav item ('none' for pages outside the nav). */
  current?: NavKey;
  /** Service page key / town slug, highlighted in the header dropdowns. */
  currentService?: string;
  currentTown?: string;
  /** Header and sticky bar "Book a free consultation" target: '#quote' where the page has the quote section. */
  quoteHref?: string;
  noindex?: boolean;
  /** Privacy policy and terms: minimal header and footer. */
  minimal?: boolean;
  jsonLd?: Record<string, unknown>;
  /** Share image (a file in src/assets/images); defaults to the circular patio. */
  ogPhoto?: string;
}

const {
  title,
  description,
  current = 'none',
  currentService,
  currentTown,
  quoteHref = '#quote',
  noindex = false,
  minimal = false,
  jsonLd,
  ogPhoto = 'hero-firepit-patio.jpg',
} = Astro.props;

// build.format 'file' makes the pathname '/services.html'; the live URL is '/services'.
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/'), Astro.site);
const og = await getImage({ src: photo(ogPhoto), width: 1200, format: 'jpg' });
const ogImage = new URL(og.src, Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0F4A2F" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Euro Style Landscape" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(og.attributes.width ?? 1200)} />
    <meta property="og:image:height" content={String(og.attributes.height ?? 889)} />
    <meta name="twitter:card" content="summary_large_image" />
    <Font cssVariable="--font-barlow" preload={[{ weight: 400 }, { weight: 600 }]} />
    <Font cssVariable="--font-barlow-condensed" preload={[{ weight: 600, style: 'normal' }]} />
    <Font cssVariable="--font-hanken" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <Tracking />
  </head>
  <body>
    {minimal ? (
      <div style="min-height:100px;background:#FFFFFF;display:flex;flex-direction:column">
        <header style="background:#FFFFFF;box-shadow:0 1px 0 #E3E8DC">
          <div style="max-width:1280px;margin:0 auto;padding:0 16px;height:84px;display:flex;align-items:center;justify-content:space-between;gap:16px">
            <a href="/" aria-label="Euro Style Landscape home" style="display:flex;align-items:center;text-decoration:none"><Image src={logo} alt="Euro Style Landscape" width={72} height={72} densities={[1, 2]} loading="eager" style="display:block;width:72px;height:72px" /></a>
            <a href="/" style="display:flex;align-items:center;gap:8px;min-height:44px;color:#197148;text-decoration:none;font-weight:600;font-size:16px"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C9A46A" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"></path></svg>Back to website</a>
          </div>
        </header>
        <main style="flex:1"><slot /></main>
        <footer style="background:#B9BB4A;color:#2E343A">
          <div style="max-width:1280px;margin:0 auto;padding:20px 16px 28px;display:flex;flex-wrap:wrap;justify-content:space-between;gap:8px 24px;font-size:14px">
            <span>Copyright © 2026 Euro Style Landscape (SN Landscaping LLC). All rights reserved</span>
            <span style="display:flex;gap:20px"><a href="/privacy-policy" style="color:#2E343A;text-decoration:none">Privacy policy</a><a href="/terms" style="color:#2E343A;text-decoration:none">Terms</a><a href="/" style="color:#2E343A;text-decoration:none">eurostylelandscape.com</a></span>
          </div>
        </footer>
      </div>
    ) : (
      <div>
        <TopBar />
        <SiteHeader current={current} currentService={currentService} currentTown={currentTown} quoteHref={quoteHref} />
        <main><slot /></main>
        <SiteFooter />
        <MobileBar quoteHref={quoteHref} />
      </div>
    )}
    <ChatWidget />
  </body>
</html>
