# Local development only. Production values live in Cloudflare:
#   non-secret settings in wrangler.jsonc "vars", secrets via `npx wrangler secret put NAME`.
# For local `wrangler dev`, put the same names in a .dev.vars file (never commit it).

# --- Lead delivery -------------------------------------------------------
# GoHighLevel (primary). Private Integration token for the Eurostyle Landscape sub-account.
GHL_TOKEN=
GHL_LOCATION_ID=kUo666oVrHpsxOixnJSy
GHL_PIPELINE_NAME=Marketing Pipeline
# Google Apps Script backup, used only if GoHighLevel fails (docs/google-apps-script-lead-backup.gs).
LEAD_BACKUP_URL=
LEAD_BACKUP_SECRET=

# --- Tracking (leave empty until the client/agency supplies IDs) ----------
PUBLIC_META_PIXEL_ID=
# Meta Conversions API access token (server only).
META_CAPI_TOKEN=
META_API_VERSION=v21.0
# GA4 measurement ID, e.g. G-XXXXXXX
PUBLIC_GA4_ID=
# Google Ads conversion ID (AW-XXXXXXXXX) and conversion labels
PUBLIC_GADS_ID=
PUBLIC_GADS_LEAD_LABEL=
PUBLIC_GADS_CALL_LABEL=
